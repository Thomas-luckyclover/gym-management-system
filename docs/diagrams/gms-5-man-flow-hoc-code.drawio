        </mxCell>
        <mxCell id="gms-learn-sessions-9-body-0" value="Mỗi thẻ là &amp;lt;details&amp;gt; có &amp;lt;summary&amp;gt; và nội dung&lt;br&gt;data-session-content ẩn.&lt;br&gt;_session-detail.jspf xuất thông tin buổi, PT, gói, cảnh&lt;br&gt;báo và lý do." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-9-card-0">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-9-card-1" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=0;arcSize=6;" vertex="1" parent="1">
