        </mxCell>
        <mxCell id="gms-learn-home-body-1" value="Gọi homeService.getHomePage().&lt;br&gt;Nếu thành công: đặt request.home.&lt;br&gt;Nếu thất bại: trả HTTP 500, không dựng dữ liệu giả." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-home-card-1">
