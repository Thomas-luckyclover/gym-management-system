        </mxCell>
        <mxCell id="gms-learn-bookings-4-heading-1" value="Vắng / hủy: xem trên lịch" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-1">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-1" value="Đã bỏ toàn bộ khối “N buổi vắng / hủy · xem lý do”,&lt;br&gt;pastProblems và buildPastProblems().&lt;br&gt;Giữ số đếm, chú thích trạng thái và link từng ô chấm&lt;br&gt;→ Lịch tập để xem lý do." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-1">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-card-2" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="230" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-role-2" value="3. ĐIỀU KIỆN" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-2">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-heading-2" value="chooseCta(): ưu tiên 1–2" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-2">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-2" value="Có watchList → mua Membership.&lt;br&gt;Đang xem buổi lẻ: ≥3 buổi gần đây trong 30 ngày →&lt;br&gt;gợi ý gói PT; chưa đủ → không có CTA đó.&lt;br&gt;Buổi cancelled không vào số buổi lẻ gần đây." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-2">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-card-3" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-role-3" value="4. ĐIỀU KIỆN" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-3">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-heading-3" value="chooseCta(): ưu tiên 3–4" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-3">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-3" value="Gói đã kết thúc → đăng ký lại.&lt;br&gt;Gói còn ≤3 buổi hoặc ≤14 ngày → gia hạn tại quầy.&lt;br&gt;Các gợi ý tại quầy mới cần hotline và giờ mở cửa&lt;br&gt;P-19." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-3">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-card-4" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-role-4" value="5. JSP / TRÌNH DUYỆT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-4">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-heading-4" value="Click đúng buổi → Lịch tập" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-4">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-4" value="Chấm / link buổi mở:&lt;br&gt;/customer/pt-sessions?view=week&lt;br&gt;&amp;amp;from=&amp;lt;gói|single&amp;gt;&amp;amp;date=&amp;lt;ngày&amp;gt;&lt;br&gt;&amp;amp;session=&amp;lt;SessionId&amp;gt;&lt;br&gt;Màn đích chọn ngày, highlight và mở chi tiết." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-4">
          <mxGeometry x="8.0" y="78.0" width="504" height="151" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-card-5" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-role-5" value="6. JSP / TRÌNH DUYỆT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-5">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-heading-5" value="Giao diện gọn và trạng thái rỗng" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-5">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-5" value="Đầu gói không còn Sau đó / số điện thoại / Buổi&lt;br&gt;20/45 / Google Calendar / Xem chi tiết trùng.&lt;br&gt;Không có buổi tới: hiện một câu; gói kết thúc ẩn&lt;br&gt;Zalo.&lt;br&gt;Thẻ trái: tên gói + PT Sơn · còn N buổi." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-5">
