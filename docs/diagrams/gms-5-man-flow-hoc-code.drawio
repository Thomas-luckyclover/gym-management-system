        <mxCell id="gms-learn-sessions-2-read" value="Đọc theo số và mũi tên: hàng trên từ trái sang phải, hàng dưới từ phải sang trái. Mỗi ô giải thích một bước học." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1">
