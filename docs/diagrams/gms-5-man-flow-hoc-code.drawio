          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-2-body-4" value="dayIndex = dayOfWeek − 1.&lt;br&gt;bandOf(StartTime): &amp;lt;12h → Sáng; &amp;lt;18h → Chiều;&lt;br&gt;còn lại → Tối.&lt;br&gt;Thêm row vào bands[band].cells[day]." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-2-card-4">
