        </mxCell>
        <mxCell id="gms-learn-sessions-4-heading-5" value="Ví dụ Buổi 20/45" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-4-card-5">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-4-body-5" value="Buổi thứ 20 của gói nằm trong tuần đang xem: vẫn&lt;br&gt;hiện 20/45.&lt;br&gt;20 là số thứ tự toàn gói; 45 là tổng đã sinh.&lt;br&gt;Không có nghĩa khách đã check-in 20 buổi." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-4-card-5">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
