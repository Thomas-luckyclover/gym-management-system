        <mxCell id="gms-learn-sessions-4-body-0" value="Orders đã Paid; loại PTSingle / PTCouple /&lt;br&gt;SingleSession.&lt;br&gt;Khách là chủ gói, hoặc là partner của gói PT đôi.&lt;br&gt;customerId được bind bằng PreparedStatement." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-4-card-0">
