        </mxCell>
        <mxCell id="gms-learn-sessions-4-body-2" value="PT lấy từ Sessions.PtEmployeeId → Employees →&lt;br&gt;Persons.&lt;br&gt;Có tên / điện thoại PT, tên chủ gói / partner,&lt;br&gt;SnapshotPackageName và GeneratedSessionCount." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-4-card-2">
