        </mxCell>
        <mxCell id="gms-learn-dash-3-body-2" value="Scheduled + đúng Sessions.PtEmployeeId +&lt;br&gt;SlotDate trong khoảng.&lt;br&gt;EXISTS OperatingHourExceptions cùng ngày,&lt;br&gt;IsClosedAllDay=1.&lt;br&gt;Trả ClosedDaySession có SessionId và dữ liệu chủ&lt;br&gt;gói." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-dash-3-card-2">
