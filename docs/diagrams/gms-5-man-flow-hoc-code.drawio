        <mxCell id="gms-learn-sessions-7-read" value="Đi theo nhãn trên mũi tên để chọn nhánh; kết quả if/else nằm ngay trong ô. Không thực hiện lần lượt mọi nhánh." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="1720" height="45" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-note" value="GHI NHỚ&lt;br&gt;Ví dụ bạn có Membership nhưng partner hết hạn: vẫn thấy cảnh báo về partner; không nên suy ra bạn cũng bị cấm vào phòng." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1">
