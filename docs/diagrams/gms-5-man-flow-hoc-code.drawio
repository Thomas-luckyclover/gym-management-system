        <mxCell id="gms-learn-bookings-3-heading-0" value="Đếm giờ theo ngày trong tuần" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-3-card-0">
