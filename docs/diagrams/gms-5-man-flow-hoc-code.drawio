        <mxCell id="gms-learn-home-body-4" value="Gom gymPackages, ptPackages, pts, openingHours,&lt;br&gt;latestPosts.&lt;br&gt;Mỗi thẻ gói dùng PackageCardView.&lt;br&gt;Blog lỗi: bỏ phần bài viết, vẫn có thể trả trang chủ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-home-card-4">
