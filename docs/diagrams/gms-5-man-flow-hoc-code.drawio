        </mxCell>
        <mxCell id="gms-learn-home-body-2" value="Đọc các gói đang bán; tách gói gym và gói PT.&lt;br&gt;Gọi buildGymCards() để tính giá theo tháng, mức&lt;br&gt;tiết kiệm và nhãn gói gym." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-home-card-2">
