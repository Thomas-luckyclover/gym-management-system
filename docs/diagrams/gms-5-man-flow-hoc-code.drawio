        <mxCell id="gms-learn-dash-2-heading-5" value="mergeClientAttention()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-dash-2-card-5">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-dash-2-body-5" value="For từng gói: xóa list cũ, gắn các cảnh báo cùng&lt;br&gt;SubscriptionId; không ghép theo tên.&lt;br&gt;Gói đôi giữ cảnh báo từng người.&lt;br&gt;Sắp thẻ có ngày nghỉ trước, rồi cảnh báo khác, cuối&lt;br&gt;cùng khách bình thường." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-dash-2-card-5">
