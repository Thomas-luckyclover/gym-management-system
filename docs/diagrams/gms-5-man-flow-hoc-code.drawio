        <mxCell id="gms-learn-sessions-2-body-3" value="TimetableView có 7 Day: ngày, tên thứ, có phải hôm&lt;br&gt;nay.&lt;br&gt;Mỗi Band có 7 list cells.&lt;br&gt;Ngày chưa có buổi vẫn có cột, không làm lệch vị trí&lt;br&gt;các buổi khác." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-2-card-3">
