        <mxCell id="gms-learn-sessions-4-read" value="Đọc theo số và mũi tên: hàng trên từ trái sang phải, hàng dưới từ phải sang trái. Mỗi ô giải thích một bước học." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="1720" height="45" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-4-note" value="GHI NHỚ&lt;br&gt;Nếu chuyển bộ lọc ngày vào trước ROW_NUMBER thì thứ tự dễ thành 1/45 ở mỗi tuần. CTE hiện tại tránh lỗi đó." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1150" width="1720" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-4-source" value="Đối chiếu: MyPtSessionDAO.SESSIONS_SQL/querySessions()/readSessionRow(); MyPtSessionRow.java | Code hiện tại: 23/10/2026 (gồm thay đổi chưa commit)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1">
