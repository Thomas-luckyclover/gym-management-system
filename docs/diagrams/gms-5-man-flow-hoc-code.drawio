        <mxCell id="gms-learn-bookings-3-heading-4" value="MyBookingDAO.findMoves()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-3-card-4">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-3-body-4" value="Đọc SessionMoveLogs và giờ cũ theo&lt;br&gt;SubscriptionId.&lt;br&gt;Service giữ giờ gốc đầu tiên và loại thay đổi mới&lt;br&gt;nhất, tạo moveNote: khách đổi / PT dời / chuyển PT." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-3-card-4">
