        <mxCell id="gms-learn-sessions-3-body-4" value="today / upcoming / warn → upcomingCount.&lt;br&gt;checkedIn / missed / cancelled → bộ đếm tương&lt;br&gt;ứng.&lt;br&gt;Còn lại → pendingCount.&lt;br&gt;Số đếm dùng trạng thái hiển thị đã tính." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-3-card-4">
