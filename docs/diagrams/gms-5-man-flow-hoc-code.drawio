        <mxCell id="gms-learn-bookings-2-heading-4" value="MyBookingView chứa gì?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-2-card-4">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-2-body-4" value="activePackages / endedPackages / selectedPackage&lt;br&gt;sessions: List&amp;lt;MyPtSessionRow&amp;gt;&lt;br&gt;focusSession / focusSessionId / daysUntilFocus&lt;br&gt;watchList / bộ đếm / lịch mẫu / CTA. Không còn list&lt;br&gt;lịch sử vắng/hủy riêng." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-2-card-4">
