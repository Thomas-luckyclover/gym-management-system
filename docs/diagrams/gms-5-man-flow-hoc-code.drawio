        <mxCell id="gms-learn-sessions-2-note" value="GHI NHỚ&lt;br&gt;DTO tuần là cấu trúc 3 × 7 chứa các list buổi; không phải DAO trả sẵn HTML hay trả một dòng cho mỗi ô trống." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1">
