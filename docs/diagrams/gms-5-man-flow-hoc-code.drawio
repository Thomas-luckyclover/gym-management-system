        </mxCell>
        <mxCell id="gms-learn-dash-1-heading-0" value="PtDashboardServlet.doGet()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-dash-1-card-0">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-dash-1-body-0" value="Lấy ACCOUNT_ID từ session.&lt;br&gt;Gọi getPtEmployeeCode(), getSchedule(),&lt;br&gt;getAttentionItems(), getAssignedPackages(),&lt;br&gt;getCommissionSummary().&lt;br&gt;Tạo CSRF token cho form nhắc khách." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-dash-1-card-0">
          <mxGeometry x="8.0" y="78.0" width="504" height="151" as="geometry" />
        </mxCell>
