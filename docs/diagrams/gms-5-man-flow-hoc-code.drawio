        <mxCell id="gms-learn-sessions-6-legend-dao" value="DAO / SQL" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#172b4d;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;arcSize=6;" vertex="1" parent="1">
