        <mxCell id="gms-learn-sessions-3-note" value="GHI NHỚ&lt;br&gt;Ví dụ tháng 10/2026: lưới 28/09–01/11, nhưng SQL chỉ đọc 01/10–31/10. Ô ngoài tháng không mang buổi của tháng bên cạnh." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1">
