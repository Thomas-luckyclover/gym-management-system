        <mxCell id="gms-learn-sessions-2-heading-3" value="Khởi tạo bảng rỗng" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-2-card-3">
