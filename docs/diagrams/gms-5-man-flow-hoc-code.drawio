        </mxCell>
        <mxCell id="gms-learn-sessions-4-body-1" value="PARTITION BY SubscriptionId.&lt;br&gt;ORDER BY SlotDate, StartTime, SessionId.&lt;br&gt;Sau đó mới lọc khoảng ngày ở query ngoài: số thứ&lt;br&gt;tự không bị đếm lại từ 1 mỗi tuần." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-4-card-1">
