        </mxCell>
        <mxCell id="gms-learn-sessions-3-body-5" value="Các ô ngoài tháng là ô bổ sung bố cục.&lt;br&gt;Ô trong tháng hiện ngày, số đếm và buổi.&lt;br&gt;Click ngày / buổi chuyển sang tuần có ngày đó; đây&lt;br&gt;là một GET mới." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-3-card-5">
