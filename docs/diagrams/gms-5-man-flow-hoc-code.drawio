        <mxCell id="gms-learn-sessions-7-role-0" value="1. DAO / SQL" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-0">
