        <mxCell id="gms-learn-home-note" value="GHI NHỚ&lt;br&gt;Nhớ một câu: HomeService gom nhiều nguồn thành một HomePageView; HomeServlet chuyển DTO cho JSP." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1">
