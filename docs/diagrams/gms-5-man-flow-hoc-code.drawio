        <mxCell id="gms-learn-sessions-4-heading-4" value="querySessions() → readSessionRow()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-4-card-4">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-4-body-4" value="Bind customerId cho hai nhánh quyền xem rồi bind&lt;br&gt;điều kiện bổ sung.&lt;br&gt;Duyệt ResultSet: mỗi dòng thành MyPtSessionRow;&lt;br&gt;trả list dữ liệu, không trả chuỗi HTML." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-4-card-4">
