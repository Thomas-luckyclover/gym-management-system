          <mxGeometry x="1082" y="164" width="180" height="43" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-10-card-0" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="520" height="350" as="geometry" />
