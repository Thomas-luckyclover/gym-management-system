        <mxCell id="gms-learn-sessions-8-body-5" value="?view=week&amp;amp;from=82&lt;br&gt;&amp;amp;date=2026-10-23&amp;amp;session=274&lt;br&gt;→ dựng tuần chứa 23/10&lt;br&gt;→ chọn cột Thứ 6, mở buổi 274&lt;br&gt;→ quay lại /customer/bookings?id=82." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-8-card-5">
