        </mxCell>
        <mxCell id="gms-learn-sessions-5-body-0" value="List rỗng → return ngay.&lt;br&gt;Có dữ liệu → đọc tập ngày phòng nghỉ một lần bằng&lt;br&gt;findClosedDays() trong khoảng ngày của list." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-5-card-0">
          <mxGeometry x="8.0" y="78.0" width="504" height="97" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-5-card-1" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0;arcSize=6;" vertex="1" parent="1">
