          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-4-body-3" value="findSessionsInRange(): theo ngày.&lt;br&gt;findSessionsOfPackage(): theo gói.&lt;br&gt;findSingleSessions(): buổi lẻ.&lt;br&gt;Cả ba vẫn giữ giới hạn khách trong CTE." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-4-card-3">
