        <mxCell id="gms-learn-sessions-7-heading-0" value="hasGymPass() + isFrozen()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-0">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-body-0" value="Đọc Membership hoặc DayPass có khoảng ngày phù&lt;br&gt;hợp; đọc bảo lưu riêng.&lt;br&gt;Quyền thực tế = có vé hợp lệ và không bị bảo lưu tại&lt;br&gt;ngày buổi.&lt;br&gt;Membership và gói PT là hai loại quyền khác nhau." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-0">
          <mxGeometry x="8.0" y="78.0" width="504" height="151" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-card-1" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="230" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-role-1" value="2. ĐIỀU KIỆN" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-1">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-heading-1" value="PT cá nhân / buổi lẻ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-1">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-body-1" value="Chủ buổi có quyền → không cảnh báo.&lt;br&gt;Bị bảo lưu → cảnh báo bảo lưu.&lt;br&gt;Không có quyền, không bảo lưu → thiếu vé;&lt;br&gt;noGymPass=true để màn gói có thể gợi ý mua." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-1">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-card-2" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="230" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-role-2" value="3. SERVICE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-2">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-heading-2" value="PT đôi: đổi góc nhìn" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-2">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-body-2" value="Tính quyền của chủ gói và partner.&lt;br&gt;Sau đó xác định “bạn” và “người cùng tập” theo&lt;br&gt;myCustomerId.&lt;br&gt;Cùng buổi nhưng hai người có thể đọc thông điệp&lt;br&gt;khác nhau." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-2">
          <mxGeometry x="8.0" y="78.0" width="504" height="151" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-card-3" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-role-3" value="4. ĐIỀU KIỆN" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-3">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-heading-3" value="Cả hai / một người có quyền" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-3">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-body-3" value="Cả hai hợp lệ → không cảnh báo.&lt;br&gt;Chỉ bạn hợp lệ → người kia không vào được, bạn&lt;br&gt;vẫn tập.&lt;br&gt;Chỉ người kia hợp lệ → bạn không vào được, người&lt;br&gt;kia vẫn tập." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-3">
          <mxGeometry x="8.0" y="78.0" width="504" height="151" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-card-4" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-role-4" value="5. ĐIỀU KIỆN" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-4">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-heading-4" value="Cả hai không có quyền" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-4">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-body-4" value="Có người bị bảo lưu → thông điệp bảo lưu.&lt;br&gt;Không ai bảo lưu → thông điệp thiếu quyền cả hai.&lt;br&gt;noGymPass được tính riêng; không phải mọi cảnh&lt;br&gt;báo đều dẫn tới CTA mua vé." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-4">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-card-5" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-role-5" value="6. JSP / TRÌNH DUYỆT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-5">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-heading-5" value="Cảnh báo không tự hủy buổi" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-5">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-sessions-7-body-5" value="JSP hiện Cần chú ý và explanation.&lt;br&gt;Buổi Scheduled vẫn còn trên lịch.&lt;br&gt;Với gói đôi, một cảnh báo không có nghĩa cả hai đều&lt;br&gt;không được tập.&lt;br&gt;Ngày nghỉ được ưu tiên ở fillDisplay trước bước này." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-7-card-5">
          <mxGeometry x="8.0" y="78.0" width="504" height="151" as="geometry" />
        </mxCell>
