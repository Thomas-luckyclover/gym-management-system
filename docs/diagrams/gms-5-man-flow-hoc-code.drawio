        <mxCell id="gms-learn-sessions-2-body-5" value="Duyệt Band → Cell → MyPtSessionRow.&lt;br&gt;Mỗi row dùng _session-card.jspf.&lt;br&gt;Ví dụ Thứ 6 15:00 đi vào cột Thứ 6, dải Chiều;&lt;br&gt;không phụ thuộc thứ tự JSP tự đoán." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-2-card-5">
