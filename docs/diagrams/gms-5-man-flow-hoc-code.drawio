        <mxCell id="gms-learn-dash-2-body-2" value="PtScheduleDayView → tab ngày → PtSessionView.&lt;br&gt;Các trạng thái Scheduled / CheckedIn / Missed /&lt;br&gt;Cancelled có nhãn riêng.&lt;br&gt;Mở Xử lý buổi chỉ mở hộp thoại với đúng SessionId." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-dash-2-card-2">
