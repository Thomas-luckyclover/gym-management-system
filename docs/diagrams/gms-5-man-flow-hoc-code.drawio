        </mxCell>
        <mxCell id="gms-learn-dash-3-body-1" value="Có Membership và không frozen → bỏ qua.&lt;br&gt;Thiếu / frozen → giữ cảnh báo; gom theo khách +&lt;br&gt;gói + frozen, lấy ngày gần nhất.&lt;br&gt;kind cũ là membership hoặc frozen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-dash-3-card-1">
