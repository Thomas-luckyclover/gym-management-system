        <mxCell id="gms-learn-dash-2-heading-3" value="findAssignedPackages()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-dash-2-card-3">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-dash-2-body-3" value="Đọc gói Paid được giao và buổi lẻ sắp dạy; đọc thêm&lt;br&gt;các SubscriptionId đang có cảnh báo để không bỏ&lt;br&gt;sót buổi PT dạy thay.&lt;br&gt;SĐT lấy từ Persons.Phone; ID trong IN được bind&lt;br&gt;bằng PreparedStatement." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-dash-2-card-3">
          <mxGeometry x="8.0" y="78.0" width="504" height="151" as="geometry" />
        </mxCell>
