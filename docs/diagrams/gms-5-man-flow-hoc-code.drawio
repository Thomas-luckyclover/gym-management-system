        <mxCell id="gms-learn-dash-4-subtitle" value="POST /pt/dashboard là nhắc khách về quyền vào gym. Không dùng luồng này để dời buổi hoặc nhắc thẻ closedDay." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1">
