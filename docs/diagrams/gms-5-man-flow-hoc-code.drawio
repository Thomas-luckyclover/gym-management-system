        <mxCell id="gms-learn-sessions-1-body-1" value="Lấy ACCOUNT_ID từ session; thiếu thì chuyển đăng&lt;br&gt;nhập.&lt;br&gt;Tải header riêng.&lt;br&gt;loadTimetable() đọc thời gian now một lần để thống&lt;br&gt;nhất việc tính trạng thái." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-sessions-1-card-1">
