        <mxCell id="step_17" value="18. Hiển thị màn hình Kết quả mua gói thành công" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
