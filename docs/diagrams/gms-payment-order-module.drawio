        <mxCell id="step_0" value="1. Chọn gói &amp; Bấm Thanh toán VNPay" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
          <mxGeometry width="80" relative="1" as="geometry">
