            <mxPoint x="388" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_1" value="2. POST /customer/checkout {packageId, voucher}" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
          <mxGeometry width="80" relative="1" as="geometry">
