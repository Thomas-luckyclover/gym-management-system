            <mxPoint x="854" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_3" value="4. INSERT Orders (PENDING), INSERT Transactions" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
