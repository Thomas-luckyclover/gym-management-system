        <mxCell id="step_8" value="9. Thanh toán thành công tại ngân hàng" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
