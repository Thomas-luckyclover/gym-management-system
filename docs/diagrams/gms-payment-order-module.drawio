        <mxCell id="step_16" value="17. Redirect khách về /payment/vnpay-return" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;dashed=1;" edge="1" parent="1">
