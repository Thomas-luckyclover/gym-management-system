        <mxCell id="step_12" value="13. [Hợp lệ] UPDATE Orders=PAID, Transactions=SUCCESS" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
