        <mxCell id="step_13" value="14. [Hợp lệ] INSERT Subscriptions (Active, StartDate)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
