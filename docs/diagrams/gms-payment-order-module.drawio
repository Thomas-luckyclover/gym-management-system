            <mxPoint x="2019" y="315" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_4" value="5. buildPaymentUrl(HMAC-SHA512)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
