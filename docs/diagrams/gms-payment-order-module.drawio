            <mxPoint x="2019" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step_15" value="16. Phản hồi IPN {&quot;RspCode&quot;:&quot;00&quot;,&quot;Message&quot;:&quot;Confirm Success&quot;}" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;fontSize=11;strokeColor=#2980b9;dashed=1;" edge="1" parent="1">
