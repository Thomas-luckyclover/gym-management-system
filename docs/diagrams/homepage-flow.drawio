        <mxCell id="gms-learn-home-body-5" value="Servlet forward tới JSP; JSP đọc ${home...} và xuất&lt;br&gt;dữ liệu.&lt;br&gt;Gói, PT và blog là dữ liệu trả về; JSP không tự chạy&lt;br&gt;SQL." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-home-card-5">
