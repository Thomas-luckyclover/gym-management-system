        <mxCell id="gms-learn-home-body-3" value="PackageDAO.findActiveForHomepage()&lt;br&gt;EmployeeDAO.findWorkingPts()&lt;br&gt;SystemConfigService: giờ mở cửa P-19.&lt;br&gt;BlogService.getLatestPosts(3)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-home-card-3">
