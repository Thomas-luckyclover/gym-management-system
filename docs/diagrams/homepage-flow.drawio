        <mxCell id="gms-learn-home-body-0" value="Người dùng truy cập đường dẫn gốc của ứng dụng.&lt;br&gt;Không cần đăng nhập để xem gói tập, PT, giờ mở&lt;br&gt;cửa và bài viết mới." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-home-card-0">
