          <mxGeometry x="40" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-role-5" value="6. JSP / TRÌNH DUYỆT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-5">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-heading-5" value="Giao diện gọn và trạng thái rỗng" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-5">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-5" value="Đầu gói không còn Sau đó / số điện thoại / Buổi&lt;br&gt;20/45 / Google Calendar / Xem chi tiết trùng.&lt;br&gt;Không có buổi tới: hiện một câu; gói kết thúc ẩn&lt;br&gt;Zalo.&lt;br&gt;Thẻ trái: tên gói + PT Sơn · còn N buổi." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-5">
