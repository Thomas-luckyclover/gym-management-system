        </mxCell>
        <mxCell id="gms-learn-bookings-4-heading-1" value="Vắng / hủy: xem trên lịch" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-1">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-1" value="Đã bỏ toàn bộ khối “N buổi vắng / hủy · xem lý do”,&lt;br&gt;pastProblems và buildPastProblems().&lt;br&gt;Giữ số đếm, chú thích trạng thái và link từng ô chấm&lt;br&gt;→ Lịch tập để xem lý do." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-1">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-card-2" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="230" width="520" height="350" as="geometry" />
