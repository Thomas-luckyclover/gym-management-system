          <mxGeometry x="640" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-role-4" value="5. JSP / TRÌNH DUYỆT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-4">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-heading-4" value="Click đúng buổi → Lịch tập" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-4">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-4" value="Chấm / link buổi mở:&lt;br&gt;/customer/pt-sessions?view=week&lt;br&gt;&amp;amp;from=&amp;lt;gói|single&amp;gt;&amp;amp;date=&amp;lt;ngày&amp;gt;&lt;br&gt;&amp;amp;session=&amp;lt;SessionId&amp;gt;&lt;br&gt;Màn đích chọn ngày, highlight và mở chi tiết." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-4">
          <mxGeometry x="8.0" y="78.0" width="504" height="151" as="geometry" />
