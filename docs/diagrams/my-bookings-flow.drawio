        <mxCell id="gms-learn-bookings-4-heading-0" value="Cần để ý: buildWatchList()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-0">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-0" value="Chỉ nhận row.statusKey=warn và noGymPass=true.&lt;br&gt;Cảnh báo ngày phòng nghỉ hoặc bảo lưu không tự&lt;br&gt;động vào danh sách thiếu vé này.&lt;br&gt;Danh sách nằm trong &amp;lt;details&amp;gt; thu gọn." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-0">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
