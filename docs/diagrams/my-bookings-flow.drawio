          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-2-body-1" value="MyPtSessionService.fillDisplay() thêm tên loại gói,&lt;br&gt;PT liên hệ, cảnh báo, statusKey, nhãn và giải thích.&lt;br&gt;MyBookings và Lịch tập dùng chung bước này." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-2-card-1">
