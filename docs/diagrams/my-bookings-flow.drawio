        <mxCell id="gms-learn-bookings-1-role-0" value="1. SERVLET" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-0">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-heading-0" value="MyBookingServlet.doGet()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-0">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-body-0" value="Lấy ACCOUNT_ID từ session.&lt;br&gt;Chưa đăng nhập: chuyển /login.&lt;br&gt;Đã đăng nhập: tải header và gọi&lt;br&gt;getMyBookings(accountId, id, now)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-0">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-card-1" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="230" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-role-1" value="2. SERVICE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-1">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-heading-1" value="Đúng khách đang đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-1">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-body-1" value="MyBookingService gọi findCustomerId().&lt;br&gt;Kiểm tra account Active, customer tồn tại và chưa bị&lt;br&gt;xóa.&lt;br&gt;accountId và customerId là hai ID khác nhau." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-1">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-card-2" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="230" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-role-2" value="3. DAO / SQL" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-2">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-heading-2" value="Danh sách được phép xem" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-2">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-body-2" value="MyPtSessionDAO.findMyPackages(): gói PT đã&lt;br&gt;thanh toán mà khách đứng tên hoặc cùng gói PT&lt;br&gt;đôi.&lt;br&gt;findSingleSessions(): các buổi lẻ của khách." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-2">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-card-3" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-role-3" value="4. SERVICE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-3">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-heading-3" value="Chia nhóm và pickPackage()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-3">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-body-3" value="Duyệt gói: isActive() → Đang tập; còn lại → Đã kết&lt;br&gt;thúc.&lt;br&gt;id=single và có buổi lẻ → xem buổi lẻ.&lt;br&gt;id gói hợp lệ → chọn đúng gói trong danh sách của&lt;br&gt;khách." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-3">
          <mxGeometry x="8.0" y="78.0" width="504" height="151" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-card-4" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-role-4" value="5. ĐIỀU KIỆN" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-4">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-heading-4" value="Nếu id sai / không có gói" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-4">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-body-4" value="Không tìm thấy id: ưu tiên gói active đầu tiên, rồi gói&lt;br&gt;ended đầu tiên.&lt;br&gt;Không còn gói nhưng có buổi lẻ: chọn buổi lẻ.&lt;br&gt;Không có cả hai: trả DTO rỗng hợp lệ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-4">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-card-5" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-role-5" value="6. JSP / TRÌNH DUYỆT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-5">
          <mxGeometry x="8.0" y="8.0" width="504" height="38" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-heading-5" value="DTO → JSP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-5">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-1-body-5" value="Có gói được chọn: đọc findSessionsOfPackage().&lt;br&gt;Servlet đặt booking hoặc bookingError; forward&lt;br&gt;customer/my-bookings.jsp.&lt;br&gt;Chọn gói khác là GET mới, không lọc SQL ở JSP." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-1-card-5">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
