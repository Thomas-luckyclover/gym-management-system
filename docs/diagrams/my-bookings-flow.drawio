        </mxCell>
        <mxCell id="gms-learn-bookings-4-heading-3" value="chooseCta(): ưu tiên 3–4" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-3">
          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-bookings-4-body-3" value="Gói đã kết thúc → đăng ký lại.&lt;br&gt;Gói còn ≤3 buổi hoặc ≤14 ngày → gia hạn tại quầy.&lt;br&gt;Các gợi ý tại quầy mới cần hotline và giờ mở cửa&lt;br&gt;P-19." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-learn-bookings-4-card-3">
          <mxGeometry x="8.0" y="78.0" width="504" height="124" as="geometry" />
        </mxCell>
