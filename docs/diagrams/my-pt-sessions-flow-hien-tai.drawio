          <mxGeometry x="8.0" y="45.0" width="504" height="41" as="geometry" />
        </mxCell>
        <mxCell id="gms-current-9-body-5" value="Không có khách tự hủy / tự đổi buổi.&lt;br&gt;Không có nút tự xác nhận CheckedIn.&lt;br&gt;Chốt vắng / hủy tự động là nghiệp vụ JOB; màn này&lt;br&gt;đọc kết quả và cho khách liên hệ PT." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-9-card-5">
