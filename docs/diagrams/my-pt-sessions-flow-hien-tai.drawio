        <mxCell id="lbg5" value="" style="rounded=0;fillColor=#f5f5f5;fillOpacity=18;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1870" y="135" width="360" height="1235" />
        </mxCell>
        <mxCell id="lh5" value="&lt;b&gt;DB · dữ liệu gốc&lt;/b&gt;" style="rounded=1;html=1;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="140" width="340" height="33" />
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;1 · JSP chuẩn bị nội dung từng buổi&lt;/b&gt;&lt;br&gt;details[data-session-detail] chứa summary&lt;br&gt;và [data-session-content] đã escape.&lt;br&gt;_session-detail.jspf chuẩn bị nội dung của buổi.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;_session-card.jspf / _session-detail.jspf&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="180" width="340" height="110" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2 · initSessionDetails()&lt;/b&gt;&lt;br&gt;Nếu hỗ trợ dialog.showModal → gắn listener.&lt;br&gt;Nếu không hỗ trợ → details/summary vẫn đọc được.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.js&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;3 · openSessionDetail(event)&lt;/b&gt;&lt;br&gt;preventDefault(); cloneNode(true) đúng nội dung.&lt;br&gt;destination.replaceChildren(...); xóa thông báo copy.&lt;br&gt;Lưu summary để trả focus khi đóng.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.js&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;4 · showModal()&lt;/b&gt;&lt;br&gt;aria-expanded=true; mở dialog.&lt;br&gt;Cuộn phần nội dung về đầu; thêm session-detail-open&lt;br&gt;để khóa cuộn trang nền. Không có fetch().&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.js&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;5 · Ba cách đóng&lt;/b&gt;&lt;br&gt;Nút type=button gọi drawer.close().&lt;br&gt;Bấm ngoài khung dialog → kiểm tra bounds → close().&lt;br&gt;Escape do dialog xử lý mặc định.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;_session-drawer.jspf / my-pt-sessions.js&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;6 · Sự kiện close&lt;/b&gt;&lt;br&gt;Gỡ class khóa cuộn; aria-expanded=false.&lt;br&gt;Trả focus về summary đã mở, preventScroll=true.&lt;br&gt;Nút Đóng không submit form nên không bị loading.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.js&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="830" width="340" height="110" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;Liên hệ · zaloUrl(phone)&lt;/b&gt;&lt;br&gt;Giữ chữ số; đầu 84 có 11 số → đổi về 0.&lt;br&gt;Ghép https://zalo.me/&amp;lt;số&amp;gt;.&lt;br&gt;JSP mở link; không tự gửi tin nhắn.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;Sao chép · copyPtPhone(button)&lt;/b&gt;&lt;br&gt;navigator.clipboard.writeText(phone).&lt;br&gt;Thành công → thông báo. Bị chặn → tạo input readonly,&lt;br&gt;focus + select để người dùng tự Ctrl+C.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.js&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="960" width="340" height="110" />
        </mxCell>
        <mxCell id="j" value="&lt;b&gt;Lịch Google · calendarUrl(row)&lt;/b&gt;&lt;br&gt;Scheduled và chưa hết giờ mới có link.&lt;br&gt;Giờ VN → UTC; URLEncoder cho chữ tiếng Việt.&lt;br&gt;Mở form Google; người dùng tự bấm Lưu.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="k" value="&lt;b&gt;Điểm ra khỏi màn Lịch tập&lt;/b&gt;&lt;br&gt;“Xem toàn bộ gói” → /customer/bookings?id=...&lt;br&gt;“Đặt buổi lẻ” → /customer/book-session.&lt;br&gt;Chỉ là điều hướng; không đi sâu hai màn này.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;_session-detail.jspf / _schedule-header.jspf&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1220" width="340" height="110" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a" target="b">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b" target="c">
          <mxGeometry as="geometry" relative="1" />
