        </mxCell>
        <mxCell id="j" value="&lt;b&gt;9 · Bấm ngày / thẻ buổi tháng&lt;/b&gt;&lt;br&gt;GET ?view=week&amp;amp;date=2026-11-06&lt;br&gt;Mở tuần chứa ngày đó; selectedDate vẫn là 6/11.&lt;br&gt;Không mở drawer ngay trong lịch tháng.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.jsp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
