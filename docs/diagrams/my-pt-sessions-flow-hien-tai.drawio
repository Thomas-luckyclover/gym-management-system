        <mxCell id="gms-current-6-body-3" value="Chưa hết, không warning:&lt;br&gt;Ngày hôm nay → today; đã bắt đầu: “Đang diễn ra”,&lt;br&gt;chưa bắt đầu: “Hôm nay”.&lt;br&gt;Ngày sau → upcoming, “Sắp tới”." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-6-card-3">
