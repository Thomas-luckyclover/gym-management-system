        <mxCell id="lh5" value="&lt;b&gt;DB · dữ liệu gốc&lt;/b&gt;" style="rounded=1;html=1;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="140" width="340" height="33" />
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;1 · Người dùng mở Lịch tập&lt;/b&gt;&lt;br&gt;GET /customer/pt-sessions&lt;br&gt;?view=week|month&amp;amp;date=yyyy-MM-dd&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.jsp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="180" width="340" height="110" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2 · AuthFilter.doFilter()&lt;/b&gt;&lt;br&gt;Session có ACCOUNT_ID? Có ROLE?&lt;br&gt;Chưa đăng nhập → login; chưa chọn vai trò → select-role.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;AuthFilter.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;3 · RoleAreaFilter.doFilter()&lt;/b&gt;&lt;br&gt;Có ACCOUNT_ID → role phải là CUSTOMER.&lt;br&gt;Chưa đăng nhập → chain để AuthFilter xử lý.&lt;br&gt;CustomerAreaFilter khai báo getAllowedRole().&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;RoleAreaFilter.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;4 · MyPtSessionServlet.doGet()&lt;/b&gt;&lt;br&gt;getAccountId(request) → đọc HttpSession.&lt;br&gt;null → redirect login rồi return.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="err" value="&lt;b&gt;Nhánh dừng&lt;/b&gt;&lt;br&gt;Không đăng nhập → redirect.&lt;br&gt;Sai vai trò → HTTP 403.&lt;br&gt;Không đi tới truy vấn lịch." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;5 · loadHeader()&lt;/b&gt;&lt;br&gt;dashboardService.getDashboard(accountId)&lt;br&gt;Đặt dashboard hoặc dashboardError.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;6 · loadTimetable()&lt;/b&gt;&lt;br&gt;DateTimeUtil.now() lấy 1 lần.&lt;br&gt;parseViewDate(date, today) → viewDate.&lt;br&gt;URL có date không rỗng → selectedDate.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="830" width="340" height="110" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;7 · getWeek() hoặc getMonth()&lt;/b&gt;&lt;br&gt;view=month → getMonth(); còn lại → getWeek().&lt;br&gt;ServiceResult: success + data, hoặc fail + message.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="960" width="340" height="110" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;8 · Nhận ServiceResult&lt;/b&gt;&lt;br&gt;Thành công → timetable / month.&lt;br&gt;Thất bại → timetableError.&lt;br&gt;Đặt activeSidebar, themeClass; forward VIEW.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="1090" width="340" height="110" />
        </mxCell>
        <mxCell id="j" value="&lt;b&gt;9 · JSP render HTML&lt;/b&gt;&lt;br&gt;Lỗi tải lịch → khối thông báo + Tải lại.&lt;br&gt;Thành công → bảng tuần/tháng.&lt;br&gt;Forward giữ request attribute.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.jsp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
