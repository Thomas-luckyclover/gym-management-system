        </mxCell>
        <mxCell id="a" value="&lt;b&gt;1 · Cờ thời gian, độc lập Status&lt;/b&gt;&lt;br&gt;ended = !isNotEnded(row, now)&lt;br&gt;isNotEnded: now.isBefore(slotDate.atTime(endTime))&lt;br&gt;16:30 kết thúc; now=16:30 → ended=true.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="180" width="340" height="110" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2 · switch(row.getStatus())&lt;/b&gt;&lt;br&gt;Scheduled → cây quyết định bên dưới.&lt;br&gt;CheckedIn / Missed / default → cột bên phải.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;Scheduled · đã hết giờ?&lt;/b&gt;&lt;br&gt;Có → pending / “Đang cập nhật”.&lt;br&gt;Giải thích: chờ chốt kết quả sau ngày tập.&lt;br&gt;Không tự ghi Missed vào DB.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;Scheduled · warning != null?&lt;/b&gt;&lt;br&gt;Chưa hết giờ và có cảnh báo → warn.&lt;br&gt;Nhãn “Cần chú ý”; explanation = warning.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;Scheduled · ngày tập là hôm nay?&lt;/b&gt;&lt;br&gt;Có → key=today.&lt;br&gt;now &amp;lt; startTime → “Hôm nay”.&lt;br&gt;now &amp;gt;= startTime → “Đang diễn ra”.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;Scheduled · còn lại&lt;/b&gt;&lt;br&gt;upcoming / “Sắp tới”.&lt;br&gt;Không cảnh báo và chưa tới ngày tập.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="830" width="340" height="110" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;CheckedIn&lt;/b&gt;&lt;br&gt;checkedIn / “Đã check-in”.&lt;br&gt;Gói đôi: bạn HOẶC người tập cùng đã check-in.&lt;br&gt;Giữ nhãn này dù ended=true.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;Missed&lt;/b&gt;&lt;br&gt;missed / “Vắng”.&lt;br&gt;missedExplanation(MissedReason, couple):&lt;br&gt;NoCheckIn / NoMembership / MembershipFrozen.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="j" value="&lt;b&gt;default · thông thường Cancelled&lt;/b&gt;&lt;br&gt;cancelled / “Đã hủy”.&lt;br&gt;cancelExplanation(CancelType, couple): ByPt,&lt;br&gt;ByCustomer, GymClosed, PackageExpired.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="k" value="&lt;b&gt;Nguồn trạng thái đã lưu&lt;/b&gt;&lt;br&gt;Sessions.Status / MissedReason / CancelType.&lt;br&gt;Màn này đọc kết quả; JOB-04 là luồng riêng,&lt;br&gt;không được gọi bởi applyStatus()." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="960" width="340" height="110" />
        </mxCell>
        <mxCell id="l" value="&lt;b&gt;3 · Hiển thị thẻ đã qua&lt;/b&gt;&lt;br&gt;ended=true → nền trầm, vẫn bấm được.&lt;br&gt;statusKey vẫn giữ nhãn/màu trạng thái.&lt;br&gt;Không đồng nhất ended với CheckedIn hoặc Missed.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.css / _session-card.jspf&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
