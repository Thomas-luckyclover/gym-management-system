        </mxCell>
        <mxCell id="gms-current-5-body-2" value="Đã hết giờ: không dựng cảnh báo tương lai.&lt;br&gt;Chưa hết: nếu ngày thuộc closedDays → cảnh báo&lt;br&gt;ngày phòng nghỉ trước.&lt;br&gt;Nếu không → buildGymWarning()." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-5-card-2">
