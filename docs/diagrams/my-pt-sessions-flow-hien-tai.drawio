        <mxCell id="gms-current-7-body-0" value="Đọc Membership hoặc DayPass có khoảng ngày phù&lt;br&gt;hợp; đọc bảo lưu riêng.&lt;br&gt;Quyền thực tế = có vé hợp lệ và không bị bảo lưu tại&lt;br&gt;ngày buổi.&lt;br&gt;Membership và gói PT là hai loại quyền khác nhau." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-7-card-0">
