        <mxCell id="gms-current-9-body-4" value="Google Calendar: mở form mẫu cho Scheduled chưa&lt;br&gt;hết giờ, khách tự xác nhận.&lt;br&gt;“Xem toàn bộ gói” → bookings?id=SubscriptionId khi&lt;br&gt;là gói và không bị ẩn link." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-9-card-4">
