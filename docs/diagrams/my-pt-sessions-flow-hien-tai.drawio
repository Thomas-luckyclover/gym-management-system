        </mxCell>
        <mxCell id="a" value="&lt;b&gt;1 · Chọn ngày / Tuần / Tháng&lt;/b&gt;&lt;br&gt;Form GET gửi view + date.&lt;br&gt;Link chuyển Tuần/Tháng giữ viewDate thực,&lt;br&gt;không tự thay bằng Thứ 2 hay ngày đầu tháng.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.jsp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="180" width="340" height="110" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2 · parseViewDate(value, today)&lt;/b&gt;&lt;br&gt;DateTimeUtil.parseHtmlDate().&lt;br&gt;Thiếu/sai hoặc năm ngoài 1754…9998 → hôm nay.&lt;br&gt;view khác month → mặc định week.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java / MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;3 · Hai request attribute&lt;/b&gt;&lt;br&gt;viewDate = ngày đã parse.&lt;br&gt;URL date không rỗng → selectedDate=viewDate.&lt;br&gt;Không date → không gắn dấu “Đang chọn”.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;4 · DTO giữ cờ today&lt;/b&gt;&lt;br&gt;Day/Cell.today = date.equals(now.toLocalDate()).&lt;br&gt;Chỉ ngày nằm trong kỳ đang hiện mới có dấu.&lt;br&gt;Month: ngoài tháng luôn để trống.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;TimetableView.java / MonthView.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;5 · JSP gắn hai class độc lập&lt;/b&gt;&lt;br&gt;is-today: nền cam + “Hôm nay”.&lt;br&gt;is-selected: viền xanh + “Đang chọn”.&lt;br&gt;Hai ngày khác nhau vẫn được đánh dấu cùng lúc.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.jsp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;6 · initScheduleDays() trên mobile&lt;/b&gt;&lt;br&gt;Ưu tiên requestedButton → todayButton → buttons[0].&lt;br&gt;Gọi selectScheduleDay(), hiện bộ chọn ngày;&lt;br&gt;CSS thu bảng tuần còn một cột ngày.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.js&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="830" width="340" height="110" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;7 · Bấm ngày mobile&lt;/b&gt;&lt;br&gt;selectScheduleDay(button, true): đổi aria-pressed,&lt;br&gt;is-mobile-day, is-selected; cập nhật date input&lt;br&gt;và link Tuần/Tháng. Không gọi fetch / không GET mới.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.js&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="960" width="340" height="110" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;8 · Bấm ngày ở lịch tháng&lt;/b&gt;&lt;br&gt;Link sang ?view=week&amp;amp;date=YYYY-MM-DD.&lt;br&gt;Có GET mới → lại qua Filter → Servlet → Service.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.jsp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1090" width="340" height="110" />
        </mxCell>
        <mxCell id="j" value="&lt;b&gt;Ví dụ dễ nhớ&lt;/b&gt;&lt;br&gt;Hôm nay 19/10; chọn 20/10 cùng tuần:&lt;br&gt;19/10 nền cam, 20/10 viền xanh. Chọn tháng 11:&lt;br&gt;không hiển thị 19/10 vì nằm ngoài tháng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
