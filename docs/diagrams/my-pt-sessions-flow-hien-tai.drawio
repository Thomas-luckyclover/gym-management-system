        <mxCell id="gms-current-10-body-2" value="MyPtSessionDAO giới hạn khách được xem, JOIN&lt;br&gt;các bảng, đánh số toàn gói và lọc tuần.&lt;br&gt;Buổi 274 chỉ xuất hiện nếu thuộc quyền xem và nằm&lt;br&gt;trong khoảng tuần đã yêu cầu." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-10-card-2">
