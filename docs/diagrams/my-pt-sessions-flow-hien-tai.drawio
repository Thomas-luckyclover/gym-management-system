        <mxCell id="m" value="&lt;b&gt;Ví dụ tự kiểm tra&lt;/b&gt;&lt;br&gt;20/10 15:00–16:30, Scheduled, now=16:29 → today.&lt;br&gt;now=16:30 → pending. Nếu Status=CheckedIn&lt;br&gt;thì vẫn checkedIn và ended=true." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
