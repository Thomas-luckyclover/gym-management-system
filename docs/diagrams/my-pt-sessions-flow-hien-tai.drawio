        </mxCell>
        <mxCell id="gms-current-6-body-4" value="CheckedIn → checkedIn / “Đã check-in”.&lt;br&gt;Missed → missed / “Vắng”.&lt;br&gt;Lý do: NoCheckIn, NoMembership hoặc&lt;br&gt;MembershipFrozen. CheckedIn là check-in vào gym,&lt;br&gt;không phải chốt hoàn thành buổi PT." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-6-card-4">
