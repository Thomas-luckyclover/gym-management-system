        <mxCell id="gms-current-9-note" value="GHI NHỚ&lt;br&gt;Tách hai lần hiển thị: JSP tạo HTML ở server; JS đưa phần chi tiết đã có vào hộp thoại ở trình duyệt. Không có DAO mới cho cú click mở." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1">
