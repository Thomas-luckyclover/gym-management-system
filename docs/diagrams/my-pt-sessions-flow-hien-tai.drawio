        </mxCell>
        <mxCell id="a" value="&lt;b&gt;1 · getWeek() / getMonth() gọi DAO&lt;/b&gt;&lt;br&gt;findSessionsInRange(customerId, fromDate, toDate)&lt;br&gt;Cùng SQL gốc cho lịch tuần và lịch tháng.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="180" width="340" height="110" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2 · SESSIONS_SQL · CTE MySessions&lt;/b&gt;&lt;br&gt;Orders.Status=Paid; loại PTSingle/PTCouple/SingleSession.&lt;br&gt;Khách đứng tên HOẶC người đi kèm của PTCouple.&lt;br&gt;Hai dấu ? đầu cùng là customerId.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;Nguồn lịch + gói&lt;/b&gt;&lt;br&gt;Sessions → TimeSlots&lt;br&gt;Sessions → Subscriptions → Orders" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;3 · ROW_NUMBER()&lt;/b&gt;&lt;br&gt;PARTITION BY s.SubscriptionId&lt;br&gt;ORDER BY SlotDate, StartTime, SessionId&lt;br&gt;AS SessionNo — đánh số cả gói trước khi lọc.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;4 · JOIN tên và số điện thoại&lt;/b&gt;&lt;br&gt;Employees → Persons: PtName, PtPhone.&lt;br&gt;Customers → Persons: HolderName.&lt;br&gt;LEFT JOIN người đi kèm: PartnerFullName.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;Nguồn thông tin người&lt;/b&gt;&lt;br&gt;Employees / Customers / Persons&lt;br&gt;LEFT JOIN cho người đi kèm có thể rỗng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;5 · WHERE khoảng ngày + ORDER_BY&lt;/b&gt;&lt;br&gt;WHERE ms.SlotDate BETWEEN ? AND ?&lt;br&gt;Rồi ORDER BY ms.SlotDate, ms.StartTime, ms.SessionId.&lt;br&gt;Lọc sau CTE để giữ SessionNo của cả gói.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;6 · querySessions()&lt;/b&gt;&lt;br&gt;DBContext.getConnection → prepareStatement.&lt;br&gt;setInt(1, customerId), setInt(2, customerId).&lt;br&gt;extraParams bắt đầu vị trí 3 → executeQuery().&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="830" width="340" height="110" />
        </mxCell>
        <mxCell id="j" value="&lt;b&gt;7 · readSessionRow(ResultSet)&lt;/b&gt;&lt;br&gt;Mỗi dòng → MyPtSessionRow.&lt;br&gt;SessionNo → sessionNo; GeneratedSessionCount&lt;br&gt;→ totalSessions; SQL Date/Time → java.time.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="960" width="340" height="110" />
        </mxCell>
        <mxCell id="k" value="&lt;b&gt;8 · Nhận List&amp;lt;MyPtSessionRow&amp;gt;&lt;/b&gt;&lt;br&gt;DAO chỉ đọc và ánh xạ dữ liệu.&lt;br&gt;Service mới tính nhãn và trạng thái hiển thị.&lt;br&gt;try-with-resources tự đóng Connection/Statement/RS.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="1090" width="340" height="110" />
