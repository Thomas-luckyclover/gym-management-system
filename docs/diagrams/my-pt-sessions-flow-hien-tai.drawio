        <mxCell id="a" value="&lt;b&gt;1 · loadTimetable()&lt;/b&gt;&lt;br&gt;Gọi getWeek(accountId, date, now).&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="180" width="340" height="110" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2 · findCustomerId(accountId)&lt;/b&gt;&lt;br&gt;Account phải ACTIVE; Customer tồn tại và chưa xóa.&lt;br&gt;Không hợp lệ → MSG07_NO_PERMISSION.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;AccountDAO / CustomerDAO&lt;/b&gt;&lt;br&gt;findById(accountId)&lt;br&gt;findByPersonId(account.personId)&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;AccountDAO.java / CustomerDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;Accounts → Customers&lt;/b&gt;&lt;br&gt;Liên hệ qua PersonId; mã khách dùng cho truy vấn dữ liệu cá nhân." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;3 · Tính phạm vi tuần&lt;/b&gt;&lt;br&gt;monday = weekStartOf(anyDay)&lt;br&gt;sunday = monday.plusDays(6)&lt;br&gt;20/10/2026 → 19/10 … 25/10.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;4 · findSessionsInRange()&lt;/b&gt;&lt;br&gt;customerId, monday, sunday&lt;br&gt;Ngày đầu và cuối đều được tính.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;5 · fillDisplay(rows, customerId, now)&lt;/b&gt;&lt;br&gt;Điền nhãn, người tập cùng, cảnh báo,&lt;br&gt;statusKey, ended, liên kết. Xem trang 5–7.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;6 · Dựng TimetableView&lt;/b&gt;&lt;br&gt;7 Day: Thứ 2 … Chủ nhật + cờ today.&lt;br&gt;3 Band: Sáng / Chiều / Tối.&lt;br&gt;Mỗi Band có 7 danh sách buổi.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;TimetableView.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="830" width="340" height="110" />
        </mxCell>
        <mxCell id="j" value="&lt;b&gt;7 · Xếp từng row vào ô&lt;/b&gt;&lt;br&gt;dayIndex = dayOfWeek.value - 1&lt;br&gt;bandOf(startTime): &amp;lt;12 → 0; &amp;lt;18 → 1; còn lại → 2.&lt;br&gt;cells[dayIndex].add(row)&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="960" width="340" height="110" />
        </mxCell>
        <mxCell id="k" value="&lt;b&gt;8 · ServiceResult.ok(view)&lt;/b&gt;&lt;br&gt;Đặt request.timetable → forward JSP.&lt;br&gt;SQLException → MSG04_SYSTEM_BUSY.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="1090" width="340" height="110" />
        </mxCell>
        <mxCell id="l" value="&lt;b&gt;9 · Bảng lịch tuần&lt;/b&gt;&lt;br&gt;Lặp timetable.days và bands/cells.&lt;br&gt;Ô có thể có nhiều buổi.&lt;br&gt;Ô rỗng vẫn giữ đủ khung lịch.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.jsp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
