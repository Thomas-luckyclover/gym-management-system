        <mxCell id="gms-current-10-body-1" value="getWeek() xác định phạm vi.&lt;br&gt;fillDisplay() chuẩn hóa dữ liệu.&lt;br&gt;applyStatus() quyết định nhãn; buildGymWarning()&lt;br&gt;quyết định thông điệp về quyền tập." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-10-card-1">
