        <mxCell id="gms-current-10-body-5" value="Nhãn sai → xem applyStatus và warning.&lt;br&gt;Thiếu buổi → xem quyền SQL, ngày lọc.&lt;br&gt;Số thứ tự sai → xem ROW_NUMBER.&lt;br&gt;Đúng dữ liệu nhưng sai ô → xem getWeek /&lt;br&gt;getMonth và JSP." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-10-card-5">
