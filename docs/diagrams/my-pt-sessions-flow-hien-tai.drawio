        <mxCell id="gms-current-7-body-1" value="Chủ buổi có quyền → không cảnh báo.&lt;br&gt;Bị bảo lưu → cảnh báo bảo lưu.&lt;br&gt;Không có quyền, không bảo lưu → thiếu vé;&lt;br&gt;noGymPass=true để màn gói có thể gợi ý mua." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-7-card-1">
