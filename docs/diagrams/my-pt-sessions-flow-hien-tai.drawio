        <mxCell id="gms-current-7-body-2" value="Tính quyền của chủ gói và partner.&lt;br&gt;Sau đó xác định “bạn” và “người cùng tập” theo&lt;br&gt;myCustomerId.&lt;br&gt;Cùng buổi nhưng hai người có thể đọc thông điệp&lt;br&gt;khác nhau." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-7-card-2">
