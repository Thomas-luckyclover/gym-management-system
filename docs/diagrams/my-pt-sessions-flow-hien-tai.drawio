        <mxCell id="gms-current-10-body-0" value="MyPtSessionServlet đọc account từ session và các&lt;br&gt;tham số URL.&lt;br&gt;GET hiện tại chỉ yêu cầu dữ liệu, không yêu cầu sửa&lt;br&gt;buổi.&lt;br&gt;Sai ngày → fallback; chưa login → đăng nhập." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-10-card-0">
