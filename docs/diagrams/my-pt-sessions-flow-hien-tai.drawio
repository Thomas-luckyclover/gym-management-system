        <mxCell id="a" value="&lt;b&gt;1 · view=month&lt;/b&gt;&lt;br&gt;getMonth(accountId, date, now)&lt;br&gt;Ngày 6/11 → YearMonth 11/2026.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="180" width="340" height="110" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2 · findCustomerId()&lt;/b&gt;&lt;br&gt;Xác minh Account ACTIVE và hồ sơ Customer.&lt;br&gt;Không hợp lệ → ServiceResult.fail.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;3 · Hai khoảng ngày khác nhau&lt;/b&gt;&lt;br&gt;Dữ liệu: month.atDay(1) → atEndOfMonth().&lt;br&gt;Khung: Thứ 2 tuần đầu → CN tuần cuối.&lt;br&gt;11/2026: khung 26/10 … 6/12.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;4 · findSessionsInRange()&lt;/b&gt;&lt;br&gt;Chỉ truy vấn 01/11 … 30/11.&lt;br&gt;Không lấy buổi của tháng 10 hoặc tháng 12.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;5 · fillDisplay() → dựng MonthView&lt;/b&gt;&lt;br&gt;Tạo từng Cell(date, inMonth, today).&lt;br&gt;Nhóm Cell vào từng tuần; map cellByDate&lt;br&gt;giúp tìm ô theo LocalDate.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MonthView.java / MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;6 · Thả buổi + countInto()&lt;/b&gt;&lt;br&gt;cellByDate.get(slotDate).sessions.add(row)&lt;br&gt;Đếm upcoming, checkedIn, missed, cancelled, pending.&lt;br&gt;today/upcoming/warn gộp vào upcomingCount.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="830" width="340" height="110" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;7 · ServiceResult.ok(view)&lt;/b&gt;&lt;br&gt;Đặt request.month rồi forward JSP.&lt;br&gt;SQLException → timetableError.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionServlet.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="770" y="960" width="340" height="110" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;8 · JSP xét cell.inMonth&lt;/b&gt;&lt;br&gt;false → td.is-month-padding rỗng.&lt;br&gt;true → số ngày dạng d/M + danh sách buổi.&lt;br&gt;Ngày luôn căn trên; today và selected độc lập.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;my-pt-sessions.jsp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
