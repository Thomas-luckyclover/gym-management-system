        <mxCell id="gms-current-6-body-2" value="Chưa hết giờ + warning khác null →&lt;br&gt;statusKey=warn, nhãn “Cần chú ý”.&lt;br&gt;Giải thích là ngày phòng nghỉ / thiếu quyền vào gym&lt;br&gt;/ bảo lưu tùy cảnh báo đã tính." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-6-card-2">
