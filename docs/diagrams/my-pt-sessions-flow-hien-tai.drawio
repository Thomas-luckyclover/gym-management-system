  <diagram id="gms-current-10" name="10. Ôn tập MyPTSession">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2260" pageHeight="1530" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="10. Ôn tập MyPTSession · FLOW HÀM → HÀM" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="2200" height="40" />
        </mxCell>
        <mxCell id="sub" value="Tự kể được: thao tác người dùng → hàm gọi → dữ liệu → kết quả trên màn hình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="70" width="2200" height="52" />
        </mxCell>
        <mxCell id="q0" value="&lt;b&gt;URL tới bảng lịch bằng cách nào?&lt;/b&gt;&lt;br&gt;Filter → MyPtSessionServlet.doGet → loadTimetable → getWeek/getMonth → DAO → ServiceResult → request attribute → forward JSP.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Trang 1–4&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="180.0" width="1080" height="170" />
        </mxCell>
        <mxCell id="q1" value="&lt;b&gt;Vì sao tuần nào cũng không đếm lại buổi #1?&lt;/b&gt;&lt;br&gt;ROW_NUMBER theo SubscriptionId trong CTE, trước WHERE lọc ngày. GeneratedSessionCount là tổng số buổi sinh của gói.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Trang 4&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="180.0" width="1080" height="170" />
        </mxCell>
        <mxCell id="q2" value="&lt;b&gt;Ended khác Status ra sao?&lt;/b&gt;&lt;br&gt;Ended chỉ xét now &amp;gt;= giờ kết thúc. Status lấy từ DB. CheckedIn có thể vừa ended=true vừa giữ nhãn Đã check-in.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Trang 6&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="388.0" width="1080" height="170" />
        </mxCell>
        <mxCell id="q3" value="&lt;b&gt;Đang cập nhật có phải server đang tải không?&lt;/b&gt;&lt;br&gt;Không. Scheduled đã hết giờ → pending, chờ chốt kết quả. Đây là nhãn nghiệp vụ, khác loading của nút.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Trang 6&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="388.0" width="1080" height="170" />
        </mxCell>
        <mxCell id="q4" value="&lt;b&gt;Chọn 20/10 có mất đánh dấu 19/10 không?&lt;/b&gt;&lt;br&gt;Không nếu cùng kỳ đang hiện: 19/10 là today, 20/10 là selectedDate. Tháng chỉ hiện đúng tháng; ngày ghi d/M.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Trang 3, 8&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="596.0" width="1080" height="170" />
        </mxCell>
        <mxCell id="q5" value="&lt;b&gt;Mở chi tiết có truy vấn DB nữa không?&lt;/b&gt;&lt;br&gt;Không. JS clone nội dung đã render trong HTML vào dialog. Đóng bằng nút, backdrop hoặc Escape; focus trả về nút mở.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Trang 9&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="596.0" width="1080" height="170" />
        </mxCell>
        <mxCell id="q7" value="&lt;b&gt;Màn này có tự đổi/hủy buổi không?&lt;/b&gt;&lt;br&gt;MyPtSessionServlet chỉ có doGet, không có POST hủy/đổi. Liên hệ PT qua Zalo; link Google mở form để người dùng tự lưu sự kiện.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Trang 9&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="804.0000000000001" width="1080" height="170" />
        </mxCell>
        <mxCell id="q8" value="&lt;b&gt;Lỗi SQL và không có dữ liệu có giống nhau?&lt;/b&gt;&lt;br&gt;Không. SQLException → fail(MSG04_SYSTEM_BUSY) và timetableError. Không có buổi vẫn success; JSP dựng khung lịch với các ô rỗng.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Trang 1–3&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="804.0000000000001" width="1080" height="170" />
        </mxCell>
        <mxCell id="takeaway" value="&lt;b&gt;CẦN NHỚ · &lt;/b&gt;Học trang 1 → 2/3 → 4 → 5 → 6/7, rồi trang 8/9. Mỗi lần học, kể lại một thao tác từ giao diện tới hàm và dữ liệu." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1390" width="2190" height="88" />
        </mxCell>
        <mxCell id="home" value="← Mục lục" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=14;fontColor=#225588;" vertex="1" parent="1" link="data:page/id,gms-current-0">
          <mxGeometry as="geometry" x="30" y="1490" width="180" height="28" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>