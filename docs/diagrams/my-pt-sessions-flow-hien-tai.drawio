        <mxCell id="gms-current-6-body-1" value="Điều kiện: thời điểm kết thúc ≤ now.&lt;br&gt;statusKey=pending, nhãn “Đang cập nhật”.&lt;br&gt;Đây là trạng thái hiển thị đang chờ hệ thống chốt;&lt;br&gt;DB vẫn là Scheduled." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-6-card-1">
