        </mxCell>
        <mxCell id="gms-current-5-body-5" value="Cùng statusKey và explanation dùng ở thẻ tuần, ô&lt;br&gt;tháng, danh sách và cảnh báo MyBookings.&lt;br&gt;JSP chỉ chọn cách trình bày; nghiệp vụ trạng thái&lt;br&gt;không bị viết lại trong từng JSP." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-5-card-5">
