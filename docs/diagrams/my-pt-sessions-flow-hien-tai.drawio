        <mxCell id="gms-current-5-body-4" value="Scheduled và chưa hết giờ: tạo Google Calendar&lt;br&gt;TEMPLATE URL.&lt;br&gt;Zalo URL dựa trên số điện thoại đã bỏ ký tự không&lt;br&gt;phải số.&lt;br&gt;Không tự gửi tin nhắn hay tạo lịch bên ngoài." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-5-card-4">
