        <mxCell id="a" value="&lt;b&gt;1 · Kiểm tra ngày phòng nghỉ trước&lt;/b&gt;&lt;br&gt;fillDisplay(): nếu chưa kết thúc và closedDays có ngày&lt;br&gt;→ warning phòng nghỉ; không gọi buildGymWarning&lt;br&gt;cho nhánh này.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="180" width="340" height="110" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2 · Tính holderOk&lt;/b&gt;&lt;br&gt;holderFrozen = isFrozen(holderId, day)&lt;br&gt;holderOk = hasGymPass(holderId, day)&lt;br&gt;&amp;amp;&amp;amp; !holderFrozen&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;hasGymPass() / isFrozen()&lt;/b&gt;&lt;br&gt;Membership: Active/Frozen/Expired.&lt;br&gt;DayPass: Active/Used/Expired; ngày phải trong hạn.&lt;br&gt;isFrozen: ngày có nằm trong kỳ bảo lưu?&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;Subscriptions + FreezeRecords&lt;/b&gt;&lt;br&gt;FreezeRecords JOIN Membership. Khoảng bảo lưu:&lt;br&gt;StartDate → COALESCE(ActualEndDate, PlannedEndDate).&lt;br&gt;Không chỉ xét Status hiện tại." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;3 · Cá nhân hoặc thiếu partner?&lt;/b&gt;&lt;br&gt;holderOk → không cảnh báo.&lt;br&gt;Không Ok và frozen → nhắc bảo lưu.&lt;br&gt;Còn lại → thiếu Membership/DayPass.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;4 · Gói đôi có partner&lt;/b&gt;&lt;br&gt;Tính partnerFrozen và partnerOk tương tự holder.&lt;br&gt;iAmHolder quyết định meOk / otherOk / meFrozen.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;5 · meOk &amp;amp;&amp;amp; otherOk&lt;/b&gt;&lt;br&gt;Cả hai hợp lệ → return null (không cảnh báo).&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;6 · Chỉ meOk hoặc chỉ otherOk&lt;/b&gt;&lt;br&gt;Chỉ tôi hợp lệ → tôi vẫn tham gia; nhắc người kia.&lt;br&gt;Chỉ người kia hợp lệ → họ vẫn tham gia;&lt;br&gt;nhắc tôi thiếu quyền hoặc đang bảo lưu.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="830" width="340" height="110" />
        </mxCell>
        <mxCell id="j" value="&lt;b&gt;7 · Cả hai không hợp lệ&lt;/b&gt;&lt;br&gt;Có người frozen → nhắc bảo lưu + quyền vào gym.&lt;br&gt;Không ai frozen → cả hai thiếu quyền vào gym.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="960" width="340" height="110" />
        </mxCell>
        <mxCell id="k" value="&lt;b&gt;8 · applyStatus() chọn warn&lt;/b&gt;&lt;br&gt;Chỉ Scheduled chưa hết giờ mới dùng warning&lt;br&gt;để hiện “Cần chú ý”; nội dung vào explanation.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;_session-detail.jspf&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1090" width="340" height="110" />
        </mxCell>
        <mxCell id="l" value="&lt;b&gt;Lưu ý khi trả lời thầy&lt;/b&gt;&lt;br&gt;Quyền vào gym khác quyền sở hữu gói PT.&lt;br&gt;Có gói PT vẫn có thể bị nhắc thiếu quyền vào gym.&lt;br&gt;Một người gói đôi hợp lệ không làm người kia tự hợp lệ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
