        </mxCell>
        <mxCell id="gms-current-5-note" value="GHI NHỚ&lt;br&gt;Ngày phòng nghỉ được ưu tiên cảnh báo trước Membership. Buổi vẫn tồn tại; việc dời hoặc JOB-04 hủy là luồng nghiệp vụ khác." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1">
