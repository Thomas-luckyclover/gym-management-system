        <mxCell id="gms-current-10-note" value="GHI NHỚ&lt;br&gt;Tự kể lại: Request → Servlet → Service → DAO → DTO → Service bổ sung → JSP → JS. Nhãn pending là chờ chốt, không phải trạng thái DB mới." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1">
