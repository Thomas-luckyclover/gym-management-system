        <mxCell id="gms-current-10-body-4" value="JSP lặp DTO, in thẻ / nội dung chi tiết.&lt;br&gt;JS chọn ngày, highlight 274, mở hộp thoại, copy số.&lt;br&gt;Nếu link từ gói sai buổi: kiểm tra sessionId và HTML&lt;br&gt;trước." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-10-card-4">
