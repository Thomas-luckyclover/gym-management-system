        <mxCell id="gms-current-7-body-3" value="Cả hai hợp lệ → không cảnh báo.&lt;br&gt;Chỉ bạn hợp lệ → người kia không vào được, bạn&lt;br&gt;vẫn tập.&lt;br&gt;Chỉ người kia hợp lệ → bạn không vào được, người&lt;br&gt;kia vẫn tập." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-7-card-3">
