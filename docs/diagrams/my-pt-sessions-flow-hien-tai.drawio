        </mxCell>
        <mxCell id="a" value="&lt;b&gt;1 · fillDisplay()&lt;/b&gt;&lt;br&gt;rows rỗng → return.&lt;br&gt;Danh sách từ DAO đã xếp ngày giờ tăng dần.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="180" width="340" height="110" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2 · findClosedDays(first, last)&lt;/b&gt;&lt;br&gt;Đọc ngày nghỉ cả ngày cho toàn bộ khoảng.&lt;br&gt;Trả Set&amp;lt;LocalDate&amp;gt; để contains nhanh.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;OperatingHourExceptions&lt;/b&gt;&lt;br&gt;IsClosedAllDay = 1&lt;br&gt;ApplyDate BETWEEN first AND last" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="310" width="340" height="110" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;3 · Lặp từng row&lt;/b&gt;&lt;br&gt;typeLabel(type): PT cá nhân / PT đôi / Buổi lẻ.&lt;br&gt;zaloUrl(ptPhone): chuẩn hóa số → link Zalo.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="440" width="340" height="110" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;4 · Người tập cùng&lt;/b&gt;&lt;br&gt;Nếu PTCouple và partnerCustomerId != null:&lt;br&gt;tôi là holder → partnerFullName;&lt;br&gt;tôi là partner → holderName.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="570" width="340" height="110" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;5 · Chỉ tính warning khi chưa hết giờ&lt;/b&gt;&lt;br&gt;isNotEnded = now &amp;lt; slotDate + endTime.&lt;br&gt;Ngày phòng nghỉ ưu tiên trước; nếu không nghỉ&lt;br&gt;thì buildGymWarning(row, myCustomerId).&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;DAO quyền vào gym&lt;/b&gt;&lt;br&gt;isFrozen(customerId, day)&lt;br&gt;hasGymPass(customerId, day)&lt;br&gt;Chi tiết điều kiện ở trang 7.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionDAO.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;6 · applyStatus(row, now, warning)&lt;/b&gt;&lt;br&gt;Dựa Sessions.Status + thời gian + warning.&lt;br&gt;Gán statusKey, statusLabel, explanation.&lt;br&gt;ended chỉ dựa thời gian kết thúc.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="830" width="340" height="110" />
        </mxCell>
        <mxCell id="j" value="&lt;b&gt;7 · calendarUrl(row) nếu đủ điều kiện&lt;/b&gt;&lt;br&gt;Status=Scheduled VÀ now &amp;lt; endTime.&lt;br&gt;Đổi giờ gym sang UTC; ghép URL TEMPLATE.&lt;br&gt;Đây là link mở form, không tự tạo sự kiện.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;MyPtSessionService.java&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="960" width="340" height="110" />
        </mxCell>
        <mxCell id="k" value="&lt;b&gt;8 · JSP chỉ xuất dữ liệu&lt;/b&gt;&lt;br&gt;c:out / fn:escapeXml cho nội dung động.&lt;br&gt;CSS nhận statusKey và ended để chọn giao diện.&lt;br&gt;JSP không tính lại nghiệp vụ.&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;_session-card.jspf / _session-detail.jspf&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1090" width="340" height="110" />
        </mxCell>
        <mxCell id="l" value="&lt;b&gt;Học cách tách trách nhiệm&lt;/b&gt;&lt;br&gt;DAO = dữ liệu thô. Service = quyết định nghiệp vụ.&lt;br&gt;DTO = mang dữ liệu. JSP = HTML. JS = tương tác.&lt;br&gt;Một màn Lịch tập có nhiều tầng phối hợp." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
