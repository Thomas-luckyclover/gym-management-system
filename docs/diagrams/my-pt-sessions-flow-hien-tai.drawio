        </mxCell>
        <mxCell id="gms-current-6-body-5" value="Cancelled → cancelled / “Đã hủy”.&lt;br&gt;Giải thích theo ByPt, GymClosed, PackageExpired&lt;br&gt;hoặc ByCustomer cũ.&lt;br&gt;ByCustomer chỉ còn để đọc lịch sử; không có thao&lt;br&gt;tác khách tự hủy mới." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="gms-current-6-card-5">
