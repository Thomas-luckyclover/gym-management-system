          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-dash-4-edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#46566d;strokeWidth=2;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;jettySize=auto;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gms-learn-dash-4-card-4" target="gms-learn-dash-4-card-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-dash-4-read" value="Đọc theo số và mũi tên: hàng trên từ trái sang phải, hàng dưới từ phải sang trái. Mỗi ô giải thích một bước học." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="1720" height="45" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-dash-4-note" value="GHI NHỚ&lt;br&gt;findRemindedToday() kiểm tra theo PT, khách, tiêu đề nhắc và ngày DB. Đây là kiểm tra trạng thái hiện có; không diễn giải thành khóa chống gửi đồng thời tuyệt đối." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1150" width="1720" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gms-learn-dash-4-source" value="Đối chiếu: PtDashboardServlet.doPost(); PtDashboardService.remindCustomer(); PtRemindDAO.findRemindedToday()/insertReminder() | Code hiện tại: 23/10/2026 (gồm thay đổi chưa commit)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=14;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1">
