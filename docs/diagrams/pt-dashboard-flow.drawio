        <mxCell id="gms-learn-dash-2-edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#46566d;strokeWidth=2;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;jettySize=auto;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gms-learn-dash-2-card-3" target="gms-learn-dash-2-card-4">
