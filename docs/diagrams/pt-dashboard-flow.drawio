        <mxCell id="gms-learn-dash-5-subtitle" value="getCommissionSummary(): tháng hiện tại, từ ngày đầu tháng đến trước ngày đầu tháng sau; theo ngày buổi và PT thực dạy." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1">
