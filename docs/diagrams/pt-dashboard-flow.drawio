        <mxCell id="gms-learn-dash-5-title" value="21. PT Dashboard · hoa hồng trọng tâm" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=31;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="1">
