        <mxCell id="gms-learn-recovery-subtitle" value="/forgot-password dùng một JSP với ba trạng thái: email → code → reset. POST xử lý, redirect GET để hiển thị." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1">
