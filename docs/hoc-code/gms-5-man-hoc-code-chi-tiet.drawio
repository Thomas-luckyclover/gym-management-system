từng chữ, đọc to tên biến + hàm  →&lt;br&gt;(3) trang &quot;Ai gọi ai&quot;: dò số ①②③, mở đúng file trong IDE, đặt breakpoint  →  (4) gập máy, tự vẽ lại trên giấy  →  (5) trang Phản xạ: tự hỏi tự trả lời.&lt;br&gt;Nhớ 1 câu: Servlet NHẬN request + đặt attribute · Service QUYẾT ĐỊNH · DAO CHẠY SQL · DTO CHỞ dữ liệu · JSP CHỈ IN ra." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=17;fontColor=#172b4d;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="1720" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h1" name="1.1 Homepage · Màn hình → Code"><mxGraphModel dx="1800" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h1-1" value="1.1 Homepage · Màn hình → Code" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=30;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1500" height="52" as="geometry"/></mxCell><mxCell id="h1-2" value="Trang chủ chỉ ĐỌC, không ghi DB. Không cần đăng nhập. Một biến duy nhất: home (HomePageView)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=18;fontColor=#172b4d;fillColor=none;strokeColor=none;fontStyle=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1720" height="52" as="geometry"/></mxCell><mxCell id="h1-3" value="◀ Về mục lục" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=16;fontColor=#172b4d;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;arcSize=6;" vertex="1" parent="1" link="data:page/id,idx"><mxGeometry x="1560" y="