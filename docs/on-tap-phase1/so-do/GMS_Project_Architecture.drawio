acing=6;" vertex="1" parent="arch-box10"><mxGeometry x="794" y="38" width="180" height="96" as="geometry"/></mxCell><mxCell id="arch-box16" value="&lt;b&gt;Requests&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;form GET / POST&lt;br&gt;AJAX fetch (JSON)&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=2;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillStyle=solid;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-box10"><mxGeometry x="988" y="38" width="180" height="96" as="geometry"/></mxCell><mxCell id="arch-box17" value="&lt;b&gt;Cookie&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;JSESSIONID&lt;br&gt;(session id only)&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=2;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillStyle=solid;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-box10"><mxGeometry x="1182" y="38" width="180" height="96" as="geometry"/></mxCell><mxCell id="arch-lane18" value="Application Tier — Apache Tomcat 10.1 · Jakarta EE 10 · JDK 17 (Maven WAR)" style="sketch=1;curveFitting=1;jiggle=2;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#FFFFFF;fillStyle=solid;fontStyle=1;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1060" height="580" as="geometry"/></mxCell><mxCell id="arch-box19" value="&lt;b&gt;Filter Chain&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;CharacterEncodingFilter (UTF-8) → AuthFilter (logged in?)&lt;br&gt;→ RoleAreaFilter ×5 (right role? else 403)&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=2;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillStyle=solid;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-lane18"><mxGeometry x="300" y="50" width="440" height="70" as="geometry"/></mxCell><mxCell id="arch-box20" value="&lt;b&gt;Controller Layer — Servlets&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;@WebServlet: Login · Logout · Register · ForgotPassword&lt;br&gt;SetPassword · AccountSettings · Home · Blog …&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=2;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillStyle=solid;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-lane18"><mxGeometry x="300" y="160" width="440" height="70" as="geometry"/></mxCell><mxCell id="arch-box21" value="&lt;b&gt;Service Layer — business rules&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;AuthService · RegistrationService · PasswordRecoveryService&lt;br&gt;VerificationCodeService · AccountSettingsService&lt;br&gt;ContactChangeService · SystemConfigService → ServiceResult&amp;lt;T&amp;gt;&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=2;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillStyle=solid;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-lane18"><mxGeometry x="300" y="290" width="440" height="86" as="geometry"/></mxCell><mxCell id="arc