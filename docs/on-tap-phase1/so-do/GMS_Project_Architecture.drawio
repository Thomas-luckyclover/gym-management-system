eometry"/></mxCell><mxCell id="arch-box25" value="&lt;b&gt;Constants&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Messages (MSG01–61) · SessionKey&lt;br&gt;Role · AppConstants&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=2;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillStyle=solid;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-lane18"><mxGeometry x="20" y="170" width="220" height="64" as="geometry"/></mxCell><mxCell id="arch-box26" value="&lt;b&gt;Listener&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;SessionRegistryListener&lt;br&gt;accountId → open sessions&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=2;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillStyle=solid;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-lane18"><mxGeometry x="20" y="50" width="220" height="64" as="geometry"/></mxCell><mxCell id="arch-box27" value="&lt;b&gt;HttpSession (server RAM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;accountId · role · displayName&lt;br&gt;flashToast · recovery* · timeout 2h&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=2;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillStyle=solid;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-lane18"><mxGeometry x="800" y="160" width="240" height="70" as="geometry"/></mxCell><mxCell id="arch-box28" value="&lt;b&gt;Background Jobs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Background