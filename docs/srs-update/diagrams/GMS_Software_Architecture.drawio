        <mxCell id="mapping" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;Tier to Layer mapping&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;margin-top:6px;font-size:11px;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Tier (physical)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Layer (logical)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Blocks in this diagram&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;1&quot; style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;vertical-align:middle;background:#fff2cc;&quot;&gt;&lt;b&gt;Client Tier&lt;br&gt;(Web Browser)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Presentation (what the user sees)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;HTML pages, CSS, common.js, page scripts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;6&quot; style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;vertical-align:middle;background:#dae8fc;&quot;&gt;&lt;b&gt;Application Tier&lt;br&gt;(Tomcat 10.1)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Presentation layer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Request filters, Controller (Servlets), View (JSP)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Business layer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Service Layer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Data Access Layer (DAL)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;DAO classes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Cross-cutting (used by all layers)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Model, Utilities, Constants&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Runtime (Tomcat)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;HttpSession, SessionRegistryListener, BackgroundJobScheduler&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Integration (calls outside)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;VnPayClient, EmailGateway, WeatherClient, WgerClient&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;1&quot; style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;vertical-align:middle;background:#d5e8d4;&quot;&gt;&lt;b&gt;Data Tier&lt;br&gt;(SQL Server)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;Persistence&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 8px;text-align:left;vertical-align:top;&quot;&gt;SQL Server, database GMS&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
