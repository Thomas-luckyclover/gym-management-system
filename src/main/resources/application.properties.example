# =====================================================================
# application.properties — CẤU HÌNH TRIỂN KHAI (mỗi máy 1 bản riêng)
#
# Cách dùng: copy file này thành application.properties (cùng thư mục) rồi điền thông tin máy bạn.
# application.properties đã nằm trong .gitignore — TUYỆT ĐỐI không commit (chứa mật khẩu, khóa bí mật).
#
# File này KHÔNG chứa tham số nghiệp vụ P-01…P-20 — các tham số đó nằm trong bảng SystemConfig.
# =====================================================================

# ===== Database (SQL Server) =====
# encrypt=false: SQL Server cài trên máy cá nhân thường không có chứng chỉ SSL
db.url=jdbc:sqlserver://localhost:1433;databaseName=GMS;encrypt=false;trustServerCertificate=true
db.username=sa
db.password=sa

# ===== Email Gateway — SMTP Gmail (SRS API-03) =====
# mail.app-password là "App Password" 16 ký tự tạo trong Google Account, KHÔNG phải mật khẩu Gmail
# Hướng dẫn tạo: docs/integration-guide.md mục Email
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.username=supergym.g5@gmail.com
mail.app-password=xxxxxxxxxxxxxxxx
mail.from-name=Super Gym

# ===== VNPay (SRS API-01, API-02) — môi trường SANDBOX =====
# tmn-code và hash-secret: VNPay gửi qua email sau khi đăng ký tại https://sandbox.vnpayment.vn/devreg/
vnpay.tmn-code=XXXXXXXX
vnpay.hash-secret=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
vnpay.pay-url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trang trình duyệt quay về sau khi thanh toán (chỉ hiển thị kết quả)
vnpay.return-url=http://localhost:8080/gym-management-system/payment/vnpay-return

# ===== Số điện thoại (DBR-17, P-16) — đầu số nhà mạng hợp lệ, cách nhau bởi dấu phẩy =====
phone.valid-prefixes=032,033,034,035,036,037,038,039,086,096,097,098,070,076,077,078,079,089,090,093,081,082,083,084,085,088,091,094,052,056,058,092,059,099,087,055

# ===== Upload ảnh (DBR-08) — thư mục NGOÀI project để redeploy không mất ảnh =====
app.upload-dir=D:\GMS\Upload