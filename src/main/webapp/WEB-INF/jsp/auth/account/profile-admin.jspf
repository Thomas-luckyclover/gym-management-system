<%@ page pageEncoding="UTF-8" %>
<section class="account-card account-profile-card">

    <div class="account-card-body">

        <div class="account-avatar-section">

            <div class="account-avatar-preview">

                <c:choose>

                    <c:when test="${not empty accountSettings.avatar}">
                        <img
                            id="avatarPreview"
                            class="account-avatar-image"
                            src="${pageContext.request.contextPath}${accountSettings.avatar}"
                            alt="Ảnh đại diện"
                        >

                        <div
                            id="avatarFallback"
                            class="account-avatar-fallback is-hidden"
                        >
                            <c:out value="${accountSettings.fullName.substring(0, 1)}" />
                        </div>
                    </c:when>

                    <c:otherwise>
                        <img
                            id="avatarPreview"
                            class="account-avatar-image is-hidden"
                            src=""
                            alt="Ảnh đại diện"
                        >

                        <div
                            id="avatarFallback"
                            class="account-avatar-fallback"
                        >
                            <c:out value="${accountSettings.fullName.substring(0, 1)}" />
                        </div>
                    </c:otherwise>

                </c:choose>

            </div>

            <div class="account-avatar-info">

                <strong>
                    <c:out value="${accountSettings.fullName}" />
                </strong>

                <span>
                    Ảnh đại diện tài khoản
                </span>

            </div>

            <form
                id="avatarForm"
                method="post"
                action="${pageContext.request.contextPath}/account"
                enctype="multipart/form-data"
                class="account-avatar-form"
            >

                <input
                    type="hidden"
                    name="action"
                    value="updateAvatar"
                >

                <input
                    id="avatarFile"
                    name="avatarFile"
                    type="file"
                    accept="image/jpeg,image/png"
                    class="account-avatar-input"
                >

                <label
                    for="avatarFile"
                    class="btn"
                >
                    Chọn ảnh
                </label>

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Cập nhật ảnh
                </button>

            </form>
            <c:if test="${not empty avatarError}">
                <span class="field-error">
                    <c:out value="${avatarError}" />
                </span>
            </c:if>

        </div>
        <h2>Hồ sơ</h2>

        <p class="account-subtitle">
            Bạn có thể thay đổi email và số điện thoại.
            Các thông tin nhân sự khác chỉ được xem.
        </p>

        <c:if test="${not empty formMessage}">
            <div class="msg-banner">
                <c:out value="${formMessage}" />
            </div>
        </c:if>

        <div class="account-form-grid">

            <div class="field account-field-full">

                <label
                    class="field-label"
                    for="profileName"
                >
                    Họ và tên
                </label>

                <input
                    id="profileName"
                    type="text"
                    value="<c:out value='${accountSettings.fullName}' />"
                    readonly
                >

            </div>


            <%-- ================= EMAIL ================= --%>

            <form
                method="post"
                action="${pageContext.request.contextPath}/account"
                class="field"
                data-validate
            >

                <input
                    type="hidden"
                    name="action"
                    value="requestEmailChange"
                >

                <label
                    class="field-label"
                    for="profileEmail"
                >
                    Email
                </label>

                <input
                    id="profileEmail"
                    name="newEmail"
                    type="email"
                    maxlength="100"
                    data-rule="email"
                    data-label="Email"
                    value="<c:out value='${not empty newEmail ? newEmail : accountSettings.email}' />"
                    required
                >

                <c:if test="${not empty errors.email}">
                    <span class="field-error">
                        <c:out value="${errors.email}" />
                    </span>
                </c:if>

                <span class="field-hint">
                    Mã xác thực sẽ được gửi tới email mới.
                </span>

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Đổi email
                </button>

            </form>


            <%-- ================= PHONE ================= --%>

            <form
                method="post"
                action="${pageContext.request.contextPath}/account"
                class="field"
                data-validate
            >

                <input
                    type="hidden"
                    name="action"
                    value="requestPhoneChange"
                >

                <label
                    class="field-label"
                    for="profilePhone"
                >
                    Số điện thoại
                </label>

                <input
                    id="profilePhone"
                    name="newPhone"
                    type="tel"
                    maxlength="10"
                    inputmode="numeric"
                    data-rule="phone"
                    data-label="Số điện thoại"
                    value="<c:out value='${not empty newPhone ? newPhone : accountSettings.phone}' />"
                    required
                >

                <c:if test="${not empty errors.phone}">
                    <span class="field-error">
                        <c:out value="${errors.phone}" />
                    </span>
                </c:if>

                <span class="field-hint">
                    Mã xác thực sẽ được gửi tới email hiện tại.
                </span>

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Đổi số điện thoại
                </button>

            </form>

        </div>


        <%-- ================= VERIFY OTP ================= --%>

        <c:if test="${contactVerificationPending}">

            <div class="msg-banner">

                Mã xác thực đã được gửi tới&nbsp;

                <strong>
                    <c:out value="${verifyTarget}" />
                </strong>

            </div>

            <form
                method="post"
                action="${pageContext.request.contextPath}/account"
                data-validate
            >

                <input
                    type="hidden"
                    name="action"
                    value="verifyContactChange"
                >

                <input
                    type="hidden"
                    name="contactField"
                    value="<c:out value='${contactField}' />"
                >

                <input
                    type="hidden"
                    name="verificationEmail"
                    value="<c:out value='${verificationEmail}' />"
                >

                <input
                    type="hidden"
                    name="pendingContactValue"
                    value="<c:out value='${pendingContactValue}' />"
                >

                <div class="field">

                    <label
                        class="field-label"
                        for="verificationCode"
                    >
                        Mã xác thực
                    </label>

                    <input
                        id="verificationCode"
                        name="verificationCode"
                        type="text"
                        maxlength="6"
                        inputmode="numeric"
                        data-rule="verificationCode"
                        data-label="Mã xác thực"
                        required
                    >

                    <c:if test="${not empty errors.code}">
                        <span class="field-error">
                            <c:out value="${errors.code}" />
                        </span>
                    </c:if>

                </div>

                <div class="account-form-actions">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Xác nhận thay đổi
                    </button>

                </div>

            </form>

        </c:if>

</section>