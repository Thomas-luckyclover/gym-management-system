<%@ page pageEncoding="UTF-8" %>
<section class="account-card account-profile-card">

    <div class="account-card-body">

        <div class="account-avatar-section">

            <div class="account-avatar-preview">

                <c:choose>

                    <c:when test="${not empty accountSettings.avatar}">
                        <img
                            id="avatarPreview"
                            class="account-avatar-image"
                            src="${pageContext.request.contextPath}${accountSettings.avatar}"
                            alt="Ảnh đại diện"
                        >

                        <div
                            id="avatarFallback"
                            class="account-avatar-fallback is-hidden"
                        >
                            <c:out value="${accountSettings.fullName.substring(0, 1)}" />
                        </div>
                    </c:when>

                    <c:otherwise>
                        <img
                            id="avatarPreview"
                            class="account-avatar-image is-hidden"
                            src=""
                            alt="Ảnh đại diện"
                        >

                        <div
                            id="avatarFallback"
                            class="account-avatar-fallback"
                        >
                            <c:out value="${accountSettings.fullName.substring(0, 1)}" />
                        </div>
                    </c:otherwise>

                </c:choose>

            </div>

            <div class="account-avatar-info">

                <strong>
                    <c:out value="${accountSettings.fullName}" />
                </strong>

                <span>
                    Ảnh đại diện tài khoản
                </span>

            </div>

            <form
                id="avatarForm"
                method="post"
                action="${pageContext.request.contextPath}/account"
                enctype="multipart/form-data"
                class="account-avatar-form"
            >

                <input
                    type="hidden"
                    name="action"
                    value="updateAvatar"
                >

                <input
                    id="avatarFile"
                    name="avatarFile"
                    type="file"
                    accept="image/jpeg,image/png"
                    class="account-avatar-input"
                >

                <label
                    for="avatarFile"
                    class="btn"
                >
                    Chọn ảnh
                </label>

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Cập nhật ảnh
                </button>

            </form>
            <c:if test="${not empty avatarError}">
                <span class="field-error">
                    <c:out value="${avatarError}" />
                </span>
            </c:if>

        </div>
        <h2>Hồ sơ</h2>


        <p class="account-subtitle">
            Đổi email cần xác thực qua mã gửi tới email mới.
        </p>

        <div class="account-form-grid">

            <div class="field account-field-full">
                <label
                    class="field-label"
                    for="profileName"
                >
                    Họ và tên
                </label>

                <input
                    id="profileName"
                    type="text"
                    value="<c:out value='${accountSettings.fullName}' />"
                    readonly
                >
            </div>

            <div class="field">
                <label
                    class="field-label"
                    for="profileEmail"
                >
                    Email
                </label>

                <input
                    id="profileEmail"
                    type="email"
                    value="<c:out value='${accountSettings.email}' />"
                    readonly
                >
            </div>

            <div class="field">
                <label
                    class="field-label"
                    for="profilePhone"
                >
                    Số điện thoại
                </label>

                <input
                    id="profilePhone"
                    type="text"
                    value="<c:out value='${accountSettings.phone}' />"
                    readonly
                >
            </div>

        </div>

    </div>

    <div class="account-form-actions">
        <button
            type="button"
            class="btn btn-primary"
            disabled
        >
            Lưu thay đổi
        </button>
    </div>

</section>