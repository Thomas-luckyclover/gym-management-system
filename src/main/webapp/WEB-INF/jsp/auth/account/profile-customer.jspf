<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="gms" uri="/WEB-INF/gms-functions.tld" %>

<%-- Profile: accountSettings do Service tạo từ Person và hồ sơ của vai trò trong Session. --%>
<section class="account-card account-profile-card">
    <div class="account-card-body">
        <%-- Header: giữ ID để account-settings.js xem trước và gửi avatarForm. --%>
        <div class="account-avatar-section">
            <div class="account-avatar-preview">
                <c:choose>
                    <c:when test="${not empty accountSettings.avatar}">
                        <img id="avatarPreview" class="account-avatar-image"
                             src="<c:out value='${pageContext.request.contextPath}${accountSettings.avatar}' />" alt="Ảnh đại diện">
                        <div id="avatarFallback" class="account-avatar-fallback is-hidden">
                            <c:out value="${empty accountSettings.fullName ? '—' : accountSettings.fullName.substring(0, 1)}" />
                        </div>
                    </c:when>
                    <c:otherwise>
                        <img id="avatarPreview" class="account-avatar-image is-hidden" alt="Ảnh đại diện">
                        <div id="avatarFallback" class="account-avatar-fallback">
                            <c:out value="${empty accountSettings.fullName ? '—' : accountSettings.fullName.substring(0, 1)}" />
                        </div>
                    </c:otherwise>
                </c:choose>
            </div>
            <div class="account-avatar-info">
                <strong><c:out value="${empty accountSettings.fullName ? '—' : accountSettings.fullName}" /></strong>
                <span><c:out value="${accountSettings.role.displayName}" default="—" /></span>
                <span><c:out value="${empty accountSettings.customerCode ? '—' : accountSettings.customerCode}" /></span>
            </div>
            <form id="avatarForm" method="post" action="${pageContext.request.contextPath}/account"
                  enctype="multipart/form-data" class="account-avatar-form">
                <input type="hidden" name="action" value="updateAvatar">
                <input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}' />">
                <input id="avatarFile" name="avatarFile" type="file" accept="image/jpeg,image/png"
                       data-max-bytes="2097152" class="account-avatar-input">
                <label for="avatarFile" class="btn btn-primary">Đổi ảnh đại diện</label>
            </form>
        </div>
        <span id="avatarClientError" class="field-error is-hidden" role="alert"></span>
        <c:if test="${not empty avatarError}">
            <div class="field-error" role="alert"><c:out value="${avatarError}" /></div>
        </c:if>
        <c:if test="${not empty formMessage}">
            <div class="msg-banner" role="status"><c:out value="${formMessage}" /></div>
        </c:if>

        <%-- Thông tin cá nhân: chỉ email và điện thoại dùng các action cập nhật hiện có. --%>
        <section class="account-profile-section" aria-labelledby="personalInformationTitle">
            <h2 id="personalInformationTitle">Thông tin cá nhân</h2>
            <p class="account-subtitle">
                Bạn có thể tự thay đổi ảnh đại diện, email và số điện thoại.
                Họ tên và ngày sinh chỉ do Lễ tân cập nhật; vui lòng liên hệ quầy khi cần điều chỉnh.
            </p>
            <div class="account-form-grid">
                <div class="field">
                    <label class="field-label" for="profileFullName">Họ và tên</label>
                    <input id="profileFullName" type="text" readonly
                           value="<c:out value='${empty accountSettings.fullName ? "—" : accountSettings.fullName}' />">
                </div>
                <div class="field">
                    <label class="field-label" for="profileDob">Ngày sinh</label>
                    <input id="profileDob" type="text" readonly
                           value="<c:out value='${empty accountSettings.dateOfBirth ? "—" : gms:formatDate(accountSettings.dateOfBirth)}' />">
                </div>
                <div class="account-profile-contact">
                    <form id="emailForm" method="post" action="${pageContext.request.contextPath}/account"
                          class="stack" data-validate>
                        <input type="hidden" name="action" value="requestEmailChange">
                        <input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}' />">
                        <div class="field">
                            <label class="field-label" for="profileEmail">Địa chỉ email</label>
                            <input id="profileEmail" name="newEmail" type="email" maxlength="100" placeholder="—"
                                   autocomplete="email" data-rule="email" data-label="Địa chỉ email"
                                   value="<c:out value='${not empty newEmail ? newEmail : (contactVerificationPending and contactField eq "EMAIL" ? pendingContactValue : accountSettings.email)}' />"
                                   required>
                            <span class="field-hint">Mã xác thực được gửi tới email mới.</span>
                            <span id="profileEmailError" class="field-error" ${empty errors.email ? 'hidden' : ''}>
                                <c:out value="${errors.email}" />
                            </span>
                        </div>
                        <button type="submit" class="btn btn-primary">Đổi email</button>
                    </form>
                    <%-- OTP là form riêng ngay dưới trường email; giá trị chờ đổi được Servlet lấy từ Session. --%>
                    <c:if test="${contactVerificationPending and contactField eq 'EMAIL'}">
                        <form id="verifyEmailForm" method="post" action="${pageContext.request.contextPath}/account"
                              class="stack account-profile-verification" data-validate>
                            <input type="hidden" name="action" value="verifyContactChange">
                            <input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}' />">
                            <p class="field-hint">
                                Nhập mã gửi tới <strong><c:out value="${verificationEmail}" /></strong>
                                để xác nhận <strong><c:out value="${pendingContactValue}" /></strong>.
                            </p>
                            <div class="field">
                                <label class="field-label" for="emailVerificationCode">Mã xác thực (6 chữ số)</label>
                                <input id="emailVerificationCode" name="verificationCode" type="text"
                                       maxlength="6" inputmode="numeric" autocomplete="one-time-code"
                                       data-rule="verificationCode" data-label="Mã xác thực" required>
                                <span id="emailVerificationCodeError" class="field-error"
                                      ${empty errors.code and empty errors.verificationCode ? 'hidden' : ''}>
                                    <c:out value="${not empty errors.code ? errors.code : errors.verificationCode}" />
                                </span>
                            </div>
                            <button type="submit" class="btn btn-primary">Xác nhận email</button>
                        </form>
                    </c:if>
                </div>
                <div class="account-profile-contact">
                    <form id="phoneForm" method="post" action="${pageContext.request.contextPath}/account"
                          class="stack" data-validate>
                        <input type="hidden" name="action" value="requestPhoneChange">
                        <input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}' />">
                        <div class="field">
                            <label class="field-label" for="profilePhone">Số điện thoại</label>
                            <input id="profilePhone" name="newPhone" type="tel" maxlength="10" placeholder="—"
                                   inputmode="numeric" autocomplete="tel" data-rule="phone" data-label="Số điện thoại"
                                   value="<c:out value='${not empty newPhone ? newPhone : (contactVerificationPending and contactField eq "PHONE" ? pendingContactValue : accountSettings.phone)}' />"
                                   required>
                            <span class="field-hint">Mã xác thực được gửi tới email hiện tại.</span>
                            <span id="profilePhoneError" class="field-error" ${empty errors.phone ? 'hidden' : ''}>
                                <c:out value="${errors.phone}" />
                            </span>
                        </div>
                        <button type="submit" class="btn btn-primary">Đổi số điện thoại</button>
                    </form>
                    <%-- OTP là form riêng ngay dưới trường phone; giá trị chờ đổi được Servlet lấy từ Session. --%>
                    <c:if test="${contactVerificationPending and contactField eq 'PHONE'}">
                        <form id="verifyPhoneForm" method="post" action="${pageContext.request.contextPath}/account"
                              class="stack account-profile-verification" data-validate>
                            <input type="hidden" name="action" value="verifyContactChange">
                            <input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}' />">
                            <p class="field-hint">
                                Nhập mã gửi tới <strong><c:out value="${verificationEmail}" /></strong>
                                để xác nhận <strong><c:out value="${pendingContactValue}" /></strong>.
                            </p>
                            <div class="field">
                                <label class="field-label" for="phoneVerificationCode">Mã xác thực (6 chữ số)</label>
                                <input id="phoneVerificationCode" name="verificationCode" type="text"
                                       maxlength="6" inputmode="numeric" autocomplete="one-time-code"
                                       data-rule="verificationCode" data-label="Mã xác thực" required>
                                <span id="phoneVerificationCodeError" class="field-error"
                                      ${empty errors.code and empty errors.verificationCode ? 'hidden' : ''}>
                                    <c:out value="${not empty errors.code ? errors.code : errors.verificationCode}" />
                                </span>
                            </div>
                            <button type="submit" class="btn btn-primary">Xác nhận số điện thoại</button>
                        </form>
                    </c:if>
                </div>
            </div>
        </section>

        <%-- Thông tin khách: Customers của chính Person đăng nhập, không phải hồ sơ được giám hộ. --%>
        <section class="account-profile-section" aria-labelledby="roleInformationTitle">
            <h2 id="roleInformationTitle">Thông tin khách hàng</h2>
            <p class="account-subtitle">
                Các thông tin này chỉ được xem. Vui lòng liên hệ quầy Lễ tân nếu cần hỗ trợ.
            </p>
            <div class="account-form-grid">
                <div class="field">
                    <label class="field-label" for="profileCustomerCode">Mã khách hàng</label>
                    <input id="profileCustomerCode" type="text" readonly value="<c:out value='${empty accountSettings.customerCode ? "—" : accountSettings.customerCode}' />">
                </div>
                <div class="field">
                    <label class="field-label" for="profileCustomerType">Loại khách hàng</label>
                    <input id="profileCustomerType" type="text" readonly value="<c:out value='${empty accountSettings.customerType ? "—" : (accountSettings.customerType eq "Self" ? "Khách hàng tự quản lý" : (accountSettings.customerType eq "Dependent" ? "Khách hàng phụ thuộc" : accountSettings.customerType))}' />">
                </div>
                <div class="field">
                    <label class="field-label" for="profileMembershipStatus">Trạng thái hội viên</label>
                    <input id="profileMembershipStatus" type="text" readonly value="<c:out value='${empty accountSettings.membershipStatus ? "—" : (accountSettings.membershipStatus eq "New" ? "Mới" : (accountSettings.membershipStatus eq "Active" ? "Đang hoạt động" : (accountSettings.membershipStatus eq "Frozen" ? "Đang bảo lưu" : (accountSettings.membershipStatus eq "Expired" ? "Hết hạn" : (accountSettings.membershipStatus eq "Inactive" ? "Ngừng hoạt động" : accountSettings.membershipStatus)))))}' />">
                </div>
                <div class="field">
                    <label class="field-label" for="profileJoinDate">Ngày tham gia</label>
                    <input id="profileJoinDate" type="text" readonly value="<c:out value='${empty accountSettings.joinedAt ? "—" : gms:formatDate(accountSettings.joinedAt.toLocalDate())}' />">
                </div>
            </div>
        </section>
    </div>
</section>
