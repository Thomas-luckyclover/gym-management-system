<%--
  profile-manager.jspf — Cài đặt tài khoản Quản lý.
  Khớp prototype Manager viewSettings(): 2 cột Hồ sơ + Đổi mật khẩu.
  Dữ liệu: accountSettings (AccountSettingsView) do AccountSettingsServlet set.
--%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<c:set var="managerInitial" value="QL" />
<c:if test="${not empty accountSettings.fullName}">
  <c:set var="managerInitial" value="${accountSettings.fullName.substring(0, 1)}" />
</c:if>

<div class="account-settings-grid">

  <%-- Cột trái: hồ sơ (ảnh, email, SĐT) — prototype #/settings --%>
  <section class="account-card">
    <div class="account-card-body">
      <h2>Hồ sơ</h2>
      <p class="account-subtitle">Ảnh đại diện, email và số điện thoại</p>

      <div class="account-avatar-section">
        <div class="account-avatar-preview">
          <c:choose>
            <c:when test="${not empty accountSettings.avatar}">
              <img id="avatarPreview"
                   class="account-avatar-image"
                   src="${pageContext.request.contextPath}${accountSettings.avatar}"
                   alt="Ảnh đại diện">
              <div id="avatarFallback" class="account-avatar-fallback is-hidden">
                <c:out value="${managerInitial}" />
              </div>
            </c:when>
            <c:otherwise>
              <img id="avatarPreview"
                   class="account-avatar-image is-hidden"
                   src=""
                   alt="Ảnh đại diện">
              <div id="avatarFallback" class="account-avatar-fallback">
                <c:out value="${managerInitial}" />
              </div>
            </c:otherwise>
          </c:choose>
        </div>

        <form id="avatarForm"
              method="post"
              action="${pageContext.request.contextPath}/account"
              enctype="multipart/form-data"
              class="account-avatar-form">
          <input type="hidden" name="action" value="updateAvatar">
          <input id="avatarFile"
                 name="avatarFile"
                 type="file"
                 accept="image/jpeg,image/png"
                 class="account-avatar-input">
          <label for="avatarFile" class="btn btn-sm">Đổi ảnh</label>
        </form>
      </div>

      <form id="profileForm"
            method="post"
            action="${pageContext.request.contextPath}/account"
            class="stack"
            novalidate
            data-validate
            data-unsaved-warning>
        <input type="hidden" name="action" value="updateProfile">

        <div class="field">
          <label class="field-label" for="profileEmail">Email</label>
          <input id="profileEmail"
                 name="email"
                 type="email"
                 maxlength="100"
                 data-rule="email"
                 data-label="Email"
                 value="<c:out value='${accountSettings.email}' />"
                 required>
          <c:if test="${not empty errors.email}">
            <span class="field-error" id="profileEmailError">
              <c:out value="${errors.email}" />
            </span>
          </c:if>
        </div>

        <div class="field">
          <label class="field-label" for="profilePhone">Số điện thoại</label>
          <input id="profilePhone"
                 name="phone"
                 type="tel"
                 maxlength="10"
                 inputmode="numeric"
                 data-rule="phone"
                 data-label="Số điện thoại"
                 value="<c:out value='${accountSettings.phone}' />"
                 required>
          <c:if test="${not empty errors.phone}">
            <span class="field-error" id="profilePhoneError">
              <c:out value="${errors.phone}" />
            </span>
          </c:if>
        </div>

        <%-- Bước nhập mã khi đổi email/SĐT — hiện khi Servlet set requireVerification --%>
        <c:if test="${not empty requireVerification}">
          <div class="msg-banner info" role="status">
            <i class="fa-solid fa-circle-info"></i>
            <div>
              <b>Nhập mã đã gửi tới email mới</b>
              Mã có hiệu lực trong 15 phút.
            </div>
          </div>
          <div class="field">
            <label class="field-label" for="verificationCode">Mã xác thực</label>
            <input id="verificationCode"
                   name="verificationCode"
                   class="input"
                   type="text"
                   maxlength="6"
                   inputmode="numeric"
                   data-rule="verificationCode"
                   data-label="Mã xác thực">
            <c:if test="${not empty errors.code}">
              <span class="field-error" id="verificationCodeError">
                <c:out value="${errors.code}" />
              </span>
            </c:if>
          </div>
        </c:if>
      </form>
    </div>

    <div class="account-form-actions">
      <c:choose>
        <c:when test="${not empty requireVerification}">
          <button class="btn" type="button" form="profileForm" name="action" value="cancelVerification">
            Hủy
          </button>
          <button class="btn btn-primary" type="submit" form="profileForm">
            Xác nhận mã
          </button>
        </c:when>
        <c:otherwise>
          <button class="btn btn-primary" type="submit" form="profileForm">
            Lưu thay đổi
          </button>
        </c:otherwise>
      </c:choose>
    </div>
  </section>

  <%-- Cột phải: đổi mật khẩu — form dùng chung tab-password (action=changePassword) --%>
  <%@ include file="/WEB-INF/jsp/auth/account/tab-password.jspf" %>
</div>
