<%--
  profile-manager.jspf — Cài đặt tài khoản Quản lý.
  Khớp prototype Manager viewSettings(): 2 cột Hồ sơ + Đổi mật khẩu.
  CBR-108: thông tin nhân sự READ-ONLY (Admin sửa qua UC-07); tự sửa được: ảnh, email, SĐT, mật khẩu.
  CBR-110/111: đổi email → mã gửi email MỚI; đổi SĐT → mã gửi email HIỆN TẠI.
  Dữ liệu: accountSettings (AccountSettingsView) do AccountSettingsServlet set.
--%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="gms" uri="/WEB-INF/gms-functions.tld" %>

<c:set var="managerInitial" value="QL" />
<c:if test="${not empty accountSettings.fullName}">
  <c:set var="managerInitial" value="${accountSettings.fullName.substring(0, 1)}" />
</c:if>

<div class="account-settings-grid">

  <%-- ===== Cột trái: hồ sơ ===== --%>
  <section class="account-card">
    <div class="account-card-body">
      <h2>Hồ sơ</h2>
      <p class="account-subtitle">Ảnh đại diện, email và số điện thoại</p>

      <%-- Ảnh đại diện: JS tự kiểm tra rồi submit khi chọn file --%>
      <div class="account-avatar-section">
        <div class="account-avatar-preview">
          <c:choose>
            <c:when test="${not empty accountSettings.avatar}">
              <img id="avatarPreview" class="account-avatar-image"
                   src="${pageContext.request.contextPath}${accountSettings.avatar}"
                   alt="Ảnh đại diện">
              <div id="avatarFallback" class="account-avatar-fallback is-hidden">
                <c:out value="${managerInitial}" />
              </div>
            </c:when>
            <c:otherwise>
              <img id="avatarPreview" class="account-avatar-image is-hidden" src="" alt="Ảnh đại diện">
              <div id="avatarFallback" class="account-avatar-fallback">
                <c:out value="${managerInitial}" />
              </div>
            </c:otherwise>
          </c:choose>
        </div>

        <form id="avatarForm" method="post"
              action="${pageContext.request.contextPath}/account"
              enctype="multipart/form-data"
              class="account-avatar-form">
          <input type="hidden" name="action" value="updateAvatar">
          <input id="avatarFile" name="avatarFile" type="file"
                 accept="image/jpeg,image/png"
                 data-max-bytes="2097152"
                 class="account-avatar-input">
          <label for="avatarFile" class="btn btn-sm">Đổi ảnh</label>
          <span class="field-hint">JPG/PNG, tối đa 2 MB</span>
        </form>
        <span id="avatarClientError" class="field-error is-hidden" role="alert"></span>
        <c:if test="${not empty avatarError}">
          <span class="field-error"><c:out value="${avatarError}" /></span>
        </c:if>
      </div>

      <%-- Thông tin nhân sự — READ-ONLY (CBR-108) --%>
      <div class="account-form-grid" style="margin-bottom: var(--space-4)">
        <div class="field">
          <label class="field-label">Họ và tên</label>
          <input type="text" value="<c:out value='${accountSettings.fullName}' />" readonly>
        </div>
        <div class="field">
          <label class="field-label">Mã nhân viên</label>
          <input type="text" value="<c:out value='${accountSettings.employeeCode}' />" readonly>
        </div>
        <c:if test="${not empty accountSettings.position}">
          <div class="field">
            <label class="field-label">Chức vụ</label>
            <input type="text" value="<c:out value='${accountSettings.position.displayName}' />" readonly>
          </div>
        </c:if>
        <c:if test="${not empty accountSettings.hireDate}">
          <div class="field">
            <label class="field-label">Ngày vào làm</label>
            <input type="text" value="<c:out value='${gms:formatDate(accountSettings.hireDate)}' />" readonly>
          </div>
        </c:if>
        <c:if test="${not empty accountSettings.employmentStatus}">
          <div class="field">
            <label class="field-label">Trạng thái làm việc</label>
            <c:set var="empStatusText" value="${accountSettings.employmentStatus}" />
            <c:if test="${empStatusText eq 'WORKING' or empStatusText eq 'Working'}">
              <c:set var="empStatusText" value="Đang làm việc" />
            </c:if>
            <c:if test="${empStatusText eq 'RESIGNED' or empStatusText eq 'Resigned'}">
              <c:set var="empStatusText" value="Đã nghỉ việc" />
            </c:if>
            <input type="text" value="<c:out value='${empStatusText}' />" readonly>
          </div>
        </c:if>
      </div>

      <%-- Email — action requestEmailChange --%>
      <form id="emailForm" method="post"
            action="${pageContext.request.contextPath}/account"
            class="stack" novalidate data-validate>
        <input type="hidden" name="action" value="requestEmailChange">
        <div class="field">
          <label class="field-label" for="profileEmail">Email</label>
          <input id="profileEmail" name="email" type="email" maxlength="100"
                 data-rule="email" data-label="Email"
                 value="<c:out value='${accountSettings.email}' />" required>
          <c:if test="${not empty errors.email}">
            <span class="field-error"><c:out value="${errors.email}" /></span>
          </c:if>
        </div>
        <div class="account-form-actions">
          <button class="btn btn-primary" type="submit">Đổi email</button>
        </div>
      </form>

      <%-- SĐT — action requestPhoneChange --%>
      <form id="phoneForm" method="post"
            action="${pageContext.request.contextPath}/account"
            class="stack" novalidate data-validate>
        <input type="hidden" name="action" value="requestPhoneChange">
        <div class="field">
          <label class="field-label" for="profilePhone">Số điện thoại</label>
          <input id="profilePhone" name="phone" type="tel" maxlength="10"
                 inputmode="numeric" data-rule="phone" data-label="Số điện thoại"
                 value="<c:out value='${accountSettings.phone}' />" required>
          <c:if test="${not empty errors.phone}">
            <span class="field-error"><c:out value="${errors.phone}" /></span>
          </c:if>
        </div>
        <div class="account-form-actions">
          <button class="btn btn-primary" type="submit">Đổi số điện thoại</button>
        </div>
      </form>

      <%-- Bước nhập mã: hiện khi servlet set requireVerification --%>
      <c:if test="${not empty requireVerification}">
        <form id="verifyForm" method="post"
              action="${pageContext.request.contextPath}/account"
              class="stack" novalidate data-validate>
          <input type="hidden" name="action" value="verifyContactChange">
          <div class="msg-banner info" role="status">
            <i class="fa-solid fa-circle-info"></i>
            <div>
              <b>Nhập mã đã gửi tới <c:out value="${verifyTarget}" /></b>
              Mã có hiệu lực trong 15 phút.
            </div>
          </div>
          <div class="field">
            <label class="field-label" for="verificationCode">Mã xác thực</label>
            <input id="verificationCode" name="verificationCode" class="input"
                   type="text" maxlength="6" inputmode="numeric"
                   data-rule="verificationCode" data-label="Mã xác thực" required>
            <c:if test="${not empty errors.code}">
              <span class="field-error"><c:out value="${errors.code}" /></span>
            </c:if>
          </div>
          <div class="account-form-actions">
            <%-- Tạm dùng link GET; sau khi có handler cancelContactChange thì đổi thành form POST --%>
            <a class="btn" href="${pageContext.request.contextPath}/account?tab=profile">Hủy</a>
            <button class="btn btn-primary" type="submit">Xác nhận mã</button>
          </div>
        </form>
      </c:if>
    </div>
  </section>

  <%-- ===== Cột phải: đổi mật khẩu (action=changePassword) ===== --%>
  <%@ include file="/WEB-INF/jsp/auth/account/tab-password.jspf" %>
</div>
