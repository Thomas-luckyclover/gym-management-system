
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="gms" uri="/WEB-INF/gms-functions.tld" %>

<div class="cust-content account-settings-wrap">
    <div class="page-head">
        <h1>Cài đặt tài khoản</h1>
    </div>

    <!-- Banner báo lỗi chung nếu có -->
    <div id="generalErrorBanner" class="auth-alert error-alert <c:if test='${empty errorMessage}'>hidden</c:if>">
        <i class="fa-solid fa-circle-exclamation alert-icon"></i>
        <span id="generalErrorText"><c:out value="${errorMessage}" /></span>
    </div>

    <div class="split">
        <div class="col-main">
            <div class="tabs" role="tablist">
                <button type="button" role="tab" aria-selected="true" data-tab="profile">Hồ sơ</button>
                <button type="button" role="tab" aria-selected="false" data-tab="password">Mật khẩu</button>
                <button type="button" role="tab" aria-selected="false" data-tab="dependents">Hồ sơ phụ thuộc</button>
            </div>

            <%-- ===== TAB 1: HỒ SƠ ===== --%>
            <div data-tab-panel="profile">
                <section class="panel">
                    <form id="profileForm"
                          action="${pageContext.request.contextPath}/account/update-profile"
                          method="post"
                          class="stack"
                          novalidate
                          data-validate
                          data-unsaved-warning>

                        <div class="form-grid">
                            <label class="field <c:if test='${not empty fieldErrors.email}'>bad</c:if>">
                                <span class="field-label">Email <span class="req">*</span></span>
                                <input class="input" type="email" id="acctEmail" name="email"
                                       value="<c:out value='${userEmail}' />" maxlength="100"
                                       data-rule="email" data-label="Email" autocomplete="email" required>
                                <span class="field-hint"><i class="fa-solid fa-circle-info"></i><span>Mã xác thực gửi tới email mới.</span></span>
                                <span class="field-error"><c:out value="${fieldErrors.email}" /></span>
                            </label>

                            <label class="field <c:if test='${not empty fieldErrors.phone}'>bad</c:if>">
                                <span class="field-label">Số điện thoại <span class="req">*</span></span>
                                <input class="input" type="tel" id="acctPhone" name="phone"
                                       value="<c:out value='${userPhone}' />" maxlength="10" inputmode="numeric"
                                       data-rule="phone" data-label="Số điện thoại" autocomplete="tel" required>
                                <span class="field-error"><c:out value="${fieldErrors.phone}" /></span>
                            </label>

                            <label class="field">
                                <span class="field-label">Ngày sinh</span>
                                <input class="input" type="date" id="acctDob"
                                       value="${dateOfBirth}" readonly disabled>
                                <span class="field-hint"><i class="fa-solid fa-circle-info"></i><span>Ngày sinh chỉ được cập nhật tại quầy Lễ tân.</span></span>
                            </label>
                        </div>

                        <div class="form-actions">
                            <button class="btn btn-primary" type="submit" id="saveProfileBtn">Lưu thay đổi</button>
                        </div>
                    </form>
                </section>

                <%-- Bước xác thực khi đổi Email/SĐT (mã 6 số, hiệu lực 15 phút) --%>
                <section class="panel" id="verifyPanel" style="margin-top:var(--space-5)" <c:if test="${empty requireVerification}">hidden</c:if>>
                    <div class="panel-head"><h2>Xác thực thay đổi</h2></div>
                    <div class="msg-banner success">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Mã đã gửi tới <b id="verifyTarget"><c:out value="${verifyTarget}" /></b>.</span>
                    </div>
                    <form id="verifyForm"
                          action="${pageContext.request.contextPath}/account/verify-change"
                          method="post" class="stack" novalidate data-validate>
                        <div class="label-row">
                            <label class="field <c:if test='${not empty fieldErrors.code}'>bad</c:if>">
                                <span class="field-label">Mã xác thực (6 chữ số) <span class="req">*</span></span>
                                <input class="input otp-input" type="text" id="verifyCode" name="verificationCode"
                                       maxlength="6" inputmode="numeric" data-rule="verificationCode"
                                       data-label="Mã xác thực" placeholder="––––––" required>
                                <span class="field-error"><c:out value="${fieldErrors.code}" /></span>
                            </label>
                            <button type="button" id="resendCodeBtn" class="btn btn-sm btn-link" disabled data-resend-countdown="60">
                                Gửi lại mã (<span id="resendTimer">60</span>s)
                            </button>
                        </div>
                        <span class="field-hint">Mã có hiệu lực trong <strong id="codeExpirationTimer" data-countdown-seconds="900">15:00</strong></span>
                        <button class="btn btn-primary" type="submit">Xác nhận</button>
                    </form>
                </section>
            </div>

            <%-- ===== TAB 2: MẬT KHẨU ===== --%>
            <div data-tab-panel="password" hidden>
                <section class="panel">
                    <div class="panel-head"><h2>Đổi mật khẩu</h2><span class="muted">Đổi xong sẽ đăng xuất mọi phiên</span></div>
                    <form id="passwordForm"
                          action="${pageContext.request.contextPath}/account/change-password"
                          method="post" class="stack" novalidate data-validate data-unsaved-warning>

                        <label class="field <c:if test='${not empty fieldErrors.oldPassword}'>bad</c:if>">
                            <span class="field-label">Mật khẩu hiện tại <span class="req">*</span></span>
                            <span class="input-wrap">
                                <input class="input" type="password" id="oldPass" name="oldPassword"
                                       autocomplete="current-password" data-label="Mật khẩu hiện tại" required>
                                <button type="button" class="pw-toggle" data-pw-toggle="oldPass" aria-label="Hiện/Ẩn mật khẩu">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </span>
                            <span class="field-error"><c:out value="${fieldErrors.oldPassword}" /></span>
                        </label>

                        <div class="form-grid">
                            <label class="field <c:if test='${not empty fieldErrors.newPassword}'>bad</c:if>">
                                <span class="field-label">Mật khẩu mới <span class="req">*</span></span>
                                <span class="input-wrap">
                                    <input class="input" type="password" id="newPass" name="newPassword"
                                           placeholder="8-64 ký tự, có chữ và số" autocomplete="new-password"
                                           data-rule="password" data-label="Mật khẩu mới" required>
                                    <button type="button" class="pw-toggle" data-pw-toggle="newPass" aria-label="Hiện/Ẩn mật khẩu">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </span>
                                <span class="field-error"><c:out value="${fieldErrors.newPassword}" /></span>
                            </label>

                            <label class="field <c:if test='${not empty fieldErrors.confirmPassword}'>bad</c:if>">
                                <span class="field-label">Nhập lại mật khẩu mới <span class="req">*</span></span>
                                <input class="input" type="password" id="newPass2" name="confirmPassword"
                                       autocomplete="new-password" data-match="newPass"
                                       data-label="Nhập lại mật khẩu mới" required>
                                <span class="field-error"><c:out value="${fieldErrors.confirmPassword}" /></span>
                            </label>
                        </div>

                        <div class="form-actions">
                            <button class="btn btn-primary" type="submit">Đổi mật khẩu</button>
                        </div>
                    </form>
                </section>
            </div>

            <%-- ===== TAB 3: HỒ SƠ PHỤ THUỘC (tách riêng file, xem tab-dependents.jspf) ===== --%>
            <div data-tab-panel="dependents" hidden>
                <%@ include file="tab-dependents.jspf" %>
            </div>
        </div>

        <%-- ===== CỘT PHỤ: THÔNG TIN TÀI KHOẢN, CHỈ LỄ TÂN MỚI SỬA ĐƯỢC ===== --%>
        <aside class="col-side">
            <div class="side-card">
                <div class="avatar-row">
                    <span class="avatar-lg"><c:out value="${fn:substring(fullName, 0, 1)}" default="H" /></span>
                    <div>
                        <h3><c:out value="${fullName}" /></h3>
                        <p class="muted">
                            <c:out value="${customerCode}" /> · từ <c:out value="${gms:formatDate(joinedAt)}" />
                        </p>
                    </div>
                </div>
                <button class="btn btn-ghost btn-sm btn-block" type="button" style="margin-top:var(--space-4)">Đổi ảnh đại diện</button>
            </div>

            <div class="side-card">
                <span class="section-label">Lễ tân cập nhật</span>
                <div class="side-row"><span>Họ và tên</span><b><c:out value="${fullName}" /></b></div>
                <div class="side-row">
                    <span>Ảnh check-in</span>
                    <b><c:out value="${gms:formatDate(checkInPhotoUpdatedAt)}" default="—" /></b>
                </div>
                <div class="side-row">
                    <span>Người giám hộ</span>
                    <b><c:out value="${guardianName}" default="—" /></b>
                </div>
                <p class="muted" style="margin-top:var(--space-3)">Cần sửa thì liên hệ quầy.</p>
            </div>
        </aside>
    </div>
</div>
