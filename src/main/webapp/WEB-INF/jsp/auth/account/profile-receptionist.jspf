<%--
  profile-receptionist.jspf — Cài đặt tài khoản Lễ tân.
  Khớp đặc tả Hoang_Receptionist_Account_Settings.md và contract AccountSettingsServlet của Vũ:
  - Sửa Avatar: action=updateAvatar, field avatarFile (JPG/PNG <= 2MB, CBR-110, DBR-65, MSG58).
  - Đổi Email: action=requestEmailChange, field newEmail (DBR-18, DBR-64, MSG55).
  - Đổi Số điện thoại: action=requestPhoneChange, field newPhone (DBR-17, DBR-27, DBR-30).
  - Xác nhận mã OTP: action=verifyContactChange, fields: contactField, verificationEmail, pendingContactValue, verificationCode (CBR-110, DBR-03, MSG56, MSG57).
  - Nút hủy: GET về /account?tab=profile (không cần action cancelVerification).
  - Chỉ xem (CBR-108, MSG60 — do Quản lý cập nhật): Họ tên, Ngày sinh, Mã NV, Vị trí, Ngày vào làm, Trạng thái làm việc.
  - Không có: Chuyên môn, Kinh nghiệm, Hoa hồng (chỉ dành cho PT).
  - Không có: Tab hoặc trường sửa role / trạng thái tài khoản (CBR-109).
  - Dữ liệu: accountSettings (AccountSettingsView) do AccountSettingsServlet set.
--%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="gms" uri="/WEB-INF/gms-functions.tld" %>

<c:set var="userInitial" value="LT" />
<c:if test="${not empty accountSettings.fullName}">
  <c:set var="userInitial" value="${accountSettings.fullName.substring(0, 1)}" />
</c:if>

<section class="account-card account-profile-card">
  <div class="account-card-body">

    <%-- Avatar section: theo prototype & account-settings.js --%>
    <div class="account-avatar-section">
      <div class="account-avatar-preview">
        <c:choose>
          <c:when test="${not empty accountSettings.avatar}">
            <img id="avatarPreview"
                 class="account-avatar-image"
                 src="${pageContext.request.contextPath}${accountSettings.avatar}"
                 alt="Ảnh đại diện">
            <div id="avatarFallback" class="account-avatar-fallback is-hidden">
              <c:out value="${userInitial}" />
            </div>
          </c:when>
          <c:otherwise>
            <img id="avatarPreview"
                 class="account-avatar-image is-hidden"
                 src=""
                 alt="Ảnh đại diện">
            <div id="avatarFallback" class="account-avatar-fallback">
              <c:out value="${userInitial}" />
            </div>
          </c:otherwise>
        </c:choose>
      </div>

      <div class="account-avatar-info">
        <strong><c:out value="${accountSettings.fullName}" /></strong>
        <span>Ảnh đại diện tài khoản</span>
      </div>

      <form id="avatarForm"
            method="post"
            action="${pageContext.request.contextPath}/account"
            enctype="multipart/form-data"
            class="account-avatar-form">
        <input type="hidden" name="action" value="updateAvatar">
        <input id="avatarFile"
               name="avatarFile"
               type="file"
               accept="image/jpeg,image/png"
               class="account-avatar-input">
        <label for="avatarFile" class="btn">Chọn ảnh</label>
        <button type="submit" class="btn btn-primary">Cập nhật ảnh</button>
      </form>
      <c:if test="${not empty avatarError}">
        <span class="field-error">
          <c:out value="${avatarError}" />
        </span>
      </c:if>
    </div>

    <h2>Hồ sơ</h2>
    <p class="account-subtitle">
      Thông tin cá nhân và tài khoản Lễ tân.
    </p>

    <c:choose>
      <%-- ===== BƯỚC XÁC THỰC MÃ 6 SỐ KHI ĐỔI EMAIL / SĐT (contract Servlet) ===== --%>
      <c:when test="${not empty contactVerificationPending or not empty requireVerification}">
        <div class="msg-banner info" role="status">
          <i class="fa-solid fa-circle-info"></i>
          <div>
            <b>Nhập mã xác thực</b>
            <p>
              Mã 6 chữ số đã được gửi tới <b><c:out value="${verificationEmail}" /></b> để xác nhận thay đổi
              <c:choose>
                <c:when test="${contactField eq 'EMAIL'}">email thành <b><c:out value="${pendingContactValue}" /></b></c:when>
                <c:otherwise>số điện thoại thành <b><c:out value="${pendingContactValue}" /></b></c:otherwise>
              </c:choose>.
              Mã có hiệu lực trong 15 phút.
            </p>
          </div>
        </div>

        <form id="verifyContactForm"
              method="post"
              action="${pageContext.request.contextPath}/account"
              class="stack"
              novalidate
              data-validate>
          <input type="hidden" name="action" value="verifyContactChange">
          <input type="hidden" name="contactField" value="<c:out value='${contactField}' />">
          <input type="hidden" name="verificationEmail" value="<c:out value='${verificationEmail}' />">
          <input type="hidden" name="pendingContactValue" value="<c:out value='${pendingContactValue}' />">

          <div class="field">
            <label class="field-label" for="verificationCode">
              Mã xác thực (6 chữ số) <span class="req">*</span>
            </label>
            <input id="verificationCode"
                   name="verificationCode"
                   class="input"
                   type="text"
                   maxlength="6"
                   inputmode="numeric"
                   data-rule="verificationCode"
                   data-label="Mã xác thực"
                   placeholder="––––––"
                   required>
            <c:if test="${not empty errors.code or not empty errors.verificationCode}">
              <span class="field-error" id="verificationCodeError">
                <c:out value="${not empty errors.code ? errors.code : errors.verificationCode}" />
              </span>
            </c:if>
          </div>
        </form>
      </c:when>

      <%-- ===== MÀN HÌNH HỒ SƠ BÌNH THƯỜNG (khi chưa bấm đổi thông tin) ===== --%>
      <c:otherwise>
        <div class="account-form-grid">
          <%-- ===== TRƯỜNG CHỈ XEM (CBR-108, MSG60 — do Quản lý cập nhật) ===== --%>

          <%-- Họ và tên --%>
          <div class="field account-field-full">
            <label class="field-label" for="profileFullName">Họ và tên</label>
            <input id="profileFullName"
                   type="text"
                   value="<c:out value='${accountSettings.fullName}' />"
                   readonly>
            <span class="field-hint">Thông tin do Quản lý cập nhật.</span>
          </div>

          <%-- Ngày sinh --%>
          <div class="field">
            <label class="field-label" for="profileDob">Ngày sinh</label>
            <input id="profileDob"
                   type="text"
                   value="<c:out value='${gms:formatDate(accountSettings.dateOfBirth)}' />"
                   readonly>
            <span class="field-hint">Thông tin do Quản lý cập nhật.</span>
          </div>

          <%-- Mã nhân viên --%>
          <div class="field">
            <label class="field-label" for="profileEmployeeCode">Mã nhân viên</label>
            <input id="profileEmployeeCode"
                   type="text"
                   value="<c:out value='${accountSettings.employeeCode}' />"
                   readonly>
            <span class="field-hint">Mã nhân viên do hệ thống sinh, không thể thay đổi.</span>
          </div>

          <%-- Vị trí --%>
          <div class="field">
            <label class="field-label" for="profilePosition">Vị trí</label>
            <input id="profilePosition"
                   type="text"
                   value="<c:out value='${not empty position ? position : (not empty currentRole.displayName ? currentRole.displayName : \"Lễ tân\")}' />"
                   readonly>
            <span class="field-hint">Thông tin do Quản lý cập nhật.</span>
          </div>

          <%-- Ngày vào làm --%>
          <div class="field">
            <label class="field-label" for="profileHireDate">Ngày vào làm</label>
            <input id="profileHireDate"
                   type="text"
                   value="<c:choose><c:when test='${not empty accountSettings.hireDate}'><c:out value='${gms:formatDate(accountSettings.hireDate)}' /></c:when><c:when test='${not empty hireDate}'><c:out value='${gms:formatDate(hireDate)}' /></c:when><c:otherwise>—</c:otherwise></c:choose>"
                   readonly>
            <span class="field-hint">Thông tin do Quản lý cập nhật.</span>
          </div>

          <%-- Trạng thái làm việc --%>
          <div class="field account-field-full">
            <label class="field-label" for="profileWorkStatus">Trạng thái làm việc</label>
            <input id="profileWorkStatus"
                   type="text"
                   value="<c:choose><c:when test='${not empty accountSettings.employmentStatus.dbValue}'><c:out value='${accountSettings.employmentStatus.dbValue}' /></c:when><c:when test='${not empty accountSettings.employmentStatus}'><c:out value='${accountSettings.employmentStatus}' /></c:when><c:when test='${not empty employmentStatus}'><c:out value='${employmentStatus}' /></c:when><c:when test='${not empty status}'><c:out value='${status}' /></c:when><c:when test='${not empty accountSettings.status}'><c:out value='${accountSettings.status}' /></c:when><c:otherwise>Đang làm việc</c:otherwise></c:choose>"
                   readonly>
            <span class="field-hint">Thông tin do Quản lý cập nhật.</span>
          </div>

          <%-- ===== TRƯỜNG SỬA ĐƯỢC (contract: requestEmailChange, requestPhoneChange) ===== --%>

          <%-- Form đổi Email: action=requestEmailChange, field newEmail --%>
          <form id="emailForm"
                method="post"
                action="${pageContext.request.contextPath}/account"
                class="field"
                novalidate
                data-validate
                data-unsaved-warning>
            <input type="hidden" name="action" value="requestEmailChange">

            <label class="field-label" for="profileEmail">
              Email đăng nhập <span class="req">*</span>
            </label>
            <input id="profileEmail"
                   name="newEmail"
                   type="email"
                   maxlength="100"
                   data-rule="email"
                   data-label="Email mới"
                   value="<c:out value='${not empty pendingContactValue and contactField eq \"EMAIL\" ? pendingContactValue : accountSettings.email}' />"
                   required>
            <span class="field-hint">
              Đổi email cần mã OTP gửi tới email mới. Đổi xong sẽ đăng xuất mọi phiên.
            </span>
            <c:if test="${not empty errors.newEmail or not empty errors.email}">
              <span class="field-error" id="profileEmailError">
                <c:out value="${not empty errors.newEmail ? errors.newEmail : errors.email}" />
              </span>
            </c:if>
          </form>

          <%-- Form đổi SĐT: action=requestPhoneChange, field newPhone --%>
          <form id="phoneForm"
                method="post"
                action="${pageContext.request.contextPath}/account"
                class="field"
                novalidate
                data-validate
                data-unsaved-warning>
            <input type="hidden" name="action" value="requestPhoneChange">

            <label class="field-label" for="profilePhone">
              Số điện thoại <span class="req">*</span>
            </label>
            <input id="profilePhone"
                   name="newPhone"
                   type="tel"
                   maxlength="10"
                   inputmode="numeric"
                   data-rule="phone"
                   data-label="Số điện thoại mới"
                   value="<c:out value='${not empty pendingContactValue and contactField eq \"PHONE\" ? pendingContactValue : accountSettings.phone}' />"
                   required>
            <span class="field-hint">
              Đổi số điện thoại cần mã OTP gửi tới email hiện tại.
            </span>
            <c:if test="${not empty errors.newPhone or not empty errors.phone}">
              <span class="field-error" id="profilePhoneError">
                <c:out value="${not empty errors.newPhone ? errors.newPhone : errors.phone}" />
              </span>
            </c:if>
          </form>
        </div>
      </c:otherwise>
    </c:choose>

  </div>

  <div class="account-form-actions">
    <c:choose>
      <c:when test="${not empty contactVerificationPending or not empty requireVerification}">
        <a href="${pageContext.request.contextPath}/account?tab=profile" class="btn">
          Hủy
        </a>
        <button class="btn btn-primary" type="submit" form="verifyContactForm">
          Xác nhận mã
        </button>
      </c:when>
      <c:otherwise>
        <button class="btn btn-primary" type="submit" form="emailForm">
          Đổi email
        </button>
        <button class="btn btn-primary" type="submit" form="phoneForm">
          Đổi số điện thoại
        </button>
      </c:otherwise>
    </c:choose>
  </div>
</section>
