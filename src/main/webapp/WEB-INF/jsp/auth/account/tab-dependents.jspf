<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<section class="account-card">
    <div class="account-card-body">
        <div class="title-hint-row">
            <h2>Hồ sơ phụ thuộc</h2>
            <span class="pt-info"><button type="button" class="pt-info-trigger" aria-label="Về hồ sơ phụ thuộc" aria-describedby="dependents-help"><span aria-hidden="true">i</span></button><span id="dependents-help" class="pt-info-popover" role="tooltip">Danh sách hồ sơ trẻ em mà bạn là người giám hộ. Mọi thay đổi về hồ sơ con vui lòng liên hệ quầy Lễ tân.</span></span>
        </div>
    </div>

    <c:choose>
        <c:when test="${not empty dependents}">
            <ul class="dep-list">
                <c:forEach var="dep" items="${dependents}">
                    <li class="dep-item">
                        <div class="dep-avatar">
                            <c:choose>
                                <c:when test="${not empty dep.fullName}">
                                    <c:out value="${dep.fullName.substring(0, 1)}" />
                                </c:when>
                                <c:otherwise>?</c:otherwise>
                            </c:choose>
                        </div>
                        <div class="dep-info">
                            <div class="dep-name">
                                <c:out value="${dep.fullName}" />
                                <c:if test="${dep.underTen}">
                                    <span class="dep-badge">Dưới 10 tuổi · Không đặt PT</span>
                                </c:if>
                            </div>
                            <div class="dep-meta">
                                <span>
                                    <i class="fa-solid fa-id-card"></i>
                                    <c:out value="${dep.customerCode}" default="—" />
                                </span>
                                <span>
                                    <i class="fa-solid fa-cake-candles"></i>
                                    <c:out value="${dep.ageLabel}" default="—" />
                                </span>
                                <c:choose>
                                    <c:when test="${not empty dep.activePackageLabel}">
                                        <span class="dep-pkg dep-pkg--active">
                                            <i class="fa-solid fa-dumbbell"></i>
                                            <c:out value="${dep.activePackageLabel}" />
                                        </span>
                                    </c:when>
                                    <c:otherwise>
                                        <span class="dep-pkg dep-pkg--none">
                                            <i class="fa-solid fa-dumbbell"></i>
                                            Chưa có gói hiệu lực
                                        </span>
                                    </c:otherwise>
                                </c:choose>
                            </div>
                        </div>
                    </li>
                </c:forEach>
            </ul>
        </c:when>
        <c:otherwise>
            <div class="dep-empty">
                <i class="fa-solid fa-user-group dep-empty-icon"></i>
                <p>Bạn chưa có hồ sơ phụ thuộc nào.</p>
                <p class="account-subtitle" style="margin-bottom: 0;">Đăng ký hồ sơ phụ thuộc (con dưới 18 tuổi) tại quầy Lễ tân.</p>
            </div>
        </c:otherwise>
    </c:choose>
</section>
