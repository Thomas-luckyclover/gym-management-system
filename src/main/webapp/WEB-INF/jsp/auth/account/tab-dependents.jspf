<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<section class="panel">
    <div class="panel-head"><h2>Hồ sơ phụ thuộc</h2></div>

    <c:choose>
        <c:when test="${not empty dependents}">
            <div class="data-list">
                <c:forEach var="dep" items="${dependents}">
                    <div class="data-row">
                        <div class="row-main">
                            <div class="row-title">
                                <c:out value="${dep.fullName}" />
                                <span class="badge badge-muted"><c:out value="${dep.ageLabel}" /></span>
                            </div>
                            <div class="row-meta">
                                <span><i class="fa-solid fa-id-card"></i> <c:out value="${dep.customerCode}" /></span>
                                <c:if test="${not empty dep.activePackageLabel}">
                                    <span><i class="fa-solid fa-dumbbell"></i> <c:out value="${dep.activePackageLabel}" /></span>
                                </c:if>
                                <c:if test="${empty dep.activePackageLabel}">
                                    <span class="muted"><i class="fa-solid fa-dumbbell"></i> Chưa có gói hiệu lực</span>
                                </c:if>
                            </div>
                        </div>
                    </div>
                </c:forEach>
            </div>
            <p class="muted">Dưới 10 tuổi không đặt được buổi PT. Mọi thay đổi về lịch liên hệ trực tiếp PT phụ trách.</p>
        </c:when>
        <c:otherwise>
            <div class="empty-state">
                <i class="fa-solid fa-user-group"></i>
                <p>Bạn chưa có hồ sơ phụ thuộc nào.</p>
                <p class="muted">Đăng ký hồ sơ phụ thuộc (con dưới 18 tuổi) tại quầy Lễ tân.</p>
            </div>
        </c:otherwise>
    </c:choose>
</section>
