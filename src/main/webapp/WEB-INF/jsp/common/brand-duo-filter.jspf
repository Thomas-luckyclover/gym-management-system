<%-- Bộ lọc duotone thương hiệu (bóng tối → đại dương sâu, vùng sáng → cam hoàng hôn), cùng bảng màu với ảnh
     đã chỉnh sẵn trong images/brand. Dùng cho ảnh không chỉnh sẵn (ảnh bài viết lấy từ CSDL): thêm class "duo"
     vào khung bọc ảnh (css trong common.css). Đã include trong guest-footer.jspf. --%>
<svg width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false">
  <filter id="gms-duo" color-interpolation-filters="sRGB">
    <feColorMatrix type="saturate" values="0"/>
    <feComponentTransfer>
      <feFuncR type="table" tableValues="0.012 0.016 0.020 0.024 0.029 0.033 0.044 0.064 0.085 0.105 0.188 0.362 0.537 0.712 0.886 0.922 0.957 0.993 1 1 1"/>
      <feFuncG type="table" tableValues="0.071 0.104 0.138 0.171 0.205 0.239 0.277 0.322 0.367 0.412 0.432 0.414 0.396 0.379 0.361 0.437 0.513 0.589 0.698 0.816 0.933"/>
      <feFuncB type="table" tableValues="0.098 0.138 0.178 0.218 0.258 0.298 0.338 0.379 0.420 0.462 0.454 0.374 0.294 0.214 0.133 0.180 0.226 0.273 0.446 0.650 0.855"/>
    </feComponentTransfer>
  </filter>
</svg>
<style>.duo > img { filter: url(#gms-duo); } a:is(:hover, :focus-visible) .duo > img, .duo:hover > img { filter: none; }</style>
