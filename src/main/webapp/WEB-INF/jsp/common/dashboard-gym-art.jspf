<%@ page pageEncoding="UTF-8" %>
<%-- Phòng gym comic (tranh mực đen trắng, chỉ váy và giày cao gót đỏ). Nguồn: ảnh nhóm tạo bằng Gemini 15/10/2026,
     ghép bằng script: ảnh nền đã xóa người nâng tạ + 2 tư thế cô gái (giữ tạ trước vai / khóa tay qua đầu) tách nền,
     đặt đúng chỗ cũ bằng token --comic-lifter-*. Vòng lặp 8 giây trong dashboard-comic.css: đổi tư thế kiểu limited
     animation, bong bóng kẹo phồng xẹp, đèn chập chờn, bụi phấn trôi. Hoàn toàn trang trí (khung chứa aria-hidden). --%>
<div class="comic-photo comic-gym">
    <img class="comic-photo__plate" src="${pageContext.request.contextPath}/images/comic/gym-plate.webp" alt="" width="2400" height="837" decoding="async">
    <span class="comic-lamp comic-lamp--a"></span><span class="comic-lamp comic-lamp--b"></span><span class="comic-lamp comic-lamp--c"></span>
    <img class="comic-lifter comic-lifter--rack" src="${pageContext.request.contextPath}/images/comic/gym-lifter-rack.webp" alt="" decoding="async">
    <img class="comic-lifter comic-lifter--up" src="${pageContext.request.contextPath}/images/comic/gym-lifter-up.webp" alt="" decoding="async">
    <span class="comic-gum"></span>
    <span class="comic-dust"></span>
</div>
