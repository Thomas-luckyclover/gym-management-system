<%@ page pageEncoding="UTF-8" %>
<%-- ===== Khối chào + thời tiết (PT Dashboard, Customer Dashboard) =====
     Biến request: weather (WeatherView, có thể null khi API lỗi), weatherType (sunny/cloudy/rain/storm/snow/wind/night/hot),
     weatherPreview (đang xem thử ?weather=), weatherGreetingName (tên), weatherAudience ("customer" | "pt").
     Lời chào + phòng tập chuyển động; thời tiết thật có hiệu ứng riêng trong thẻ, có nút tạm dừng. --%>
<section class="wx-hero ${empty weather ? 'is-weather-unavailable' : ''}" aria-labelledby="welcome-title" data-reveal>
    <div class="wx-greet">
        <h2 id="welcome-title">Chào, <span class="wx-name"><c:out value="${weatherGreetingName}" default="bạn" /></span></h2>

        <%-- Phòng tập trang trí: gym-floor.js vẽ từng người; nút điều khiển nằm ngoài aria-hidden. --%>
        <div class="wx-gym-panel">
            <button class="dashboard-motion-toggle" type="button" data-dashboard-motion-toggle aria-pressed="false" aria-label="Tạm dừng hiệu ứng">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"></path></svg>
                <span>Tạm dừng hiệu ứng</span>
            </button>
            <div class="wx-gym" aria-hidden="true" data-gym>
                <div class="wx-gym__sky"></div>
                <div class="wx-gym__window"></div>
                <div class="wx-gym__wall">
                    <svg class="wx-gym__rack" viewBox="0 0 400 60" preserveAspectRatio="xMidYMax meet">
                        <rect class="rack-frame" x="8" y="30" width="196" height="5"></rect>
                        <rect class="rack-frame" x="8" y="48" width="196" height="5"></rect>
                        <rect class="rack-frame" x="10" y="30" width="5" height="30"></rect>
                        <rect class="rack-frame" x="197" y="30" width="5" height="30"></rect>
                        <c:forEach var="bellIndex" begin="0" end="7">
                            <g transform="translate(${20 + bellIndex * 23} 22)"><rect class="rack-bell" x="0" y="0" width="6" height="8"></rect><rect class="rack-bar" x="6" y="3" width="8" height="2"></rect><rect class="rack-bell" x="14" y="0" width="6" height="8"></rect></g>
                            <g transform="translate(${21 + bellIndex * 23} 40)"><rect class="rack-bell" x="0" y="0" width="5" height="7"></rect><rect class="rack-bar" x="5" y="2.5" width="8" height="2"></rect><rect class="rack-bell" x="13" y="0" width="5" height="7"></rect></g>
                        </c:forEach>
                        <rect class="rack-frame" x="300" y="14" width="4" height="46"></rect>
                        <rect class="rack-frame" x="288" y="56" width="28" height="4"></rect>
                        <circle class="rack-plate" cx="302" cy="24" r="12"></circle>
                        <circle class="rack-plate" cx="302" cy="44" r="15"></circle>
                        <rect class="rack-frame" x="352" y="0" width="5" height="60"></rect>
                        <rect class="rack-frame" x="392" y="0" width="5" height="60"></rect>
                        <rect class="rack-frame" x="352" y="4" width="45" height="4"></rect>
                    </svg>
                </div>
                <div class="wx-gym__floor"></div>
                <div class="wx-gym__crew">
                    <div class="wx-athlete wx-athlete--squat" data-athlete="squat" data-hair="ponytail"><svg viewBox="0 0 120 130"></svg><span class="wx-athlete__rep"></span></div>
                    <div class="wx-athlete wx-athlete--swing" data-athlete="swing" data-hair="buzz"><svg viewBox="0 0 120 130"></svg><span class="wx-athlete__rep"></span></div>
                    <div class="wx-athlete wx-athlete--press" data-athlete="press" data-hair="bun"><svg viewBox="0 0 120 130"></svg><span class="wx-athlete__rep"></span></div>
                    <div class="wx-athlete wx-athlete--ropes" data-athlete="ropes" data-hair="cap"><svg viewBox="0 0 170 130"></svg><span class="wx-athlete__rep"></span></div>
                </div>
            </div>
        </div>
    </div>

    <c:if test="${not empty weather}">
        <div class="wx-card" data-tilt aria-label="Thời tiết hôm nay tại phòng gym">
            <div class="wx-card__fx" aria-hidden="true"><canvas class="wx-card__canvas"></canvas></div>
            <div class="wx-card__top">
                <div>
                    <p class="wx-card__place">
                        <c:out value="${weather.cityName}" />
                        <c:if test="${weatherPreview}"><span class="wx-card__preview">Xem trước</span></c:if>
                    </p>
                    <p class="wx-card__condition"><c:out value="${weather.conditionLabel}" /></p>
                </div>
                <%-- Icon động theo weatherType (giá trị cố định từ enum WeatherView.Mood) --%>
                <span class="wx-icon wx-icon--${weatherType}" aria-hidden="true">
                    <svg viewBox="0 0 64 64">
                        <g class="wx-icon__sun"><circle cx="32" cy="32" r="11"></circle><g class="wx-icon__rays"><line x1="32" y1="6" x2="32" y2="13"></line><line x1="32" y1="51" x2="32" y2="58"></line><line x1="6" y1="32" x2="13" y2="32"></line><line x1="51" y1="32" x2="58" y2="32"></line><line x1="13.6" y1="13.6" x2="18.5" y2="18.5"></line><line x1="45.5" y1="45.5" x2="50.4" y2="50.4"></line><line x1="13.6" y1="50.4" x2="18.5" y2="45.5"></line><line x1="45.5" y1="18.5" x2="50.4" y2="13.6"></line></g></g>
                        <g class="wx-icon__moon"><path d="M40 12a20 20 0 1 0 12 30A16 16 0 0 1 40 12z"></path><circle class="wx-icon__star" cx="16" cy="16" r="1.6"></circle><circle class="wx-icon__star" cx="10" cy="30" r="1.2"></circle></g>
                        <path class="wx-icon__cloud" d="M18 44h28a10 10 0 0 0 0-20 14 14 0 0 0-27-3A11 11 0 0 0 18 44z"></path>
                        <g class="wx-icon__rain"><line x1="24" y1="49" x2="21" y2="57"></line><line x1="33" y1="49" x2="30" y2="57"></line><line x1="42" y1="49" x2="39" y2="57"></line></g>
                        <path class="wx-icon__bolt" d="M34 44l-7 11h6l-3 8 9-12h-6l3-7z"></path>
                        <g class="wx-icon__snow"><circle cx="24" cy="53" r="2"></circle><circle cx="33" cy="57" r="2"></circle><circle cx="42" cy="53" r="2"></circle></g>
                        <g class="wx-icon__wind"><path d="M8 24h30a6 6 0 1 0-6-6"></path><path d="M8 34h42a6 6 0 1 1-6 6"></path><path d="M8 44h22"></path></g>
                        <g class="wx-icon__heat"><path d="M14 54c3-3 6 3 9 0s6 3 9 0 6 3 9 0 6 3 9 0"></path></g>
                    </svg>
                </span>
            </div>

            <%-- Giá trị thật hiện nguyên vẹn; không đếm từ 0 khi mở bảng điều hành. --%>
            <strong class="wx-card__temp" aria-label="${weather.temperature} độ C"><c:out value="${weather.temperature}" />°</strong>

            <details class="wx-card__more">
                <summary>Chi tiết thời tiết</summary>
                <c:if test="${weather.feelsLikeTemperature != null}">
                    <dl class="wx-card__details">
                        <div><dt>Cảm giác</dt><dd><c:out value="${weather.feelsLikeTemperature}" />°</dd></div>
                        <div><dt>Thấp / cao</dt><dd><c:out value="${weather.minTemperature}" />° / <c:out value="${weather.maxTemperature}" />°</dd></div>
                        <div><dt>Độ ẩm</dt><dd><c:out value="${weather.humidityPercent}" />%</dd></div>
                        <div><dt>Gió</dt><dd><c:out value="${weather.windSpeedKmh}" /> km/h</dd></div>
                        <div><dt>Khả năng mưa</dt><dd><c:out value="${weather.rainProbabilityPercent}" />%</dd></div>
                    </dl>
                </c:if>

                <%-- Chỉ đổi câu chữ theo người đọc; dùng nguyên trạng thái thời tiết từ Service. --%>
                <p class="wx-card__advice">
                    <c:choose>
                        <c:when test="${weatherAudience eq 'customer'}">
                            <c:choose>
                                <c:when test="${weatherType eq 'rain'}">Mang theo ô hoặc áo mưa, cẩn thận sàn trơn khi đến phòng tập nhé.</c:when>
                                <c:when test="${weatherType eq 'storm'}">Có giông bão, hãy ưu tiên an toàn và theo dõi thời tiết trước khi đến phòng tập.</c:when>
                                <c:when test="${weatherType eq 'hot'}">Trời nóng, nhớ mang nước và dành thời gian nghỉ giữa các hiệp tập nhé.</c:when>
                                <c:when test="${weatherType eq 'sunny'}">Trời nắng, nhớ mang nước và tránh nắng trên đường đến phòng tập nhé.</c:when>
                                <c:when test="${weatherType eq 'wind'}">Gió mạnh, chú ý an toàn trên đường đến phòng tập nhé.</c:when>
                                <c:when test="${weatherType eq 'snow'}">Trời lạnh, mặc đủ ấm và khởi động kỹ trước khi tập nhé.</c:when>
                                <c:when test="${weatherType eq 'night'}">Tập vừa sức và dành thời gian nghỉ ngơi sau buổi tập tối nhé.</c:when>
                                <c:otherwise>Thời tiết dễ chịu, chúc bạn có một buổi tập thật tốt.</c:otherwise>
                            </c:choose>
                        </c:when>
                        <c:otherwise><c:out value="${weather.advice}" /></c:otherwise>
                    </c:choose>
                </p>
            </details>
        </div>
    </c:if>

    <%-- Dịch vụ thời tiết tạm lỗi (Service trả null): vẫn giữ thẻ để bố cục không vỡ, nói rõ khi nào có lại --%>
    <c:if test="${empty weather}">
        <div class="wx-card wx-card--offline" role="status">
            <div class="wx-card__top">
                <div>
                    <p class="wx-card__place">Thời tiết hôm nay</p>
                    <p class="wx-card__condition">Chưa cập nhật được</p>
                </div>
                <span class="wx-icon wx-icon--cloudy" aria-hidden="true">
                    <svg viewBox="0 0 64 64"><path class="wx-icon__cloud" d="M18 44h28a10 10 0 0 0 0-20 14 14 0 0 0-27-3A11 11 0 0 0 18 44z"></path></svg>
                </span>
            </div>
            <strong class="wx-card__temp">--°</strong>
            <p class="wx-card__advice">Nguồn dữ liệu thời tiết đang bận. Trang sẽ tự lấy lại sau ít phút, bạn cứ dùng các mục bên dưới bình thường.</p>
        </div>
    </c:if>
</section>

<script src="${pageContext.request.contextPath}/js/gym-floor.js?v=20261013c" defer></script>
<script src="${pageContext.request.contextPath}/js/weather-card.js?v=20261013g" defer></script>
