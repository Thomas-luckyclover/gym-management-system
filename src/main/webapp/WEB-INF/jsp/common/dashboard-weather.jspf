<%@ page pageEncoding="UTF-8" %>
<%-- ===== Khối chào + thời tiết (PT Dashboard, Customer Dashboard) =====
     Biến request: weather (WeatherView, có thể null khi API lỗi), weatherType (sunny/cloudy/rain/storm/snow/wind/night/hot),
     weatherPreview (đang xem thử ?weather=), weatherGreetingName (tên), weatherAudience ("customer" | "pt").
     Bên trái: lời chào + người chạy trên đường chạy (trang trí, aria-hidden). Bên phải: thẻ thời tiết nghiêng 3D. --%>
<section class="wx-hero ${empty weather ? 'is-weather-unavailable' : ''}" aria-labelledby="welcome-title" data-reveal>
    <div class="wx-greet">
        <h2 id="welcome-title">Chào, <span class="wx-name"><c:out value="${weatherGreetingName}" default="bạn" /></span></h2>
        <p class="wx-lead">
            <c:choose>
                <c:when test="${weatherAudience eq 'customer'}">Mỗi buổi tập là thêm một đoạn đường về đích. Cùng xem hôm nay có gì nhé.</c:when>
                <c:otherwise>Lịch dạy, khách cần chú ý và hoa hồng của bạn đều ở bên dưới.</c:otherwise>
            </c:choose>
        </p>

        <%-- Đường chạy marathon: trang trí, rê chuột để cả nhóm chạy nhanh hơn --%>
        <div class="wx-run" aria-hidden="true">
            <div class="wx-run__sky"></div>
            <%-- 4 runner marathon (kiểu ekiden Nhật) ở 4 làn xa → gần; màu áo theo --doodle-1..4 --%>
            <div class="wx-runners">
                <c:forEach var="runnerIndex" begin="1" end="4">
                    <%-- Runner ekiden: khăn hachimaki, dải tasuki chéo; hông (50,70), vai (51,42). Người hơi đổ về trước 4°. --%>
                    <svg class="wx-runner wx-runner--${runnerIndex}" viewBox="0 0 100 130">
                        <ellipse class="wx-runner__shadow" cx="52" cy="125" rx="20" ry="3"></ellipse>
                        <g class="wx-runner__body">
                            <g transform="rotate(4 50 70)">
                                <g class="wx-limb wx-arm wx-arm--back"><path d="M0 0 L1 14 L12 9"></path></g>
                                <g class="wx-limb wx-leg wx-leg--back"><path d="M0 0 L0 26"></path><g class="wx-shin"><path d="M0 26 L0 49"></path><path class="wx-shoe" d="M-3 49 L8 49"></path></g></g>
                                <path class="wx-shorts" d="M43 64 L58 64 L59 76 L51 75 L50.5 71 L49.5 75 L42 76 Z"></path>
                                <path class="wx-shirt" d="M45 37 Q51.5 33 58 37 L57 66 Q51 69 44 66 Z"></path>
                                <path class="wx-sash" d="M46 38 L56.5 64"></path>
                                <rect class="wx-bib" x="47" y="46" width="8" height="6" rx="0.8"></rect>
                                <circle class="wx-head" cx="54" cy="25" r="9"></circle>
                                <path class="wx-hair" d="M45.5 23 Q46 14 55 15 Q63 16 63 23 Q57 19 51 20.5 Q47.5 21.5 45.5 23 Z"></path>
                                <path class="wx-band" d="M45.5 23.5 Q54 19.5 62.8 23.5"></path>
                                <path class="wx-band-tail" d="M46 23.5 Q41 22 37 19 M46 24 Q41 26 38 29"></path>
                                <circle class="wx-eye" cx="58.5" cy="26" r="1.1"></circle>
                                <g class="wx-limb wx-leg wx-leg--front"><path d="M0 0 L0 26"></path><g class="wx-shin"><path d="M0 26 L0 49"></path><path class="wx-shoe" d="M-3 49 L8 49"></path></g></g>
                                <g class="wx-limb wx-arm wx-arm--front"><path d="M0 0 L1 14 L12 9"></path></g>
                            </g>
                        </g>
                    </svg>
                </c:forEach>
            </div>
            <div class="wx-run__track">
                <span class="wx-run__lanes"></span>
                <span class="wx-run__marks"></span>
            </div>
        </div>
    </div>

    <c:if test="${not empty weather}">
        <div class="wx-card" data-tilt aria-label="Thời tiết hôm nay tại phòng gym">
            <%-- Lớp hiệu ứng trong thẻ (mưa/tuyết/nắng/sao theo weatherType) — nằm sâu phía sau, nghiêng thẻ thấy lệch 3D --%>
            <div class="wx-card__fx" aria-hidden="true"><c:forEach var="fxIndex" begin="0" end="15"><i style="--i: ${fxIndex}"></i></c:forEach></div>
            <div class="wx-card__top">
                <div>
                    <p class="wx-card__place">
                        <c:out value="${weather.cityName}" /> · <c:out value="${weather.title}" />
                        <c:if test="${weatherPreview}"><span class="wx-card__preview">Xem trước</span></c:if>
                    </p>
                    <p class="wx-card__condition">Hiện tại: <c:out value="${weather.conditionLabel}" /></p>
                </div>
                <%-- Icon động theo weatherType (giá trị cố định từ enum WeatherView.Mood) --%>
                <span class="wx-icon wx-icon--${weatherType}" aria-hidden="true">
                    <svg viewBox="0 0 64 64">
                        <g class="wx-icon__sun"><circle cx="32" cy="32" r="11"></circle><g class="wx-icon__rays"><line x1="32" y1="6" x2="32" y2="13"></line><line x1="32" y1="51" x2="32" y2="58"></line><line x1="6" y1="32" x2="13" y2="32"></line><line x1="51" y1="32" x2="58" y2="32"></line><line x1="13.6" y1="13.6" x2="18.5" y2="18.5"></line><line x1="45.5" y1="45.5" x2="50.4" y2="50.4"></line><line x1="13.6" y1="50.4" x2="18.5" y2="45.5"></line><line x1="45.5" y1="18.5" x2="50.4" y2="13.6"></line></g></g>
                        <g class="wx-icon__moon"><path d="M40 12a20 20 0 1 0 12 30A16 16 0 0 1 40 12z"></path><circle class="wx-icon__star" cx="16" cy="16" r="1.6"></circle><circle class="wx-icon__star" cx="10" cy="30" r="1.2"></circle></g>
                        <path class="wx-icon__cloud" d="M18 44h28a10 10 0 0 0 0-20 14 14 0 0 0-27-3A11 11 0 0 0 18 44z"></path>
                        <g class="wx-icon__rain"><line x1="24" y1="49" x2="21" y2="57"></line><line x1="33" y1="49" x2="30" y2="57"></line><line x1="42" y1="49" x2="39" y2="57"></line></g>
                        <path class="wx-icon__bolt" d="M34 44l-7 11h6l-3 8 9-12h-6l3-7z"></path>
                        <g class="wx-icon__snow"><circle cx="24" cy="53" r="2"></circle><circle cx="33" cy="57" r="2"></circle><circle cx="42" cy="53" r="2"></circle></g>
                        <g class="wx-icon__wind"><path d="M8 24h30a6 6 0 1 0-6-6"></path><path d="M8 34h42a6 6 0 1 1-6 6"></path><path d="M8 44h22"></path></g>
                        <g class="wx-icon__heat"><path d="M14 54c3-3 6 3 9 0s6 3 9 0 6 3 9 0 6 3 9 0"></path></g>
                    </svg>
                </span>
            </div>

            <%-- Giá trị thật giữ trong HTML; common.js chỉ tạo hiệu ứng đếm, tắt JS vẫn thấy nhiệt độ. --%>
            <strong class="wx-card__temp" data-weather-temperature="${weather.temperature}"><c:out value="${weather.temperature}" />°</strong>

            <c:if test="${weather.feelsLikeTemperature != null}">
                <dl class="wx-card__details">
                    <div><dt>Cảm giác</dt><dd><c:out value="${weather.feelsLikeTemperature}" />°</dd></div>
                    <div><dt>Thấp / cao</dt><dd><c:out value="${weather.minTemperature}" />° / <c:out value="${weather.maxTemperature}" />°</dd></div>
                    <div><dt>Độ ẩm</dt><dd><c:out value="${weather.humidityPercent}" />%</dd></div>
                    <div><dt>Gió</dt><dd><c:out value="${weather.windSpeedKmh}" /> km/h</dd></div>
                    <div><dt>Khả năng mưa</dt><dd><c:out value="${weather.rainProbabilityPercent}" />%</dd></div>
                </dl>
            </c:if>

            <%-- Chỉ đổi câu chữ theo người đọc; dùng nguyên trạng thái thời tiết từ Service. --%>
            <p class="wx-card__advice">
                <c:choose>
                    <c:when test="${weatherAudience eq 'customer'}">
                        <c:choose>
                            <c:when test="${weatherType eq 'rain'}">Mang theo ô hoặc áo mưa, cẩn thận sàn trơn khi đến phòng tập nhé.</c:when>
                            <c:when test="${weatherType eq 'storm'}">Có giông bão, hãy ưu tiên an toàn và theo dõi thời tiết trước khi đến phòng tập.</c:when>
                            <c:when test="${weatherType eq 'hot'}">Trời nóng, nhớ mang nước và dành thời gian nghỉ giữa các hiệp tập nhé.</c:when>
                            <c:when test="${weatherType eq 'sunny'}">Trời nắng, nhớ mang nước và tránh nắng trên đường đến phòng tập nhé.</c:when>
                            <c:when test="${weatherType eq 'wind'}">Gió mạnh, chú ý an toàn trên đường đến phòng tập nhé.</c:when>
                            <c:when test="${weatherType eq 'snow'}">Trời lạnh, mặc đủ ấm và khởi động kỹ trước khi tập nhé.</c:when>
                            <c:when test="${weatherType eq 'night'}">Tập vừa sức và dành thời gian nghỉ ngơi sau buổi tập tối nhé.</c:when>
                            <c:otherwise>Thời tiết dễ chịu, chúc bạn có một buổi tập thật tốt.</c:otherwise>
                        </c:choose>
                    </c:when>
                    <c:otherwise><c:out value="${weather.advice}" /></c:otherwise>
                </c:choose>
            </p>
        </div>
    </c:if>
</section>
