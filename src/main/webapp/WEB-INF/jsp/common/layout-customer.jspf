<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<div class="dockwrap" id="dock">
    <aside class="sidebar">
        <a class="brand" href="${pageContext.request.contextPath}/customer/dashboard" style="text-decoration: none;">
            <div class="brand-name">Super Gym</div>
            <div class="brand-role">Khu vực hội viên</div>
        </a>

        <nav class="nav" aria-label="Điều hướng chính">
            <div class="nav-group">Tổng quan</div>
            <a href="${pageContext.request.contextPath}/customer/dashboard"
               class="nav-link <c:if test="${activeSidebar == 'dashboard'}">active</c:if>"
               <c:if test="${activeSidebar == 'dashboard'}">aria-current="page"</c:if>>
                <i class="fa-solid fa-gauge-high" style="width: 18px; text-align: center;"></i> Trang cá nhân
            </a>

            <div class="nav-group">Gói tập</div>
            <a href="${pageContext.request.contextPath}/customer/packages/purchase"
               class="nav-link <c:if test="${activeSidebar == 'buy-package'}">active</c:if>"
               <c:if test="${activeSidebar == 'buy-package'}">aria-current="page"</c:if>>
                <i class="fa-solid fa-cart-shopping" style="width: 18px; text-align: center;"></i> Mua gói
            </a>
            <a href="${pageContext.request.contextPath}/customer/transactions"
               class="nav-link <c:if test="${activeSidebar == 'transactions'}">active</c:if>"
               <c:if test="${activeSidebar == 'transactions'}">aria-current="page"</c:if>>
                <i class="fa-solid fa-receipt" style="width: 18px; text-align: center;"></i> Lịch sử giao dịch
            </a>

            <div class="nav-group">Lịch tập</div>
            <a href="${pageContext.request.contextPath}/customer/schedule"
               class="nav-link <c:if test="${activeSidebar == 'schedule'}">active</c:if>"
               <c:if test="${activeSidebar == 'schedule'}">aria-current="page"</c:if>>
                <i class="fa-solid fa-calendar-check" style="width: 18px; text-align: center;"></i> Lịch của tôi
            </a>
            <a href="${pageContext.request.contextPath}/customer/pt-sessions"
               class="nav-link <c:if test="${activeSidebar == 'pt-sessions'}">active</c:if>"
               <c:if test="${activeSidebar == 'pt-sessions'}">aria-current="page"</c:if>>
                <i class="fa-solid fa-user-check" style="width: 18px; text-align: center;"></i> Buổi PT của tôi
            </a>
            <a href="${pageContext.request.contextPath}/customer/book-session"
               class="nav-link <c:if test="${activeSidebar == 'book-session'}">active</c:if>"
               <c:if test="${activeSidebar == 'book-session'}">aria-current="page"</c:if>>
                <i class="fa-solid fa-calendar-plus" style="width: 18px; text-align: center;"></i> Đặt buổi lẻ
            </a>
            <a href="${pageContext.request.contextPath}/customer/training-plans"
               class="nav-link <c:if test="${activeSidebar == 'training-plans'}">active</c:if>"
               <c:if test="${activeSidebar == 'training-plans'}">aria-current="page"</c:if>>
                <i class="fa-solid fa-clipboard-list" style="width: 18px; text-align: center;"></i> Giáo án của tôi
            </a>

            <div class="nav-group">Tài khoản</div>
            <a href="${pageContext.request.contextPath}/account"
               class="nav-link <c:if test="${activeSidebar == 'account'}">active</c:if>"
               <c:if test="${activeSidebar == 'account'}">aria-current="page"</c:if>>
                <i class="fa-solid fa-user-gear" style="width: 18px; text-align: center;"></i> Cài đặt tài khoản
            </a>

            <div class="nav-group">Hòm thư</div>
            <a href="${pageContext.request.contextPath}/customer/feedback"
               class="nav-link <c:if test="${activeSidebar == 'feedback'}">active</c:if>"
               <c:if test="${activeSidebar == 'feedback'}">aria-current="page"</c:if>>
                <i class="fa-solid fa-inbox" style="width: 18px; text-align: center;"></i> Hòm thư góp ý
            </a>
        </nav>

        <div class="side-foot">
            <form action="${pageContext.request.contextPath}/logout" method="post">
                <button type="submit" class="logout" style="border: none; background: transparent; cursor: pointer; text-align: left; font-family: inherit;">
                    <i class="fa-solid fa-arrow-right-from-bracket" style="width: 18px; text-align: center; margin-right: 8px;"></i> Đăng xuất
                </button>
            </form>
        </div>
    </aside>

    <button class="dock-handle" type="button" id="dockHandle"
            aria-label="Mở menu điều hướng" aria-expanded="false" aria-controls="dock">
        <svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
    </button>
</div>
