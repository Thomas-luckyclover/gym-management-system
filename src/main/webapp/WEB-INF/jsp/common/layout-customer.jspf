<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<a class="skip-link" href="#main-content">Bỏ qua menu, đến nội dung</a>
<div class="dockwrap" id="dock">
    <aside class="sidebar">
        <a class="brand" href="${pageContext.request.contextPath}/customer/dashboard">
            <span class="brand-mark"><img src="${pageContext.request.contextPath}/images/brand/super-gym-mark.svg?v=20261014d" alt="" width="44" height="44"></span>
            <div class="brand-text">
              <div class="brand-name">Super Gym</div>
              <div class="brand-role">Khu vực hội viên</div>
            </div>
        </a>

        <nav class="nav" aria-label="Điều hướng chính">
            <a href="${pageContext.request.contextPath}/" class="nav-link">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10H3z"></path><path d="M9 20v-7h6v7"></path></svg> Về trang chủ
            </a>
            <div class="nav-group">Tổng quan</div>
            <a href="${pageContext.request.contextPath}/customer/dashboard"
               class="nav-link <c:if test="${activeSidebar == 'dashboard'}">active</c:if>"
               <c:if test="${activeSidebar == 'dashboard'}">aria-current="page"</c:if>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg> Trang cá nhân
            </a>

            <div class="nav-group">Gói tập</div>
            <a href="${pageContext.request.contextPath}/customer/packages/purchase"
               class="nav-link <c:if test="${activeSidebar == 'buy-package'}">active</c:if>"
               <c:if test="${activeSidebar == 'buy-package'}">aria-current="page"</c:if>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.5 12H19l2-8H6"></path><circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg> Mua gói
            </a>
            <a href="${pageContext.request.contextPath}/customer/transactions"
               class="nav-link <c:if test="${activeSidebar == 'transactions'}">active</c:if>"
               <c:if test="${activeSidebar == 'transactions'}">aria-current="page"</c:if>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path><path d="M9 7h6M9 11h6M9 15h3"></path></svg> Lịch sử giao dịch
            </a>

            <div class="nav-group">Lịch tập</div>
            <a href="${pageContext.request.contextPath}/customer/pt-sessions"
               class="nav-link <c:if test="${activeSidebar == 'pt-sessions'}">active</c:if>"
               <c:if test="${activeSidebar == 'pt-sessions'}">aria-current="page"</c:if>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4m-8 9 3 3 5-5"></path></svg> Lịch tập của tôi
            </a>
            <a href="${pageContext.request.contextPath}/customer/book-session"
               class="nav-link <c:if test="${activeSidebar == 'book-session'}">active</c:if>"
               <c:if test="${activeSidebar == 'book-session'}">aria-current="page"</c:if>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5"></path></svg> Đặt buổi lẻ
            </a>
            <a href="${pageContext.request.contextPath}/customer/training-plans"
               class="nav-link <c:if test="${activeSidebar == 'training-plans'}">active</c:if>"
               <c:if test="${activeSidebar == 'training-plans'}">aria-current="page"</c:if>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="4" width="14" height="17" rx="2"></rect><rect x="9" y="2" width="8" height="4" rx="1"></rect><path d="M10 10h6M10 14h6M10 18h4"></path></svg> Giáo án của tôi
            </a>

            <div class="nav-group">Tài khoản</div>
            <a href="${pageContext.request.contextPath}/account"
               class="nav-link <c:if test="${activeSidebar == 'account'}">active</c:if>"
               <c:if test="${activeSidebar == 'account'}">aria-current="page"</c:if>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21v-2a8 8 0 0 1 16 0v2"></path></svg> Cài đặt tài khoản
            </a>

            <div class="nav-group">Hòm thư</div>
            <a href="${pageContext.request.contextPath}/customer/feedback"
               class="nav-link <c:if test="${activeSidebar == 'feedback'}">active</c:if>"
               <c:if test="${activeSidebar == 'feedback'}">aria-current="page"</c:if>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 14 6 4h12l3 10v6H3z"></path><path d="M3 14h5l2 3h4l2-3h5"></path></svg> Hòm thư góp ý
            </a>
        </nav>

        <div class="side-foot">
            <form action="${pageContext.request.contextPath}/logout" method="post">
                <button type="submit" class="logout" style="border: none; background: transparent; cursor: pointer; text-align: left; font-family: inherit;">
                    <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true" style="width: 18px; text-align: center; margin-right: 8px;"></i> Đăng xuất
                </button>
            </form>
        </div>
    </aside>
  <button class="dock-backdrop" type="button" tabindex="-1" aria-hidden="true"></button>

    <button class="dock-handle" type="button" id="dockHandle"
            aria-label="Mở menu điều hướng" aria-expanded="false" aria-controls="dock">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
    </button>
</div>
