<%--
  layout-pt.jspf — Sidebar dock khu Huấn luyện viên (/pt/*).
  Khớp prototype pt/trang-chu.html (menu: Hôm nay · Lịch dạy · Khách phụ trách · Cá nhân).
  Cùng cấu trúc class với layout-manager.jspf (dockwrap / sidebar / nav-link / dock-handle)
  để trang dùng chung như Cài đặt tài khoản include được luôn.
  Trang include file này đặt request attribute "activeNav" để tô mục đang mở, VD "dashboard".
  Lịch dạy gộp lịch rảnh và buổi có khách tại /pt/schedule.

  CÁCH DÙNG: dashboard.jsp / schedule.jsp include file này để dùng chung menu PT.
  Đây là fragment (một phần trang), không có html/head/body và không mở trực tiếp bằng URL.

  DỮ LIỆU ĐỌC:
    activeNav: request attribute do Servlet đặt, quyết định mục nào được tô sáng.
      "dashboard" → Tổng quan       "schedule" → Lịch dạy
      "clients"   → Khách của tôi   "leaves"   → Nghỉ phép
      "account"   → Cài đặt tài khoản
    sessionScope.availableRoles: danh sách vai trò dạng chuỗi, dùng để hiện nút Đổi vai trò.
    pageContext.request.contextPath: đường dẫn gốc của app trên Tomcat, ví dụ /gms.

  ĐIỂM NỐI JS: common.js dùng #dock, #dockHandle và .dock-backdrop để mở/đóng menu.
  File này chỉ hiển thị menu; quyền truy cập /pt/* do PtAreaFilter kiểm tra ở server.
--%>
<%-- UTF-8 để đọc đúng tiếng Việt; thư viện c dùng c:if kiểm tra mục menu và vai trò. --%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%-- Link hỗ trợ bàn phím: chuyển thẳng tới main có id="main-content" trong trang cha. --%>
<a class="skip-link" href="#main-content">Bỏ qua menu, đến nội dung</a>

<%-- ===== Khung menu dock (#dock: common.js điều khiển đóng/mở) ===== --%>
<div class="dockwrap" id="dock">
  <aside class="sidebar">
    <%-- ===== Nhận diện phòng gym: logo + tên + khu vực PT =====
         contextPath tự theo tên app; alt rỗng vì tên Super Gym đã có ngay cạnh ảnh.
         ?v=... là phiên bản ảnh để trình duyệt không giữ logo cũ trong cache. --%>
    <div class="brand">
      <span class="brand-mark"><img src="${pageContext.request.contextPath}/images/brand/super-gym-mark.svg?v=20261014d" alt="" width="44" height="44"></span>
      <div class="brand-text">
        <div class="brand-name">Super Gym</div>
        <div class="brand-role">Huấn luyện viên</div>
      </div>
    </div>
    <%-- ===== KẾT THÚC nhận diện phòng gym ===== --%>

    <%-- ===== Các mục điều hướng (activeNav do Servlet của trang đang xem đặt) =====
         Mẫu chung cho mỗi link:
         - href: GET tới Servlet tương ứng, không mở JSP trực tiếp.
         - c:if trong class: nếu đang xem mục này thì in thêm chữ " active" để CSS tô sáng.
         - aria-current="page": báo mục đang mở cho trình đọc màn hình.
         - svg aria-hidden="true": icon trang trí, tên link đã nằm trong span. --%>
    <nav class="nav" aria-label="Điều hướng chính">
      <%-- Tổng quan: PtDashboardServlet đặt activeNav="dashboard". nav-group chỉ là nhãn nhóm. --%>
      <div class="nav-group">Hôm nay</div>
      <a href="${pageContext.request.contextPath}/pt/dashboard"
         class="nav-link<c:if test="${activeNav == 'dashboard'}"> active</c:if>"
         <c:if test="${activeNav == 'dashboard'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg><span>Tổng quan</span>
      </a>
      <%-- Lịch dạy: PtScheduleServlet đặt activeNav="schedule".
           Ví dụ đang ở /pt/schedule?date=2026-10-22 thì mục này có class="nav-link active".
           Tham số date đổi tuần, không đổi mục menu đang được tô. --%>
      <div class="nav-group">Lịch dạy</div>
      <a href="${pageContext.request.contextPath}/pt/schedule"
         class="nav-link<c:if test="${activeNav == 'schedule'}"> active</c:if>"
         <c:if test="${activeNav == 'schedule'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4M7 14h2M11 14h2M15 14h2M7 18h2M11 18h2"></path></svg><span>Lịch dạy</span>
      </a>

      <%-- Khách phụ trách: link tới /pt/clients; được tô khi activeNav="clients". --%>
      <div class="nav-group">Khách phụ trách</div>
      <a href="${pageContext.request.contextPath}/pt/clients"
         class="nav-link<c:if test="${activeNav == 'clients'}"> active</c:if>"
         <c:if test="${activeNav == 'clients'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20v-1a6.5 6.5 0 0 1 13 0v1M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.8c1.6.7 2.7 2.4 3 5.2"></path></svg><span>Khách của tôi</span>
      </a>
      <%-- Thư viện bài tập: ExerciseLibraryServlet đặt activeNav="exercises". Tra bài từ wger khi soạn giáo án. --%>
      <a href="${pageContext.request.contextPath}/pt/exercises"
         class="nav-link<c:if test="${activeNav == 'exercises'}"> active</c:if>"
         <c:if test="${activeNav == 'exercises'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11"></path></svg><span>Thư viện bài tập</span>
      </a>

      <%-- Cá nhân gồm Nghỉ phép (activeNav="leaves") và Cài đặt tài khoản ("account"). --%>
      <div class="nav-group">Cá nhân</div>
      <a href="${pageContext.request.contextPath}/pt/leave-requests"
         class="nav-link<c:if test="${activeNav == 'leaves'}"> active</c:if>"
         <c:if test="${activeNav == 'leaves'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4m-7 7 6 6m0-6-6 6"></path></svg><span>Nghỉ phép</span>
      </a>
      <a href="${pageContext.request.contextPath}/account"
         class="nav-link<c:if test="${activeNav == 'account'}"> active</c:if>"
         <c:if test="${activeNav == 'account'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21v-2a8 8 0 0 1 16 0v2"></path></svg><span>Cài đặt tài khoản</span>
      </a>
    </nav>
    <%-- ===== KẾT THÚC các mục điều hướng ===== --%>

    <%-- ===== Cuối sidebar: đổi vai trò và đăng xuất ===== --%>
    <div class="side-foot">
      <%-- CBR-113: tài khoản nhiều vai trò → đổi vai trò không cần đăng nhập lại --%>
      <%-- availableRoles được lưu trong session dưới dạng chuỗi, ví dụ "PT,Customer".
           not empty: phải có dữ liệu; contains(','): có nhiều hơn một vai trò.
           Chỉ khi cả hai điều kiện đúng mới in link sang màn chọn vai trò. --%>
      <c:if test="${not empty sessionScope.availableRoles and sessionScope.availableRoles.contains(',')}">
        <a href="${pageContext.request.contextPath}/select-role" class="logout"><i class="fa-solid fa-repeat" aria-hidden="true"></i> Đổi vai trò</a>
      </c:if>
      <%-- GET /logout tới LogoutServlet; Servlet xử lý phiên đăng nhập, JSP chỉ tạo link. --%>
      <a href="${pageContext.request.contextPath}/logout" class="logout">
        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Đăng xuất
      </a>
    </div>
    <%-- ===== KẾT THÚC cuối sidebar ===== --%>
  </aside>
  <%-- Lớp phủ ngoài sidebar: common.js bắt sự kiện bấm để đóng menu.
       tabindex="-1" không đưa lớp phủ vào thứ tự Tab; có nút dockHandle để thao tác bàn phím. --%>
  <button class="dock-backdrop" type="button" tabindex="-1" aria-hidden="true"></button>

  <%-- Nút mở/đóng menu: aria-controls="dock" nối tới id="dock" phía trên.
       aria-expanded=false là trạng thái HTML ban đầu; common.js cập nhật khi người dùng bấm.
       type="button" tránh vô tình submit form nếu trang cha có form bao quanh. --%>
  <button class="dock-handle"
          id="dockHandle"
          type="button"
          aria-label="Mở menu điều hướng"
          aria-expanded="false"
          aria-controls="dock">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
  </button>
</div>
<%-- ===== KẾT THÚC khung menu dock ===== --%>
