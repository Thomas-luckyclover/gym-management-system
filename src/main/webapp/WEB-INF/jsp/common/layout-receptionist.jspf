<%--
  layout-receptionist.jspf — Sidebar dock Lễ tân.
  Khớp prototype Receptionist, theme-staff.
  Cấu trúc giống layout-manager.jspf.
  Mục chưa có servlet → href="#".
--%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%-- Thanh cảnh báo ca (ReceptionistAreaFilter đặt shiftNotice):
     MSG323 ca quá giờ chưa chốt — mọi màn lễ tân (CBR-123); MSG109 chưa mở ca — màn Bán hàng / Bán gói PT (CBR-105).
     Màn Ca làm việc đã có banner riêng nên không hiện ở đó. --%>
<c:if test="${not empty shiftNotice and activeNav != 'shifts'}">
  <%-- Cùng kiểu với toast chuẩn của common.js (.toast-warning): nền thẻ theo theme, vạch trái + icon màu cảnh báo ĐẬM.
       Bản cũ hard-code #FFF4E5 (kem nhạt) → nhạt, lệch màu app, vi phạm quy tắc chỉ dùng token (06/11). --%>
  <style>
    .shift-notice{position:fixed;left:50%;bottom:var(--space-4);transform:translateX(-50%);z-index:var(--z-toast);
      display:flex;gap:var(--space-3);align-items:center;max-width:min(720px,calc(100vw - var(--space-8)));
      padding:var(--space-3) var(--space-4);border-radius:var(--radius-md);
      background:var(--color-surface);color:var(--color-text);
      border:var(--border-width) solid var(--color-warning-border);border-left:var(--border-width-accent) solid var(--color-warning);
      box-shadow:var(--shadow-pop);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold);line-height:var(--line-height-snug)}
    .shift-notice > i{flex:none;color:var(--color-warning);font-size:var(--font-size-lg)}
    .shift-notice a{flex:none;padding:var(--space-1-5) var(--space-3);border-radius:var(--radius-sm);
      background:var(--color-warning);color:var(--brand-ink);
      font-weight:var(--font-weight-bold);text-decoration:none;white-space:nowrap}
    .shift-notice a:hover{filter:brightness(1.08)}
    .shift-notice-close{flex:none;background:transparent;border:0;color:var(--color-text-muted);
      padding:var(--space-2);font-size:var(--font-size-xl);line-height:1;cursor:pointer}
    .shift-notice-close:hover{color:var(--color-text)}
  </style>
  <div class="shift-notice" role="status">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <span><c:out value="${shiftNotice}" /></span>
    <a href="${pageContext.request.contextPath}/receptionist/shift">Ca làm việc</a>
    <%-- Chỉ đóng cảnh báo trên trang hiện tại; tải lại trang sẽ kiểm tra ca lại. --%>
    <button type="button" class="shift-notice-close" aria-label="Đóng cảnh báo ca làm việc"
            onclick="this.closest('.shift-notice').remove()">×</button>
  </div>
</c:if>

<a class="skip-link" href="#main-content">Bỏ qua menu, đến nội dung</a>
<div class="dockwrap" id="dock">
  <aside class="sidebar">
    <div class="brand">
      <span class="brand-mark"><img src="${pageContext.request.contextPath}/images/brand/super-gym-mark.svg?v=20261014d" alt="" width="44" height="44"></span>
      <div class="brand-text">
        <div class="brand-name">Super Gym</div>
        <div class="brand-role">Lễ tân</div>
      </div>
    </div>

    <nav class="nav" aria-label="Điều hướng chính">
      <%-- Nhóm: Tại quầy --%>
      <div class="nav-group">Tại quầy</div>
      <a href="${pageContext.request.contextPath}/receptionist/check-in"
         class="nav-link<c:if test="${activeNav == 'checkin'}"> active</c:if>"
         <c:if test="${activeNav == 'checkin'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 11l3 3 8-8"></path>
          <path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"></path>
        </svg>
        <span>Check-in</span>
      </a>
      <a href="${pageContext.request.contextPath}/receptionist/sales"
         class="nav-link<c:if test="${activeNav == 'sales'}"> active</c:if>"
         <c:if test="${activeNav == 'sales'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="6" width="20" height="12" rx="2"></rect>
          <circle cx="12" cy="12" r="2.5"></circle>
          <path d="M6 10v4M18 10v4"></path>
        </svg>
        <span>Bán hàng</span>
      </a>
      <a href="${pageContext.request.contextPath}/receptionist/pt-sales"
         class="nav-link<c:if test="${activeNav == 'pt-sales'}"> active</c:if>"
         <c:if test="${activeNav == 'pt-sales'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 8a2 2 0 0 0 0 4v4h18v-4a2 2 0 0 1 0-4V4H3z"></path>
        </svg>
        <span>Bán gói PT</span>
      </a>
      <a href="${pageContext.request.contextPath}/receptionist/shift"
         class="nav-link<c:if test="${activeNav == 'shifts'}"> active</c:if>"
         <c:if test="${activeNav == 'shifts'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7v5l3 2"></path>
        </svg>
        <span>Ca làm việc</span>
      </a>

      <%-- Nhóm: Hội viên --%>
      <div class="nav-group">Hội viên</div>
      <a href="${pageContext.request.contextPath}/receptionist/customers"
         class="nav-link<c:if test="${activeNav == 'customers'}"> active</c:if>"
         <c:if test="${activeNav == 'customers'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="9" cy="8" r="3.5"></circle>
          <path d="M2.5 20c.6-3.6 3.3-5.5 6.5-5.5s5.9 1.9 6.5 5.5"></path>
          <path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.8c1.6.7 2.7 2.4 3 5.2"></path>
        </svg>
        <span>Hồ sơ khách</span>
      </a>
      <a href="${pageContext.request.contextPath}/receptionist/freeze"
         class="nav-link<c:if test="${activeNav == 'freeze'}"> active</c:if>"
         <c:if test="${activeNav == 'freeze'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9L4.9 19.1"></path>
        </svg>
        <span>Bảo lưu</span>
      </a>

      <%-- Nhóm: Cơ sở vật chất --%>
      <div class="nav-group">Cơ sở vật chất</div>
      <a href="${pageContext.request.contextPath}/receptionist/facilities"
         class="nav-link<c:if test="${activeNav == 'equipment'}"> active</c:if>"
         <c:if test="${activeNav == 'equipment'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 7l9-4 9 4v10l-9 4-9-4z"></path>
          <path d="M3 7l9 4 9-4M12 11v10"></path>
        </svg>
        <span>Danh mục thiết bị</span>
      </a>
      <a href="${pageContext.request.contextPath}/receptionist/maintenance-requests"
         class="nav-link<c:if test="${activeNav == 'maintenance'}"> active</c:if>"
         <c:if test="${activeNav == 'maintenance'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14.7 6.3a4 4 0 0 0 5 5L21 13l-8 8-3-3 8-8-1.3-1.3a4 4 0 0 0-5-5z"></path>
          <path d="M4 20l5-5"></path>
        </svg>
        <span>Yêu cầu bảo trì</span>
      </a>

      <%-- Nhóm: Cá nhân --%>
      <div class="nav-group">Cá nhân</div>
      <a href="${pageContext.request.contextPath}/receptionist/leave-requests"
         class="nav-link<c:if test="${activeNav == 'leaves'}"> active</c:if>"
         <c:if test="${activeNav == 'leaves'}">aria-current="page"</c:if>>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2"></rect>
          <path d="M3 10h18M8 3v4M16 3v4"></path>
        </svg>
        <span>Đơn nghỉ phép</span>
      </a>
      <a href="${pageContext.request.contextPath}/account"
         class="nav-link<c:if test="${activeNav == 'account'}"> active</c:if>"
         <c:if test="${activeNav == 'account'}">aria-current="page"</c:if>>

        <svg viewBox="0 0 24 24"
             aria-hidden="true">

          <circle cx="12"
                  cy="12"
                  r="3"></circle>

          <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path>

        </svg>

        <span>Cài đặt tài khoản</span>
      </a>
    </nav>

    <%-- Prototype dock ẩn khối "me"; tài khoản nằm trên topbar --%>
    <div class="side-foot">
      <%-- CBR-113: tài khoản nhiều vai trò → đổi vai trò không cần đăng nhập lại --%>
      <c:if test="${not empty sessionScope.availableRoles and sessionScope.availableRoles.contains(',')}">
        <a href="${pageContext.request.contextPath}/select-role" class="logout"><i class="fa-solid fa-repeat" aria-hidden="true"></i> Đổi vai trò</a>
      </c:if>
      <a href="${pageContext.request.contextPath}/logout" class="logout">Đăng xuất</a>
    </div>
  </aside>
  <button class="dock-backdrop" type="button" tabindex="-1" aria-hidden="true"></button>

  <button class="dock-handle"
          id="dockHandle"
          type="button"
          aria-label="Mở menu điều hướng"
          aria-expanded="false"
          aria-controls="dock">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
  </button>
</div>
