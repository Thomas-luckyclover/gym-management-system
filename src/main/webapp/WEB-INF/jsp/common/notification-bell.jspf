<%@ page pageEncoding="UTF-8" %>

<div class="notification-bell"
     id="notificationBell">

  <button type="button"
          class="notification-bell-button"
          id="notificationBellButton"
          aria-label="Thông báo"
          aria-expanded="false"
          aria-controls="notificationPopover">

    <i class="fa-solid fa-bell"
       aria-hidden="true"></i>

    <span class="notification-bell-count"
          id="notificationBellCount"
          hidden>
    </span>

  </button>

  <div class="notification-popover"
       id="notificationPopover"
       hidden>

    <div class="notification-popover-head"
         id="notificationPopoverHead">

      <div>
        <strong>Thông báo</strong>

        <small id="notificationUnreadText">
          Không có thông báo chưa đọc
        </small>
      </div>

      <button type="button"
              class="notification-read-all"
              id="notificationReadAllButton"
              hidden>
        Đánh dấu tất cả đã đọc
      </button>

    </div>

    <div class="notification-popover-list"
         id="notificationPopoverList">

      <div class="notification-state">
        Đang tải...
      </div>

    </div>

    <div class="notification-detail"
         id="notificationDetailView"
         hidden>
    </div>

  </div>

</div>
