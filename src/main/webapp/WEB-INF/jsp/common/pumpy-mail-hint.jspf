<%@ page pageEncoding="UTF-8" %>
<%-- ===== Hộp gợi ý "Chưa nhận được mail?" — Pumpy tựa tạ lười biếng + bong bóng thoại =====
     Dùng ở bước nhập mã: Quên mật khẩu (bước 2) và Đăng ký (bước OTP, bước claim-otp).
     Chữ tĩnh, hình trang trí (aria-hidden). CSS: common.css mục 13 (.pumpy-hint). Nút "Gửi lại mã" nằm phía trên khối này. --%>
<aside class="pumpy-hint" aria-labelledby="pumpyHintTitle">


            <div class="pumpy-bubble">
              <p class="pumpy-bubble__title" id="pumpyHintTitle">Chưa thấy mail à? Từ từ thôi…</p>
              <ol class="pumpy-steps">
                <li>Mở mục <b>Thư rác / Spam</b> hoặc <b>Quảng cáo</b> trong hộp thư.</li>
                <li>Hết thời gian chờ thì bấm <b>Gửi lại mã</b> ở trên.</li>
                <li>Đợi vài phút rồi thử lại, đôi khi mail đến hơi chậm.</li>
                <li>Vẫn không được? Ghé <b>quầy lễ tân</b>, mọi người sẽ giúp bạn.</li>
              </ol>
            </div>
            <svg class="pumpy-lazy" viewBox="0 0 250 160" aria-hidden="true" focusable="false">
              <ellipse cx="128" cy="152" rx="112" ry="6" fill="#000" opacity=".35"/>
              <%-- Quả tạ nằm ngang phía sau lưng --%>
              <g class="pumpy-lazy__db" transform="translate(30 0)">
                <rect x="134" y="110" width="62" height="12" rx="3" fill="#9AA7B0" stroke="#141414" stroke-width="3"/>
                <rect x="124" y="82" width="20" height="68" rx="5" fill="#203D60" stroke="#141414" stroke-width="4"/>
                <rect x="186" y="82" width="20" height="68" rx="5" fill="#203D60" stroke="#141414" stroke-width="4"/>
                <rect x="132" y="90" width="4" height="52" rx="2" fill="#294F78"/>
                <rect x="194" y="90" width="4" height="52" rx="2" fill="#294F78"/>
              </g>
              <%-- Pumpy ngả lưng 14° vào bánh tạ, thở chậm --%>
              <g transform="rotate(-14 96 112)">
              <g class="pumpy-lazy__body">
                <path d="M44 70 L46 38 L70 54 Z" fill="#294F78" stroke="#141414" stroke-width="4"/>
                <path d="M136 70 L134 38 L110 54 Z" fill="#294F78" stroke="#141414" stroke-width="4"/>
                <path d="M30 106 C30 62 58 42 90 42 C122 42 150 62 150 106 C150 132 125 146 90 146 C55 146 30 132 30 106 Z" fill="#294F78" stroke="#141414" stroke-width="4"/>
                <path d="M44 84 Q49 64 66 55" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".7"/>
                <ellipse cx="88" cy="120" rx="30" ry="21" fill="#F2FBF8"/>
                <%-- Xoắn ốc bụng: đúng đường gốc của Pumpy, thu nhỏ vào giữa bụng --%>
                <path transform="translate(88 120) scale(0.5) translate(-150 -280)" d="M150.0 278.0 L150.3 278.2 L150.4 278.5 L150.5 278.9 L150.5 279.3 L150.4 279.7 L150.2 280.1 L149.9 280.5 L149.4 280.8 L148.9 281.0 L148.3 281.1 L147.7 281.1 L147.0 281.0 L146.3 280.7 L145.7 280.3 L145.0 279.8 L144.5 279.1 L144.0 278.3 L143.7 277.4 L143.5 276.4 L143.5 275.3 L143.7 274.2 L144.0 273.1 L144.5 272.0 L145.3 271.0 L146.2 270.1 L147.3 269.3 L148.5 268.6 L149.9 268.1 L151.4 267.9 L153.0 267.9 L154.6 268.1 L156.2 268.6 L157.7 269.3 L159.2 270.3 L160.5 271.5 L161.6 273.0 L162.6 274.7 L163.3 276.5 L163.7 278.5 L163.8 280.5 L163.7 282.6 L163.1 284.7 L162.3 286.8 L161.1 288.8 L159.7 290.5 L157.9 292.1 L155.9 293.5 L153.6 294.5 L151.2 295.2 L148.7 295.5 L146.0 295.5 L143.4 295.1 L140.8 294.2 L138.3 293.0 L136.0 291.4 L133.9 289.4 L132.1 287.0 L130.6 284.4 L129.6 281.6 L128.9 278.6 L128.7 275.5 L128.9 272.3 L129.7 269.1 L130.9 266.1 L132.6 263.2 L134.7 260.5 L137.2 258.2 L140.1 256.2 L143.3 254.7 L146.7 253.6 L150.3 253.0 L154.0 253.0 L157.8 253.5 L161.4 254.6 L164.9 256.2 L168.2 258.4 L171.1 261.0 L173.7 264.1 L175.8 267.6 L177.4 271.4 L178.4 275.4 L178.8 279.6 L178.6 283.9 L177.8 288.1 L176.3 292.2 L174.2 296.1 L171.6 299.7 L168.4 302.9 L164.7 305.6 L160.6 307.8" fill="none" stroke="#24496E" stroke-width="7"/>
                <%-- Mắt lim dim + miệng thư giãn --%>
                <path d="M64 84 Q72 90 80 84" fill="none" stroke="#141414" stroke-width="4" stroke-linecap="round"/>
                <path d="M100 84 Q108 90 116 84" fill="none" stroke="#141414" stroke-width="4" stroke-linecap="round"/>
