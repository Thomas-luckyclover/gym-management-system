                <ellipse cx="118" cy="96" rx="6" ry="3.5" fill="#FF9EB5" opacity=".7"/>
                <%-- Tay vắt lên bánh tạ, tay kia đặt trên bụng, chân duỗi --%>
                <circle cx="40" cy="118" r="12" fill="#294F78" stroke="#141414" stroke-width="4"/>
                <ellipse cx="52" cy="145" rx="17" ry="11" fill="#294F78" stroke="#141414" stroke-width="4"/>
                <ellipse cx="110" cy="148" rx="17" ry="11" fill="#294F78" stroke="#141414" stroke-width="4"/>
              </g>
              </g>
              <%-- Bàn tay tròn sát thân cạnh bánh tạ, không có cánh tay kéo dài --%>


              <circle cx="151" cy="103" r="13" fill="#294F78" stroke="#141414" stroke-width="4"/>
              <%-- z z z bay lên --%>
              <g class="pumpy-lazy__z" font-family="Montserrat, Inter, sans-serif" font-weight="900" fill="#294F78" stroke="#141414" stroke-width="1.5" paint-order="stroke">
                <text x="150" y="40" font-size="13">z</text>
                <text x="164" y="30" font-size="16">z</text>
                <text x="180" y="16" font-size="20">z</text>
              </g>
            </svg>
          </aside>
