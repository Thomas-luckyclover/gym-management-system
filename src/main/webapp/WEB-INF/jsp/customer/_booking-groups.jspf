<%@ page pageEncoding="UTF-8" %>
<%--
  KHUNG "CẦN ĐỂ Ý" — include trong my-bookings.jsp; trang cha đặt biến groups = booking.watchGroups.
  Mỗi nhóm (SessionGroup ← MyBookingService.groupByReason): nhãn trạng thái g.statusLabel · "N buổi" · lý do g.explanation
    · danh sách ngày, bấm 1 ngày → Lịch tập tuần mở đúng buổi (weekLink + date + openSession).
--%>

<ul class="booking-groups">
    <c:forEach var="g" items="${groups}">
        <li class="booking-group">
            <p class="booking-group-head">
                <span class="session-status" data-status="${g.statusKey}"><c:out value="${g.statusLabel}" /></span>
                <b>${fn:length(g.sessions)} buổi</b>
                <span class="booking-group-note"><c:out value="${g.explanation}" /></span>
            </p>
            <p class="booking-group-dates">
                <c:forEach var="s" items="${g.sessions}">

                    <a href="${weekLink}&amp;date=${s.slotDate}&amp;openSession=${s.sessionId}" title="${fn:escapeXml(s.dayName)}, ${gms:formatDate(s.slotDate)} · ${gms:formatTime(s.startTime)} – ${gms:formatTime(s.endTime)}">${fn:replace(fn:replace(s.dayName, 'Thứ ', 'T'), 'Chủ nhật', 'CN')} ${fn:substring(gms:formatDate(s.slotDate), 0, 5)}</a>
                </c:forEach>
            </p>
        </li>
    </c:forEach>
</ul>
