<%@ page pageEncoding="UTF-8" %>
<%-- B1: thẻ trái chỉ nhận diện gói; tiến độ chi tiết nằm trong khối phải. --%>
<c:set var="left" value="${p.totalSessions - p.pastSessions}" />
<c:set var="ptWords" value="${fn:split(p.ptName, ' ')}" />
<a class="booking-package" href="${pageUrl}?id=${p.subscriptionId}" aria-current="${booking.selectedPackage.subscriptionId eq p.subscriptionId ? 'page' : 'false'}">
    <strong class="booking-package-name"><c:out value="${p.packageName}" /></strong>
    <span class="booking-package-meta">PT <c:out value="${ptWords[fn:length(ptWords) - 1]}" /> · <b class="${left le 3 ? 'is-ending' : ''}">còn <c:out value="${left}" /> buổi</b></span>
</a>
