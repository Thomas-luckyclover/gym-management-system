<%@ page pageEncoding="UTF-8" %>
<%-- ===== 1 THẺ BUỔI trong ô lịch tuần. Biến s (MyPtSessionRow) đến từ vòng lặp của my-pt-sessions.jsp. =====
     <details> = có JS: my-pt-sessions.js chặn mở tại chỗ, chép phần [data-session-content] vào hộp chi tiết.
                 không JS: bấm thẻ vẫn xổ chi tiết ngay dưới (HTML thuần).
     is-ended (buổi đã qua): nền trầm nhưng vẫn bấm xem được. --%>
<details class="session-card ${s.ended ? 'is-ended' : ''}" data-session-detail data-session-id="${s.sessionId}" data-status="${s.statusKey}">
    <summary>
        <c:if test="${s.ended}"><span class="visually-hidden">Buổi đã kết thúc. </span></c:if>
        <strong>${gms:formatTime(s.startTime)} – ${gms:formatTime(s.endTime)}</strong>
        <span class="session-card-pt">PT <c:out value="${s.ptName}" /></span>
        <small><c:out value="${s.typeLabel}" /><c:if test="${not s.singleSession}"> · ${s.sessionNo}/${s.totalSessions}</c:if></small>
        <span class="session-status" data-status="${s.statusKey}"><c:out value="${s.statusLabel}" /></span>
    </summary>
    <div data-session-content><%@ include file="_session-detail.jspf" %></div>
</details>
