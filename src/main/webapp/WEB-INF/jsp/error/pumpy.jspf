<%@ page pageEncoding="UTF-8" %>
<%--
  Pumpy trên 3 trang lỗi. Trang gọi đặt pumpyMood trước khi include:
    lost (404) mắt ngó nghiêng + dấu hỏi · stop (403) mặt nghiêm + giơ tay chặn · dizzy (500) mắt xoay + sao, tạ đổ.
  Chỉ để trang trí (aria-hidden). CSS: error.css mục "Pumpy".
--%>
<svg class="err-pumpy err-pumpy--${pumpyMood}" viewBox="0 0 124 92" aria-hidden="true" focusable="false">
  <ellipse cx="60" cy="87" rx="44" ry="3.5" fill="#000" opacity=".25"/>
  <%-- Quả tạ cạnh chân (500: đổ nghiêng) --%>
  <g class="err-pumpy__db" transform="${pumpyMood eq 'dizzy' ? 'translate(98 74) rotate(-28 11 7)' : 'translate(96 70)'}">
    <rect x="4" y="6" width="14" height="3" rx="1" fill="#9AA7B0" stroke="#141414" stroke-width="1.2"/>
    <rect x="0" y="0" width="5" height="15" rx="1.5" fill="#203D60" stroke="#141414" stroke-width="1.4"/>
    <rect x="17" y="0" width="5" height="15" rx="1.5" fill="#203D60" stroke="#141414" stroke-width="1.4"/>
    <rect x="2" y="2" width="1" height="11" fill="#294F78"/><rect x="19" y="2" width="1" height="11" fill="#294F78"/>
  </g>
  <g class="err-pumpy__body">
    <path d="M30 40 L31 19 L45 30Z M86 40 L85 19 L71 30Z" fill="#294F78" stroke="#141414" stroke-width="3" stroke-linejoin="round"/>
    <path d="M22 62 C22 38 38 26 58 26 C78 26 94 38 94 62 C94 78 79 86 58 86 C37 86 22 78 22 62Z" fill="#294F78" stroke="#141414" stroke-width="3"/>
    <path d="M30 46 Q34 36 44 31" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" opacity=".7"/>
    <ellipse cx="58" cy="69" rx="18" ry="12" fill="#F2FBF8"/>
    <%-- Xoắn ốc bụng: đường gốc của Pumpy (giống pumpy-mail-hint.jspf) --%>
    <path transform="translate(58 73) scale(0.26) translate(-150 -280)" d="M150.0 278.0 L150.3 278.2 L150.4 278.5 L150.5 278.9 L150.5 279.3 L150.4 279.7 L150.2 280.1 L149.9 280.5 L149.4 280.8 L148.9 281.0 L148.3 281.1 L147.7 281.1 L147.0 281.0 L146.3 280.7 L145.7 280.3 L145.0 279.8 L144.5 279.1 L144.0 278.3 L143.7 277.4 L143.5 276.4 L143.5 275.3 L143.7 274.2 L144.0 273.1 L144.5 272.0 L145.3 271.0 L146.2 270.1 L147.3 269.3 L148.5 268.6 L149.9 268.1 L151.4 267.9 L153.0 267.9 L154.6 268.1 L156.2 268.6 L157.7 269.3 L159.2 270.3 L160.5 271.5 L161.6 273.0 L162.6 274.7 L163.3 276.5 L163.7 278.5 L163.8 280.5 L163.7 282.6 L163.1 284.7 L162.3 286.8 L161.1 288.8 L159.7 290.5 L157.9 292.1 L155.9 293.5 L153.6 294.5 L151.2 295.2 L148.7 295.5 L146.0 295.5 L143.4 295.1 L140.8 294.2 L138.3 293.0 L136.0 291.4 L133.9 289.4 L132.1 287.0 L130.6 284.4 L129.6 281.6 L128.9 278.6 L128.7 275.5 L128.9 272.3 L129.7 269.1 L130.9 266.1 L132.6 263.2 L134.7 260.5 L137.2 258.2 L140.1 256.2 L143.3 254.7 L146.7 253.6 L150.3 253.0 L154.0 253.0 L157.8 253.5 L161.4 254.6 L164.9 256.2 L168.2 258.4 L171.1 261.0 L173.7 264.1 L175.8 267.6 L177.4 271.4 L178.4 275.4 L178.8 279.6 L178.6 283.9 L177.8 288.1 L176.3 292.2 L174.2 296.1 L171.6 299.7 L168.4 302.9 L164.7 305.6 L160.6 307.8" fill="none" stroke="#24496E" stroke-width="7"/>
    <c:choose>
      <c:when test="${pumpyMood eq 'stop'}">
        <%-- Mặt nghiêm: lông mày chau + mắt nhỏ, tay giơ chặn --%>
        <path d="M43 44 L54 47 M75 44 L64 47" stroke="#141414" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="49" cy="51" r="3" fill="#141414"/><circle cx="69" cy="51" r="3" fill="#141414"/>
        <path d="M54 61 H64" stroke="#141414" stroke-width="2.2" stroke-linecap="round"/>
        <g class="err-pumpy__paw"><circle cx="98" cy="47" r="8" fill="#294F78" stroke="#141414" stroke-width="2.5"/>
        <path d="M96 40 V44 M100 39 V43 M104 40 V44" stroke="#141414" stroke-width="1.6" stroke-linecap="round"/></g>
      </c:when>
      <c:when test="${pumpyMood eq 'dizzy'}">
        <%-- Choáng: mắt xoáy + sao bay quanh đầu --%>
        <path d="M49 50 m-4 0 a4 4 0 1 1 4 4 a2.4 2.4 0 1 1 -2.4 -2.4" fill="none" stroke="#141414" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M69 50 m-4 0 a4 4 0 1 1 4 4 a2.4 2.4 0 1 1 -2.4 -2.4" fill="none" stroke="#141414" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M53 61 Q56 58 59 61 T65 61" fill="none" stroke="#141414" stroke-width="2" stroke-linecap="round"/>
        <g class="err-pumpy__stars" fill="#294F78" stroke="#141414" stroke-width="1.2" stroke-linejoin="round">
          <path d="M22 18 l2 4 4 1 -4 1 -2 4 -2 -4 -4 -1 4 -1z"/>
          <path d="M98 14 l1.6 3.2 3.2 .8 -3.2 .8 -1.6 3.2 -1.6 -3.2 -3.2 -.8 3.2 -.8z"/>
          <path d="M60 6 l1.4 2.8 2.8 .7 -2.8 .7 -1.4 2.8 -1.4 -2.8 -2.8 -.7 2.8 -.7z"/>
        </g>
      </c:when>
      <c:otherwise>
        <%-- Lạc đường: mắt ngó sang phải + dấu hỏi --%>
        <g class="err-pumpy__eyes">
          <circle cx="51" cy="50" r="3.6" fill="#141414"/><circle cx="71" cy="50" r="3.6" fill="#141414"/>
          <circle cx="52.2" cy="48.6" r="1.2" fill="#fff"/><circle cx="72.2" cy="48.6" r="1.2" fill="#fff"/>
        </g>
        <circle cx="59" cy="59" r="2.6" fill="none" stroke="#141414" stroke-width="2"/>
        <text class="err-pumpy__q" x="96" y="30" font-family="Montserrat,Arial,sans-serif" font-weight="900" font-size="24" fill="#294F78" stroke="#141414" stroke-width="2" paint-order="stroke">?</text>
      </c:otherwise>
    </c:choose>
    <ellipse cx="42" cy="85" rx="9" ry="5" fill="#294F78" stroke="#141414" stroke-width="2.5"/>
    <ellipse cx="74" cy="85" rx="9" ry="5" fill="#294F78" stroke="#141414" stroke-width="2.5"/>
  </g>
</svg>
