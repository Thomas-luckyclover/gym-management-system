<%@ page pageEncoding="UTF-8" %>
<%-- ===== Linh vật Super Gym "Pumpy" ngồi cạnh tạ (khối Kêu gọi đăng ký, trang chủ) =====
     Nguồn: SVG người dùng cung cấp (10/2026), bỏ metadata C2PA cho nhẹ, đổi id thành mochi-* để không trùng.
     JS (js/pages/guest/home.js): thêm .is-visible khi cuộn tới (bật lên + tạ rơi), mắt nhìn theo con trỏ (--ex/--ey),
     bấm/Enter → nhảy + bong bóng thoại. Trang trí nên SVG aria-hidden; nút có nhãn riêng. --%>
<div class="mascot-stage" id="mascotStage">
    <p class="mascot-bubble" id="mascotBubble" aria-live="polite"></p>
    <button type="button" class="mascot-hit" id="mascotButton" aria-label="Chạm vào linh vật Super Gym">
        <svg class="mascot-svg" viewBox="0 100 540 290" aria-hidden="true" focusable="false">
            <defs>
                <g id="mochi-dbw">
                    <rect x="-54" y="-11" width="108" height="22" rx="4" fill="#141414" stroke="#141414" stroke-width="4"/>
                    <text class="mochi-lbl" x="0" y="4.4" text-anchor="middle" textLength="84" lengthAdjust="spacingAndGlyphs" fill="#F25A32">SUPERGYM</text>
                    <rect x="-70" y="-27" width="16" height="54" rx="5" fill="#F2F2F2" stroke="#141414" stroke-width="4"/>
                    <rect x="54" y="-27" width="16" height="54" rx="5" fill="#F2F2F2" stroke="#141414" stroke-width="4"/>
                    <rect x="-92" y="-37" width="22" height="74" rx="7" fill="#F2F2F2" stroke="#141414" stroke-width="4"/>
                    <rect x="70" y="-37" width="22" height="74" rx="7" fill="#F2F2F2" stroke="#141414" stroke-width="4"/>
                    <rect x="-83" y="-27" width="4" height="54" rx="2" fill="#F25A32"/>
                    <rect x="79" y="-27" width="4" height="54" rx="2" fill="#F25A32"/>
                    <rect x="-88" y="-31" width="3" height="16" rx="1.5" fill="#fff" opacity=".5"/>
                    <rect x="74" y="-31" width="3" height="16" rx="1.5" fill="#fff" opacity=".5"/>
                </g>
                <g id="mochi-dbs">
                    <rect x="-54" y="-11" width="108" height="22" rx="4" fill="#141414" stroke="#141414" stroke-width="4"/>
                    <text class="mochi-lbl" x="0" y="4.4" text-anchor="middle" textLength="84" lengthAdjust="spacingAndGlyphs" fill="#18B8C0">SUPERGYM</text>
                    <rect x="-70" y="-27" width="16" height="54" rx="5" fill="#4A5F6A" stroke="#141414" stroke-width="4"/>
                    <rect x="54" y="-27" width="16" height="54" rx="5" fill="#4A5F6A" stroke="#141414" stroke-width="4"/>
                    <rect x="-92" y="-37" width="22" height="74" rx="7" fill="#4A5F6A" stroke="#141414" stroke-width="4"/>
                    <rect x="70" y="-37" width="22" height="74" rx="7" fill="#4A5F6A" stroke="#141414" stroke-width="4"/>
                    <rect x="-83" y="-27" width="4" height="54" rx="2" fill="#18B8C0"/>
                    <rect x="79" y="-27" width="4" height="54" rx="2" fill="#18B8C0"/>
                    <rect x="-88" y="-31" width="3" height="16" rx="1.5" fill="#fff" opacity=".5"/>
                    <rect x="74" y="-31" width="3" height="16" rx="1.5" fill="#fff" opacity=".5"/>
                </g>
            </defs>

            <ellipse class="mochi-shadow" cx="150" cy="363" rx="125" ry="9" fill="#000" opacity=".16"/>
            <ellipse cx="408" cy="363" rx="112" ry="8" fill="#000" opacity=".15"/>

            <%-- Tạ nằm dưới đất + tạ đặt chéo bên trên: rơi xuống lần lượt khi xuất hiện --%>
            <g class="mochi-drop mochi-drop--1"><use href="#mochi-dbw" x="408" y="323"/></g>
            <g class="mochi-drop mochi-drop--2"><use href="#mochi-dbs" transform="translate(402 219) rotate(-22)"/></g>

            <%-- Pumpy: lớp ngoài nhảy/bật, lớp trong thở (mochi) --%>
            <g class="mochi-jump">
                <g class="mochi">
                    <path d="M66 178 L72 132 L108 152 Z" fill="#18B8C0" stroke="#141414" stroke-width="5"/>
                    <path d="M234 178 L228 132 L192 152 Z" fill="#18B8C0" stroke="#141414" stroke-width="5"/>
                    <circle cx="46" cy="276" r="21" fill="#18B8C0" stroke="#141414" stroke-width="5"/>
                    <circle cx="254" cy="276" r="21" fill="#18B8C0" stroke="#141414" stroke-width="5"/>
                    <path d="M40 252 C40 175 92 140 150 140 C208 140 260 175 260 252 C260 312 215 340 150 340 C85 340 40 312 40 252 Z" fill="#18B8C0" stroke="#141414" stroke-width="5"/>
                    <path d="M66 196 Q78 168 108 157" fill="none" stroke="#fff" stroke-width="7" opacity=".75"/>
                    <ellipse cx="150" cy="278" rx="56" ry="46" fill="#F2FBF8"/>
                    <path d="M150.0 278.0 L150.3 278.2 L150.4 278.5 L150.5 278.9 L150.5 279.3 L150.4 279.7 L150.2 280.1 L149.9 280.5 L149.4 280.8 L148.9 281.0 L148.3 281.1 L147.7 281.1 L147.0 281.0 L146.3 280.7 L145.7 280.3 L145.0 279.8 L144.5 279.1 L144.0 278.3 L143.7 277.4 L143.5 276.4 L143.5 275.3 L143.7 274.2 L144.0 273.1 L144.5 272.0 L145.3 271.0 L146.2 270.1 L147.3 269.3 L148.5 268.6 L149.9 268.1 L151.4 267.9 L153.0 267.9 L154.6 268.1 L156.2 268.6 L157.7 269.3 L159.2 270.3 L160.5 271.5 L161.6 273.0 L162.6 274.7 L163.3 276.5 L163.7 278.5 L163.8 280.5 L163.7 282.6 L163.1 284.7 L162.3 286.8 L161.1 288.8 L159.7 290.5 L157.9 292.1 L155.9 293.5 L153.6 294.5 L151.2 295.2 L148.7 295.5 L146.0 295.5 L143.4 295.1 L140.8 294.2 L138.3 293.0 L136.0 291.4 L133.9 289.4 L132.1 287.0 L130.6 284.4 L129.6 281.6 L128.9 278.6 L128.7 275.5 L128.9 272.3 L129.7 269.1 L130.9 266.1 L132.6 263.2 L134.7 260.5 L137.2 258.2 L140.1 256.2 L143.3 254.7 L146.7 253.6 L150.3 253.0 L154.0 253.0 L157.8 253.5 L161.4 254.6 L164.9 256.2 L168.2 258.4 L171.1 261.0 L173.7 264.1 L175.8 267.6 L177.4 271.4 L178.4 275.4 L178.8 279.6 L178.6 283.9 L177.8 288.1 L176.3 292.2 L174.2 296.1 L171.6 299.7 L168.4 302.9 L164.7 305.6 L160.6 307.8" fill="none" stroke="#F25C1B" stroke-width="4.5"/>
                    <circle cx="106" cy="336" r="24" fill="#18B8C0" stroke="#141414" stroke-width="5"/>
                    <circle cx="194" cy="336" r="24" fill="#18B8C0" stroke="#141414" stroke-width="5"/>
                    <%-- Mắt: lớp ngoài nhìn theo con trỏ, lớp trong chớp --%>
                    <g class="mochi-eyes">
                        <g class="bl">
                            <circle cx="114" cy="206" r="7" fill="#141414"/><circle cx="186" cy="206" r="7" fill="#141414"/>
                            <circle cx="116.5" cy="203.5" r="2.4" fill="#fff"/><circle cx="188.5" cy="203.5" r="2.4" fill="#fff"/>
                        </g>
                    </g>
                    <path class="mochi-mouth" d="M134 224 L142 232 L150 224 L158 232 L166 224" fill="none" stroke="#141414" stroke-width="4"/>
                </g>
            </g>
        </svg>
    </button>
</div>
