<%@ page pageEncoding="UTF-8" %>
<%-- requestItems: các đơn Service đã chuẩn bị; showEmployee: thêm cột nhân viên ở tab trạng thái. --%>
<c:set var="showDecisionColumns" value="${statusFilter == 'Pending' or (not showEmployee and employee.pendingCount > 0)}" />
  <div class="leave-table-wrap">
    <table class="leave-table ${showEmployee ? 'leave-request-table' : ''} ${showDecisionColumns ? '' : 'leave-decided-table'}" aria-label="Đơn nghỉ phép">
      <thead>
        <tr>
          <c:if test="${showEmployee}">
            <th scope="col" class="leave-col-employee">
              <div class="leave-employee-heading">
                <c:if test="${statusFilter == 'Pending'}">
                  <input type="checkbox" id="leave-select-all" class="leave-selection-checkbox" disabled
                         aria-label="Chọn tất cả đơn đủ điều kiện trên trang này">
                </c:if>
                Nhân viên
              </div>
            </th>
          </c:if>
          <th scope="col" class="leave-col-date">Ngày nghỉ / Ca</th>
          <th scope="col" class="leave-col-type">Loại nghỉ</th>
          <c:if test="${not showEmployee}"><th scope="col" class="leave-col-status">Trạng thái</th></c:if>
          <c:if test="${showDecisionColumns}">
            <th scope="col" class="leave-col-check">Kiểm tra</th>
            <th scope="col" class="leave-actions-cell leave-col-actions">Thao tác</th>
          </c:if>
        </tr>
      </thead>
      <tbody>
        <c:forEach var="item" items="${requestItems}">
          <%-- JS mở chi tiết khi bấm hàng hoặc Enter; các nút trong form xử lý riêng. --%>
          <tr class="leave-request-row ${item.nearLeaveDate ? 'leave-row-near' : ''}"
              tabindex="0"
              aria-label="Đơn của <c:out value='${item.fullName}' />, ${gms:formatDate(item.fromDate)}. Enter để xem chi tiết."
              data-leave-reason="<c:out value='${item.reason}' />"
              data-review-url="${pageContext.request.contextPath}/manager/leave-requests/review?id=${item.leaveRequestId}">
            <c:if test="${showEmployee}">
              <td>
                <div class="leave-employee-cell">
                  <c:if test="${statusFilter == 'Pending'}">
                    <c:choose>
                      <c:when test="${not item.canAct}"><c:set var="selectionHint" value="Bạn không có quyền xử lý đơn này." /></c:when>
                      <c:when test="${item.lateApproval}"><c:set var="selectionHint" value="Duyệt muộn cần xác nhận riêng từng đơn." /></c:when>
                      <c:otherwise><c:set var="selectionHint" value="${item.checkMessage}" /></c:otherwise>
                    </c:choose>
                    <input type="checkbox" class="leave-selection-checkbox" name="leaveRequestIds"
                           form="leave-bulk-form" value="${item.leaveRequestId}"
                           ${not item.canApprove or item.lateApproval ? 'disabled' : ''}
                           aria-label="Chọn đơn của <c:out value='${item.fullName}' />, nghỉ ${gms:formatDate(item.fromDate)}"
                           title="<c:out value='${selectionHint}' />">
                  </c:if>
                  <c:choose>
                    <c:when test="${not empty item.avatarUrl}">
                      <img src="${pageContext.request.contextPath}<c:out value='${item.avatarUrl}' />" alt="" class="leave-employee-avatar">
                    </c:when>
                    <c:otherwise>
                      <span class="leave-employee-initial" aria-hidden="true"><c:out value="${fn:substring(item.fullName, 0, 1)}" /></span>
                    </c:otherwise>
                  </c:choose>
                  <div class="leave-employee-meta">
                    <b><a class="leave-reason-trigger" href="${pageContext.request.contextPath}/manager/leave-requests/review?id=${item.leaveRequestId}"><c:out value="${item.fullName}" /></a></b>
                    <small><c:out value="${item.employeeCode}" /> · ${item.position == 'PT' ? 'PT' : 'Lễ tân'}</small>
                    <small>Nộp ${gms:formatDateTime(item.submittedAt)}</small>
                  </div>
                </div>
              </td>
            </c:if>
            <%-- Ngày và ca: không tự bổ sung giờ khi chưa có cấu hình ca. --%>
            <td>
              <div class="leave-date-cell">
                <div class="leave-date-range">
                  <span>${gms:formatDate(item.fromDate)}</span>
                  <c:if test="${item.fromDate != item.toDate}">
                    <span>→ ${gms:formatDate(item.toDate)}</span>
                  </c:if>
                </div>
                <small><c:out value="${item.shiftType.displayName}" /> · <fmt:formatNumber value="${item.days}" maxFractionDigits="1" /> ngày</small>
                <c:if test="${item.nearLeaveDate}">
                  <span class="leave-near-label">
                    <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                    Sắp đến ngày nghỉ
                  </span>
                </c:if>
                <c:if test="${item.lateApproval}">
                  <span class="badge badge-warning">Cần duyệt muộn</span>
                </c:if>
              </div>
            </td>

            <%-- Loại nghỉ chỉ hiện tên; hover tên nhân viên để đọc nhanh lý do, bấm hàng để xem đầy đủ. --%>
            <td>
              <span class="leave-type-label">
                <c:choose>
                  <c:when test="${item.leaveType.dbValue == 'Annual'}">Phép năm</c:when>
                  <c:when test="${item.leaveType.dbValue == 'Sick'}">Nghỉ ốm</c:when>
                  <c:otherwise>Không lương</c:otherwise>
                </c:choose>
              </span>
              <%-- item.leaveGroup: Service đã đọc đủ các phần của cùng nhân viên, không phụ thuộc bộ lọc hiện tại. --%>
              <c:if test="${not empty item.leaveGroup}">
                  <details class="leave-related">
                      <summary>Cùng đợt <c:out value="${item.leaveGroup.code}" /></summary>
                      <div class="leave-related-parts">
                          <small>Được duyệt <fmt:formatNumber value="${item.leaveGroup.approvedDays}" maxFractionDigits="1" />/<fmt:formatNumber value="${item.leaveGroup.totalDays}" maxFractionDigits="1" /> ngày</small>
                          <c:forEach var="part" items="${item.leaveGroup.requests}">
                              <a class="leave-related-part" href="${pageContext.request.contextPath}/manager/leave-requests/review?id=${part.leaveRequestId}">
                                  <span><strong>${part.leaveType.dbValue == 'Annual' ? 'Phép năm' : 'Không lương'}</strong> · <fmt:formatNumber value="${part.days}" maxFractionDigits="1" /> ngày</span>
                                  <small>${gms:formatDate(part.fromDate)}<c:if test="${part.fromDate != part.toDate}"> → ${gms:formatDate(part.toDate)}</c:if></small>
                                  <c:choose>
                                      <c:when test="${part.approved}"><c:set var="partStatusClass" value="badge-success" /></c:when>
                                      <c:when test="${part.pending}"><c:set var="partStatusClass" value="badge-warning" /></c:when>
                                      <c:otherwise><c:set var="partStatusClass" value="badge-danger" /></c:otherwise>
                                  </c:choose>
                                  <span class="badge badge-sm ${partStatusClass}"><c:out value="${part.status.displayName}" /></span>
                              </a>
                          </c:forEach>
                      </div>
                  </details>
              </c:if>
            </td>

            <c:if test="${not showEmployee}">
            <td>
              <c:choose>
                  <c:when test="${item.status.dbValue == 'Pending'}"><c:set var="statusClass" value="badge-warning" /></c:when>
                  <c:when test="${item.status.dbValue == 'Approved'}"><c:set var="statusClass" value="badge-success" /></c:when>
                  <c:otherwise><c:set var="statusClass" value="badge-danger" /></c:otherwise>
              </c:choose>
              <span class="badge ${statusClass}">
                <c:out value="${item.status.displayName}" />
              </span>
            </td>
            </c:if>

            <%-- Kiểm tra do Service tính; rê chuột để xem lý do, mở chi tiết để xử lý. --%>
            <c:if test="${showDecisionColumns}">
            <td>
              <c:if test="${item.status.dbValue == 'Pending'}">
                  <span class="badge ${item.checkSummary == 'Đạt' ? 'badge-success' : 'badge-warning'}" title="<c:out value='${item.checkMessage}' />">
                    <c:out value="${item.checkSummary}" />
                  </span>
              </c:if>
            </td>

            <td class="leave-actions-cell">
              <c:if test="${item.status.dbValue == 'Pending'}">
                  <%-- Hộp xác nhận/lý do dùng common.js; POST vẫn qua Servlet/Service kiểm tra lại. --%>
                  <form class="leave-row-actions" action="${pageContext.request.contextPath}/manager/leave-requests/review" method="post">
                    <input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />">
                    <input type="hidden" name="leaveRequestId" value="${item.leaveRequestId}">
                    <input type="hidden" name="returnUrl" value="<c:out value='${listReturnUrl}' />">
                    <button type="submit" name="action" value="approve" class="btn btn-sm btn-primary"
                            ${not item.canApprove ? 'disabled' : ''}
                            title="<c:out value='${not item.canAct ? "Bạn không có quyền xử lý đơn này." : item.checkMessage}' />"
                            data-confirm-title="${item.lateApproval ? 'Xác nhận duyệt muộn' : 'Duyệt đơn nghỉ phép'}"
                            data-confirm-text="${item.lateApproval ? 'Xác nhận duyệt muộn' : 'Duyệt'}"
                            <c:if test="${item.lateApproval}">data-confirm-reason-name="lateApprovalReason"</c:if>
                            data-confirm-message="${item.lateApproval ? 'Xác nhận phần nghỉ đã qua đúng ngày/ca và duyệt muộn đơn của' : 'Duyệt đơn của'} <c:out value='${item.fullName}' />, nghỉ ${gms:formatDate(item.fromDate)}<c:if test='${item.fromDate != item.toDate}'>–${gms:formatDate(item.toDate)}</c:if> (<c:out value='${item.shiftType.displayName}' />)?">${item.lateApproval ? 'Duyệt muộn' : 'Duyệt'}</button>
                    <button type="submit" name="action" value="reject" class="btn btn-sm btn-outline danger"
                            ${not item.canAct ? 'disabled' : ''}
                            data-confirm-title="Từ chối đơn nghỉ phép"
                            data-confirm-text="Từ chối"
                            data-confirm-reason-name="rejectReason"
                            data-confirm-message="Từ chối đơn của <c:out value='${item.fullName}' />, nghỉ ${gms:formatDate(item.fromDate)}<c:if test='${item.fromDate != item.toDate}'>–${gms:formatDate(item.toDate)}</c:if> (<c:out value='${item.shiftType.displayName}' />)?">Từ chối</button>
                  </form>
              </c:if>
            </td>
            </c:if>

          </tr>
        </c:forEach>
      </tbody>
    </table>
  </div>
