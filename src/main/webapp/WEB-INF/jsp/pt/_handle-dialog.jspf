<%@ page pageEncoding="UTF-8" %>
<%--
  HỘP "XỬ LÝ BUỔI" — include trong schedule.jsp khi có handle (PtHandleView ← PtSessionHandleService.getHandleForm).
  3 tab (radio, schedule.js đổi tab) → 3 form POST /pt/schedule → PtScheduleServlet.doPost → handleSession:
    Dời buổi (action=reschedule) · Chuyển PT (action=transfer) · Hủy buổi (action=cancel)
  Mỗi form gửi: csrfToken · action · sessionId = handle.sessionId · date + view (để quay lại đúng tuần).
  Bị từ chối → trang vẽ lại, hộp vẫn mở: handleFormError (câu lỗi), handleAction (tab đang chọn), handleReason (chữ đã gõ),
    handleSlotChoice / handleNewDate / handleNewStart (lựa chọn "Giờ khác" ở tab Dời buổi).
  3 form có novalidate: schedule.js (initPtHandleForms) tự kiểm trước khi gửi và báo bằng TOAST + viền đỏ,
  không dùng bong bóng "Please check this box…" của trình duyệt. Server vẫn kiểm lại (PtSessionHandleService) → câu đỏ đầu hộp.
--%>

<%-- Tab mở sẵn: handleAction (sau khi bị từ chối) hoặc "reschedule". --%>
<c:set var="chosen" value="${empty handleAction ? 'reschedule' : handleAction}" />
<c:set var="sessionTime" value="${gms:formatTime(handle.startTime)} – ${gms:formatTime(handle.endTime)}" />
<c:url var="closeUrl" value="/pt/schedule"><c:param name="date" value="${viewDate}" /><c:param name="view" value="${view}" /></c:url>

<%-- Đóng hộp = link closeUrl (về lịch, bỏ ?handle=). --%>
<dialog class="pt-handle" id="pt-handle" open aria-labelledby="pt-handle-title" data-close-url="${closeUrl}">

    <header class="pt-handle-head">
        <div>

            <%-- ĐẦU HỘP: handle.dayLabel · giờ · handle.customerNames · handle.packageName · "Hạn gói đến" handle.termEnd · "Gói đôi" (handle.couple). --%>
            <h2 id="pt-handle-title" tabindex="-1" autofocus><span class="visually-hidden">Xử lý buổi </span><c:out value="${handle.dayLabel}" /> · <c:out value="${sessionTime}" /></h2>
            <p class="pt-handle-who"><strong><c:out value="${handle.customerNames}" /></strong> · <c:out value="${handle.packageName}" /></p>

            <p class="pt-handle-chips">
                <span>Hạn gói đến <c:out value="${gms:formatDate(handle.termEnd)}" /></span>
                <%-- handle.couple = getter tự tính isCouple() · dto/PtHandleView.java --%>
                <c:if test="${handle.couple}"><span>Gói đôi</span></c:if>
            </p>
        </div>
        <a class="pt-handle-close" href="${closeUrl}" data-handle-close aria-label="Đóng hộp xử lý buổi"><i class="fa-solid fa-xmark" aria-hidden="true"></i></a>
    </header>

    <div class="pt-handle-body">

        <%-- Câu lỗi khi Dời / Chuyển / Hủy bị từ chối (VD MSG103 khung vừa bị lấy). --%>
        <c:if test="${not empty handleFormError}">
            <p class="pt-handle-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> <c:out value="${handleFormError}" /></p>
        </c:if>

        <%-- 3 NÚT CHỌN: Dời buổi ("N khung" = handle.moveSlotCount) · Chuyển PT ("N PT trống" = số handle.transferSlots) · Hủy buổi. --%>
        <fieldset class="pt-handle-options">
            <legend class="visually-hidden">Chọn cách xử lý</legend>
            <label class="pt-handle-option">
                <input type="radio" name="pt-handle-option" value="reschedule" ${chosen eq 'reschedule' ? 'checked' : ''}>
                <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                <strong>Dời buổi</strong>
                <span>Sang khung trống khác của bạn</span>
                <small><c:out value="${handle.moveSlotCount}" /> khung</small>
            </label>
            <label class="pt-handle-option">
                <input type="radio" name="pt-handle-option" value="transfer" ${chosen eq 'transfer' ? 'checked' : ''}>
                <i class="fa-solid fa-user-pen" aria-hidden="true"></i>
                <strong>Chuyển PT</strong>
                <span>Giữ giờ, PT khác dạy thay</span>
                <small><c:out value="${fn:length(handle.transferSlots)}" /> PT trống</small>
            </label>
            <label class="pt-handle-option is-danger">
                <input type="radio" name="pt-handle-option" value="cancel" ${chosen eq 'cancel' ? 'checked' : ''}>
                <i class="fa-solid fa-ban" aria-hidden="true"></i>
                <strong>Hủy buổi</strong>
                <span>Vẫn tính buổi, hoàn tiền mặt</span>
            </label>
        </fieldset>

        <%-- ===== FORM DỜI BUỔI (action=reschedule) → PtSessionHandleService.reschedule ===== --%>
        <form class="pt-handle-panel" data-panel="reschedule" method="post" action="${pageContext.request.contextPath}/pt/schedule" novalidate>
            <input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />">
            <input type="hidden" name="action" value="reschedule">
            <input type="hidden" name="sessionId" value="${handle.sessionId}">
            <input type="hidden" name="date" value="${viewDate}">
            <input type="hidden" name="view" value="${view}">
            <c:set var="newChosen" value="${chosen eq 'reschedule' and handleSlotChoice eq 'new'}" />

            <%--
              CÁCH 1 — chọn khung trống có sẵn: các ngày (handle.moveDays) × viên giờ (slot), radio name="timeSlotId" value = slot.timeSlotId.
              Viên vàng = slot.hasGymAccess false (khách chưa có gói thành viên ngày đó, vẫn dời được).
            --%>
            <c:choose>
                <c:when test="${handle.moveSlotCount gt 0}">
                    <p class="pt-handle-note"><strong><c:out value="${handle.moveSlotCount}" /> khung trống</strong> tới <c:out value="${fn:substring(gms:formatDate(handle.moveUntil), 0, 5)}" />
                        <span class="pt-handle-note-key"><span class="pt-handle-warn-key">Vàng</span> khách chưa có gói thành viên ngày đó</span></p>
                    <div class="pt-handle-days">
                        <c:forEach var="moveDay" items="${handle.moveDays}">
                            <div class="pt-handle-day">
                                <span class="pt-handle-day-name"><c:out value="${moveDay.label}" /></span>
                                <div class="pt-handle-times">
                                    <c:forEach var="slot" items="${moveDay.slots}">
                                        <label class="pt-handle-pill ${slot.hasGymAccess ? '' : 'is-warn'}"
                                               title="${slot.hasGymAccess ? '' : 'Khách chưa có gói thành viên / vé ngày ngày này — vẫn dời được, hệ thống tự nhắc khách'}">
                                            <input type="radio" name="timeSlotId" value="${slot.timeSlotId}"
                                                   ${chosen eq 'reschedule' and handleSlotChoice eq ('' += slot.timeSlotId) ? 'checked' : ''}
                                                   aria-label="${moveDay.label} ${gms:formatTime(slot.startTime)}${slot.hasGymAccess ? '' : ', khách chưa có gói thành viên ngày này'}">
                                            <span><c:out value="${gms:formatTime(slot.startTime)}" /></span>
                                        </label>
                                    </c:forEach>
                                </div>
                            </div>
                        </c:forEach>
                    </div>
                </c:when>
                <c:otherwise>
                    <p class="pt-handle-note">Chưa có khung trống nào tới <c:out value="${fn:substring(gms:formatDate(handle.moveUntil), 0, 5)}" />. Chọn <strong>Giờ khác</strong> bên dưới để tạo khung mới.</p>
                </c:otherwise>
            </c:choose>

            <%--
              CÁCH 2 — "Giờ khác": PT tự chọn ngày + giờ CHƯA mở khung → server tạo khung mới rồi dời luôn (1 transaction).
              radio timeSlotId = "new" · newSlotDate (min = handle.moveFrom, max = handle.moveUntil) · newStartTime (mốc 15 phút).
              Ô ngày/giờ chỉ hiện khi tích "Giờ khác" (CSS :has). Server kiểm: giờ mở cửa, ca nghỉ, chồng khung, lịch khách.
            --%>
            <c:if test="${not empty handle.moveFrom and not handle.moveFrom.isAfter(handle.moveUntil)}">
                <div class="pt-handle-new">
                    <label class="pt-handle-new-toggle">
                        <input type="radio" name="timeSlotId" value="new" ${newChosen ? 'checked' : ''}>
                        <span><i class="fa-solid fa-plus" aria-hidden="true"></i> Giờ khác <small>(chưa mở khung — tạo khung mới và dời luôn)</small></span>
                    </label>
                    <div class="pt-handle-new-fields">
                        <label class="pt-handle-field"><span>Ngày</span>
                            <input type="date" name="newSlotDate" value="<c:out value='${newChosen ? handleNewDate : ""}' />"
                                   min="${handle.moveFrom}" max="${handle.moveUntil}">
                        </label>
                        <label class="pt-handle-field"><span>Giờ bắt đầu</span>
                            <input type="time" name="newStartTime" step="900" value="<c:out value='${newChosen ? handleNewStart : ""}' />">
                        </label>
                    </div>
                </div>
            </c:if>

            <label class="pt-handle-field"><span>Ghi chú gửi khách <small>(không bắt buộc)</small></span>
                <textarea name="reason" rows="2" maxlength="500" placeholder="VD: Mình bận việc đột xuất, dời giúp bạn sang giờ này nhé."><c:if test="${chosen eq 'reschedule'}"><c:out value="${handleReason}" /></c:if></textarea>
            </label>
            <p class="pt-handle-effect">Khách nhận thông báo · không tính lượt đổi của khách · khung cũ trở lại Còn trống.</p>
            <div class="pt-handle-actions">
                <a class="btn btn-ghost" href="${closeUrl}" data-handle-close>Để sau</a>
                <button class="btn btn-primary" type="submit">Dời buổi</button>
            </div>
        </form>

        <%--
          ===== FORM CHUYỂN PT (action=transfer) → PtSessionHandleService.transfer =====
          Mỗi PT trống đúng giờ (handle.transferSlots): radio name="timeSlotId" value = slot.timeSlotId · tên slot.ptName.
        --%>
        <form class="pt-handle-panel" data-panel="transfer" method="post" action="${pageContext.request.contextPath}/pt/schedule" novalidate>
            <input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />">
            <input type="hidden" name="action" value="transfer">
            <input type="hidden" name="sessionId" value="${handle.sessionId}">
            <input type="hidden" name="date" value="${viewDate}">
            <input type="hidden" name="view" value="${view}">
            <c:choose>
                <c:when test="${not empty handle.transferSlots}">
                    <div class="pt-handle-pts">
                        <c:forEach var="slot" items="${handle.transferSlots}">
                            <label class="pt-handle-pt">
                                <input type="radio" name="timeSlotId" value="${slot.timeSlotId}">
                                <span class="pt-handle-avatar" aria-hidden="true"><c:out value="${fn:substring(slot.ptName, 0, 1)}" /></span>
                                <span><strong><c:out value="${slot.ptName}" /></strong><small>Trống <c:out value="${sessionTime}" /></small></span>
                            </label>
                        </c:forEach>
                    </div>
                    <p class="pt-handle-effect">Giữ nguyên ngày giờ · khách và PT nhận đều được báo · hoa hồng buổi này thuộc PT nhận.</p>
                    <div class="pt-handle-actions">
                        <a class="btn btn-ghost" href="${closeUrl}" data-handle-close>Để sau</a>
                        <button class="btn btn-primary" type="submit">Chuyển PT</button>
                    </div>
                </c:when>
                <c:otherwise>
                    <p class="pt-handle-empty">Không PT nào đang trống đúng <c:out value="${sessionTime}" /> ngày này.
                        Nhờ PT khác công bố khung giờ này, hoặc chọn Dời buổi.</p>
                </c:otherwise>
            </c:choose>
        </form>

        <%--
          ===== FORM HỦY BUỔI (action=cancel) → PtSessionHandleService.cancel =====
          name="reason" (5–500 ký tự, giữ lại chữ đã gõ handleReason) · ô tích name="refundAgreed" (bắt buộc).
        --%>
        <form class="pt-handle-panel" data-panel="cancel" method="post" action="${pageContext.request.contextPath}/pt/schedule" novalidate>
            <input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />">
            <input type="hidden" name="action" value="cancel">
            <input type="hidden" name="sessionId" value="${handle.sessionId}">
            <input type="hidden" name="date" value="${viewDate}">
            <input type="hidden" name="view" value="${view}">
            <ul class="pt-handle-warning">
                <li>Buổi vẫn tính là đã dùng, bạn vẫn nhận hoa hồng.</li>
                <li>Bạn tự hoàn tiền mặt cho khách ngoài hệ thống.</li>
                <li>Không hoàn tác được.</li>
                <li class="is-must"><strong>Phải hỏi khách trước:</strong> khách đồng ý nhận tiền mặt thì mới tích ô xác nhận bên dưới — chưa tích thì không hủy được.</li>
            </ul>
            <label class="pt-handle-field"><span>Lý do hủy <small>(5–500 ký tự, khách sẽ đọc)</small></span>
                <textarea name="reason" rows="3" maxlength="500" placeholder="VD: Mình ốm đột xuất, không dạy được buổi này."><c:if test="${chosen eq 'cancel'}"><c:out value="${handleReason}" /></c:if></textarea>
            </label>
            <label class="pt-handle-check">
                <input type="checkbox" name="refundAgreed">
                <span>Khách đã đồng ý nhận lại tiền mặt cho buổi này.</span>
            </label>
            <div class="pt-handle-actions">
                <a class="btn btn-ghost" href="${closeUrl}" data-handle-close>Để sau</a>
                <button class="btn btn-danger" type="submit">Hủy buổi</button>
            </div>
        </form>
    </div>
</dialog>
