<%@ page pageEncoding="UTF-8" %>
<%--
  THANH TIÊU ĐỀ dùng chung các màn PT (dashboard.jsp, schedule.jsp, exercises.jsp).
  Servlet của màn đặt: pageTitle (chữ tiêu đề) · pageHelp (câu hướng dẫn trong nút "i", có thì mới hiện nút) · today (ngày hôm nay).
  Bên phải: chuông thông báo + thẻ tài khoản (common).
--%>

<header class="topbar">

    <div class="tb-left">

        <h1 class="tb-title">
            <c:out value="${pageTitle}" />
        </h1>

        <c:if test="${not empty pageHelp}">
            <span class="pt-info">
                <button type="button" class="pt-info-trigger" aria-label="Hướng dẫn ${pageTitle}" aria-describedby="pt-page-help"><span aria-hidden="true">i</span></button>
                <span id="pt-page-help" class="pt-info-popover" role="tooltip"><c:out value="${pageHelp}" /></span>
            </span>
        </c:if>

        <p class="pt-header-date">
            <c:out value="${gms:formatDate(today)}" />
        </p>
    </div>

    <div class="pt-top-actions">
        <%@ include file="/WEB-INF/jsp/common/notification-bell.jspf" %>
        <%@ include file="/WEB-INF/jsp/common/topbar-user.jspf" %>
    </div>

</header>
