<%--
================================================================================
 _counter-card.jspf — MỘT THẺ GÓI trên màn Chọn gói (counter-sale-packages.jsp include trong vòng lặp)

 BIẾN VÀO   card          CounterPackageCard (vòng c:forEach của JSP cha)
            continueBase  đường dẫn nút "Tiếp tục": /receptionist/sales (gói tập) hoặc /receptionist/pt-sales (gói PT)
            continueLabel chữ trên nút "Tiếp tục" khi chọn thẻ này
 CHỌN THẺ   thẻ là <label> bọc <input type="radio" name="packageChoice">: bấm thẻ = chọn, dùng được bằng bàn phím.
            counter-sale.js hàm handlePackageChange() đọc data-* của thẻ để cập nhật thanh "Đang chọn".
 LỌC        counter-sale.js hàm filterPackageCards() đọc data-package-name.
================================================================================ --%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="gms" uri="/WEB-INF/gms-functions.tld" %>
<label class="counter-card${card.continueAllowed ? '' : ' is-blocked'}"
       data-package-name="<c:out value='${card.packageName}' />"
       data-package-price="${card.price}"
       data-continue-url="${continueBase}?package=${card.packageId}"
       data-continue-label="<c:out value='${continueLabel}' />">
    <input class="counter-card-radio" type="radio" name="packageChoice" value="${card.packageId}"
        <c:if test="${not card.continueAllowed}">disabled</c:if>>

    <%-- Dải đầu thẻ: nhãn loại gói, tên gói, nhãn tiết kiệm. Chọn thẻ thì dải đổi sang màu cam và hiện dấu tích. --%>
    <span class="counter-card-head">
        <span class="counter-card-type"><c:out value="${card.typeLabel}" /></span>
        <span class="counter-card-name"><c:out value="${card.packageName}" /></span>
        <c:if test="${card.savingPercent > 0}">
            <span class="counter-card-saving">-<c:out value="${card.savingPercent}" />%</span>
        </c:if>
        <span class="counter-card-check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
    </span>

    <span class="counter-card-body">
        <span class="counter-card-price"><c:out value="${gms:formatMoney(card.price)}" /></span>
        <span class="counter-card-duration">
            <c:out value="${card.durationText}" />
            <c:if test="${card.monthlyPrice > 0}"> · <c:out value="${gms:formatMoney(card.monthlyPrice)}" />/tháng</c:if>
        </span>

        <c:if test="${not empty card.benefitLines}">
            <span class="counter-card-label">QUY&#7872;N L&#7907;I</span>
            <ul class="counter-card-list">
                <c:forEach var="line" items="${card.benefitLines}">
                    <li><c:out value="${line}" /></li>
                </c:forEach>
            </ul>
        </c:if>

        <c:if test="${not empty card.ruleLines}">
            <span class="counter-card-label">QUY &#272;&#7882;NH</span>
            <ul class="counter-card-list is-rules">
                <c:forEach var="line" items="${card.ruleLines}">
                    <li><c:out value="${line}" /></li>
                </c:forEach>
            </ul>
        </c:if>

        <%-- Thẻ bị khóa: lý do nằm trong tooltip của ô có thể focus (chạm / bàn phím đều xem được). --%>
        <c:if test="${not card.continueAllowed}">
            <span class="counter-card-lock" tabindex="0" title="<c:out value='${card.blockedReason}' />">
                <i class="fa-solid fa-lock" aria-hidden="true"></i> Chưa bán tại quầy
            </span>
        </c:if>
    </span>
</label>